   expect(parenthesized.stdout).toMatch(/parenthesized\.ts:4:28: .*\[Error\/bun\(global-error-in-effect-catch\)\]/);
 });
+
+describe("Effect piping flows", () => {
+  function pipingProject(source: string) {
+    return {
+      ".oxlintrc.json": JSON.stringify({ options: { typeAware: true }, categories: { correctness: "off" } }),
+      "tsconfig.json": JSON.stringify({
+        compilerOptions: {
+          ...options,
+          strict: true,
+          module: "esnext",
+          moduleResolution: "bundler",
+          plugins: [{
+            name: "@effect/language-service",
+            diagnosticSeverity: {
+              effectTryWithoutCatch: "error",
+              catchUnfailableEffect: "error",
+              lazyPromiseInEffectSync: "error",
+            },
+          }],
+        },
+      }),
+      "node_modules/effect/package.json": '{ "name": "effect", "version": "4.1.2", "types": "./index.d.ts" }',
+      "node_modules/effect/index.d.ts": [
+        'export * as Effect from "./Effect";',
+        'export { pipe } from "./Function";',
+      ].join("\n"),
+      "node_modules/effect/Function.d.ts": [
+        "export declare function pipe<A, B>(value: A, ab: (value: A) => B): B;",
+        "export declare function pipe<A, B, C>(value: A, ab: (value: A) => B, bc: (value: B) => C): C;",
+      ].join("\n"),
+      "node_modules/effect/Effect.d.ts": [
+        'declare const TypeId: "~effect/Effect";',
+        "export interface Effect<A, E = never, R = never> {",
+        "  readonly [TypeId]: { _A: () => A; _E: () => E; _R: () => R };",
+        "  pipe<B>(ab: (value: Effect<A, E, R>) => B): B;",
+        "}",
+        "interface UnknownError { readonly _tag: 'UnknownError'; }",
+        "export declare function succeed<A>(value: A): Effect<A>;",
+        "export declare function sync<A>(thunk: () => A): Effect<A>;",
+        "export declare function fn<A, E, B>(body: () => Effect<A, E>, step: (self: Effect<A, E>) => B): () => B;",
+        "declare function try_<A>(value: () => A): Effect<A, UnknownError>;",
+        "declare function try_<A, E>(value: { try: () => A; catch: (error: unknown) => E }): Effect<A, E>;",
+        "declare function catch_<B>(handler: () => Effect<B>): <A, E>(self: Effect<A, E>) => Effect<A | B>;",
+        "export { try_ as try, catch_ as catch };",
+      ].join("\n"),
+      "a.ts": source,
+    };
+  }
+
+  test.concurrent("checks direct, method, point-free and Effect.fn flows", async () => {
+    const source = [
+      'import { Effect, pipe } from "effect";',
+      'const attempt = Effect.try;',
+      'export const short = attempt(() => 1);',
+      'export const object = attempt({ try: () => 1, catch: String });',
+      'export const pointFree = pipe(() => 1, Effect.try);',
+      'export const method = Effect.succeed(1).pipe(Effect.catch(() => Effect.succeed(0)));',
+      'export const traced = Effect.fn(() => Effect.succeed(1), Effect.catch(() => Effect.succeed(0)));',
+      'export const sync = Effect.sync(() => Promise.resolve(1));',
+      'export const chained = pipe(1, (n) => () => Promise.resolve(n), Effect.sync);',
+    ].join("\n");
+    const { errors } = await lint(pipingProject(source), ["a.ts"]);
+    expect(errors.map(message => message.split(" ", 1)[0]).sort()).toEqual([
+      "3:22",
+      "5:40",
+      "6:46",
+      "7:58",
+      "8:33",
+      "9:65",
+    ]);
+  });
+
+  // A downstream point-free sync reports at its callee after a normalized step.
+  // With an unmatched input call it reports at that call instead. Preserve each
+  // overload's parameter graph and wrap its result in a Promise-returning thunk.
+  async function expectOverloads(declarations: string, calls: [call: string, normalized: boolean][]) {
+    const lines = ['import { Effect, pipe } from "effect";', ...declarations.trim().split("\n")];
+    const first = lines.length + 1;
+    for (const [index, [call]] of calls.entries()) {
+      lines.push(`export const case${index} = pipe(${call}, Effect.sync);`);
+    }
+    const { errors, exitCode } = await lint(pipingProject(lines.join("\n")), ["a.ts"]);
+    const expected = calls.map(([, normalized], offset) => {
+      const line = lines[first - 1 + offset];
+      const column = normalized ? line.indexOf("Effect.sync") + 1 : line.indexOf("pipe(") + 6;
+      return `${first + offset}:${column}`;
+    });
+    expect(errors.map(message => message.split(" ", 1)[0])).toEqual(expected);
+    expect(exitCode).toBe(1);
+  }
+
+  test.concurrent("pipingFlows_selfDualOverloads", async () => {
+    // Effect-TS/tsgo testdata/tests/effect-v4/pipingFlows_selfDualOverloads.ts.
+    await expectOverloads(`
+interface Box<A> { readonly value: A }
+type Thunk<A> = () => Promise<A>;
+type Infer<S extends Iterable<any>> = S extends ReadonlyArray<infer A> ? A : S extends Iterable<infer A> ? A : never;
+type Options<D> = { readonly concurrency?: number | undefined; readonly discard?: D | undefined };
+declare const traverse: {
+  <A, B, S extends Iterable<A> = Iterable<A>, const D extends boolean = false>(
+    f: (a: A, i: number) => Box<B>, options?: Options<D> | undefined
+  ): (self: [S] extends [never] ? Iterable<A> : S) => Thunk<Box<D extends false ? Array<B> : void>>;
+  <B, S extends Iterable<any>, const D extends boolean = false>(
+    self: S, f: (a: Infer<S>, i: number) => Box<B>, options?: Options<D> | undefined
+  ): Thunk<Box<D extends false ? Array<B> : void>>;
+};
+declare const traverseUnnamed: {
+  <A, B, S extends Iterable<A> = Iterable<A>, const D extends boolean = false>(
+    f: (a: A, i: number) => Box<B>, options?: Options<D> | undefined
+  ): (input: [S] extends [never] ? Iterable<A> : S) => Thunk<Box<D extends false ? Array<B> : void>>;
+  <B, S extends Iterable<any>, const D extends boolean = false>(
+    input: S, f: (a: Infer<S>, i: number) => Box<B>, options?: Options<D> | undefined
+  ): Thunk<Box<D extends false ? Array<B> : void>>;
+};
+declare const traverseMismatched: {
+  <A, B, S extends Iterable<A> = Iterable<A>>(
+    f: (a: A, i: number) => Box<B>, label: string
+  ): (self: [S] extends [never] ? Iterable<A> : S) => Thunk<Box<Array<B>>>;
+  <B, S extends Iterable<any>>(
+    self: S, f: (a: Infer<S>, i: number) => Box<B>, label: number
+  ): Thunk<Box<Array<B>>>;
+};
+declare const traverseConstrained: {
+  <A extends string, B, S extends Iterable<A> = Iterable<A>>(
+    f: (a: A, i: number) => Box<B>
+  ): (self: [S] extends [never] ? Iterable<A> : S) => Thunk<Box<Array<B>>>;
+  <B, S extends Iterable<any>>(
+    self: S, f: (a: Infer<S>, i: number) => Box<B>
+  ): Thunk<Box<Array<B>>>;
+};
+declare const items: ReadonlyArray<number>;
+declare const wrap: (n: number) => Box<string>;
+    `, [
+      ["traverse(items, wrap)", true],
+      ["traverse(items, wrap, { discard: true })", true],
+      ["traverse(wrap)(items)", true],
+      ["traverse(wrap, { concurrency: 2 })(items)", true],
+      ["traverseUnnamed(items, wrap)", false],
+      ["traverseUnnamed(wrap)(items)", true],
+      ["traverseMismatched(items, wrap, 1)", false],
+      ["traverseConstrained(items, wrap)", false],
+    ]);
+  });
+
+  test.concurrent("pipingFlows_dataFirstOverloads", async () => {
+    // Effect-TS/tsgo testdata/tests/effect-v4/pipingFlows_dataFirstOverloads.ts.
+    await expectOverloads(`
+interface Box<A> { readonly value: A }
+interface Pair<A, B> { readonly left: A; readonly right: B }
+type Thunk<A> = () => Promise<A>;
+declare function reordered<A, B, C = B>(self: Box<A>, options: {
+  readonly onEmpty: () => B; readonly onValue: (value: A) => C;
+}): Thunk<B | C>;
+declare function reordered<B, A, C = B>(options: {
+  readonly onValue: (value: A) => C; readonly onEmpty: () => B;
+}): (self: Box<A>) => Thunk<C | B>;
+declare function moved<A>(self: Box<A>, index: number): Thunk<A>;
+declare function moved(index: number): <Value>(self: Box<Value>) => Thunk<Value>;
+declare function mapped<A extends object, N extends string, B>(self: A, name: N, value: B): Thunk<{
+  [K in N | keyof A]: K extends keyof A ? A[K] : B;
+}>;
+declare function mapped<N extends string, A extends object, B>(name: N, value: B): (self: A) => Thunk<{
+  [K in N | keyof A]: K extends keyof A ? A[K] : B;
+}>;
+type Pipeable = (self: string) => Thunk<number>;
+declare function callableAlias(self: string, size: number): Thunk<number>;
