+// Adapted from Effect's MIT-licensed ets_typeparser at 0e722d359c969bdf1b1316f08e8637022cde3cce.
+
+//! Normalize a call as a pipe step only when a same-origin overload moves the
+//! subject into a returned unary function. The call-site witness checks the
+//! actual arguments separately from the comparison of generic declarations.
+
+use bun_lint::ast::Expr;
+use bun_lint::types::{
+    CheckFlags, ModifierFlags, ObjectFlags, Signature, SymbolFlags, SyntaxKind, TsNode, TsSymbol,
+    Type, TypeFlags, TypeList, TypeStructure,
+};
+use rustc_hash::{FxHashMap, FxHashSet};
+use std::cell::Cell;
+
+const MAX_DEPTH: usize = 64;
+const MAX_WORK: usize = 4096;
+const MAX_UNION_SEARCH: usize = 128;
+
+pub(super) fn data_subject<'a>(
+    call: Expr<'a>,
+    callee: Expr<'a>,
+    args: &[Expr<'a>],
+) -> Option<usize> {
+    if args.len() < 2 {
+        return None;
+    }
+    let signatures = callee.ty().get_call_signatures();
+    if signatures.len() < 2 {
+        return None;
+    }
+    let resolved = call.resolved_signature()?;
+    if !accepts_arity(resolved, args.len()) {
+        return None;
+    }
+    let first_is_self = resolved.parameters().first().is_some_and(is_self);
+    let indexes: &[usize] = match (args.len(), first_is_self) {
+        (2, true) => &[0, 1],
+        (2, false) => &[1, 0],
+        _ => &[0],
+    };
+    let mut matched = None;
+    let raw = declared_signature(resolved);
+    for &index in indexes {
+        if !signatures.iter().any(|candidate| {
+            same_overload_origin(resolved, candidate)
+                && matches_candidate(
+                    raw,
+                    candidate,
+                    index,
+                    args[index],
+                    args.len() - 1,
+                    args.iter()
+                        .copied()
+                        .enumerate()
+                        .filter_map(|(i, arg)| (i != index).then_some(arg)),
+                )
+        }) {
+            continue;
+        }
+        if let Some(previous) = matched {
+            return resolved
+                .parameters()
+                .get(previous)
+                .is_some_and(is_self)
+                .then_some(previous);
+        }
+        matched = Some(index);
+    }
+    matched
+}
+
+pub(super) fn is_curried<'a>(
+    factory: Expr<'a>,
+    callee: Expr<'a>,
+    args: &[Expr<'a>],
+    subject: Expr<'a>,
+) -> bool {
+    let signatures = callee.ty().get_call_signatures();
+    if signatures.len() < 2 {
+        return false;
+    }
+    let Some(resolved) = factory.resolved_signature() else {
+        return false;
+    };
+    if resolved.declaration().is_none() {
+        return false;
+    }
+    signatures.iter().any(|candidate| {
+        if candidate == resolved
+            || candidate.declaration() == resolved.declaration()
+            || !same_overload_origin(resolved, candidate)
+        {
+            return false;
+        }
+        let data = declared_signature(candidate);
+        let Some(last) = data.parameters().len().checked_sub(1) else {
+            return false;
+        };
+        [0, last].into_iter().any(|index| {
+            matches_candidate(
+                data,
+                resolved,
+                index,
+                subject,
+                args.len(),
+                args.iter().copied(),
+            )
+        })
+    })
+}
+
+// The query provides the declaration of an instantiated signature. Reading its
+// signature directly recovers the binders for comparison.
+fn declared_signature(signature: Signature<'_>) -> Signature<'_> {
+    signature
+        .declaration()
+        .and_then(TsNode::get_signature_from_declaration)
+        .unwrap_or(signature)
+}
+
+fn same_overload_origin<'a>(left: Signature<'a>, right: Signature<'a>) -> bool {
+    let Some(left) = left.declaration() else {
+        return true;
+    };
+    let Some(right) = right.declaration() else {
+        return false;
+    };
+    if left.kind() == SyntaxKind::CallSignature && right.kind() == SyntaxKind::CallSignature {
+        // Unnamed signatures in an overloaded object share their containing
+        // type declaration even when their individual symbols differ.
+        return left.parent().is_some() && left.parent() == right.parent();
+    }
+    if left == right {
+        return left.name().is_some();
+    }
+    same_symbol(
+        left.name().and_then(TsNode::get_symbol_at_location),
+        right.name().and_then(TsNode::get_symbol_at_location),
+    )
+}
+
+fn same_symbol<'a>(left: Option<TsSymbol<'a>>, right: Option<TsSymbol<'a>>) -> bool {
+    match (left, right) {
+        (Some(left), Some(right)) => {
+            let left = left.get_merged_symbol().skip_alias().get_merged_symbol();
+            let right = right.get_merged_symbol().skip_alias().get_merged_symbol();
+            left == right && !left.is_unknown()
+        }
+        _ => false,
+    }
+}
+
+fn is_self(symbol: TsSymbol<'_>) -> bool {
+    let name = symbol.name();
+    name.get(..4)
+        .is_some_and(|prefix| prefix.eq_ignore_ascii_case(b"self"))
+        || name.eq_ignore_ascii_case(b"this")
+}
+
+fn is_optional(symbol: TsSymbol<'_>) -> bool {
+    symbol.has_flags(SymbolFlags::OPTIONAL) || symbol.declarations().any(TsNode::has_question_token)
+}
+
+fn is_rest(symbol: TsSymbol<'_>) -> bool {
+    symbol.declarations().any(TsNode::has_dot_dot_dot_token)
+}
+
+pub(super) fn required_arity(signature: Signature<'_>) -> usize {
+    signature
+        .parameters()
+        .iter()
+        .enumerate()
+        .filter(|&(_, parameter)| {
+            !is_optional(parameter)
+                && !is_rest(parameter)
+                && !parameter
+                    .declarations()
+                    .any(|decl| decl.initializer().is_some())
+        })
+        .map(|(i, _)| i + 1)
+        .last()
+        .unwrap_or(0)
+}
+
+pub(super) fn has_rest(signature: Signature<'_>) -> bool {
+    signature.parameters().iter().last().is_some_and(is_rest)
+}
+
+fn accepts_arity(signature: Signature<'_>, count: usize) -> bool {
+    count >= required_arity(signature)
+        && (count <= signature.parameters().len() || has_rest(signature))
+}
+
+fn matches_candidate<'a>(
+    data: Signature<'a>,
+    pipeable: Signature<'a>,
+    index: usize,
+    subject: Expr<'a>,
+    arg_count: usize,
+    args: impl Iterator<Item = Expr<'a>>,
+) -> bool {
+    let raw_pipeable = declared_signature(pipeable);
+    let data_count = data.parameters().len();
+    if index >= data_count || data_count != raw_pipeable.parameters().len() + 1 {
+        return false;
+    }
+    let Some(returned) = returned_unary(raw_pipeable) else {
+        return false;
+    };
+    if !matches_shape(data, raw_pipeable, returned, index, false)
+        && !matches_shape(data, raw_pipeable, returned, index, true)
+    {
+        return false;
+    }
+
+    let parameters = pipeable.parameters();
+    let generic = !pipeable.type_parameters().is_empty();
+    if !accepts_arity(pipeable, arg_count)
+        || !args.enumerate().all(|(i, arg)| {
+            parameters
+                .get(i)
+                .or_else(|| parameters.iter().last())
+                .is_some_and(|parameter| accepts_type(arg.ty(), parameter.get_type(), generic))
+        })
+    {
+        return false;
+    }
+
+    pipeable
+        .get_return_type()
+        .get_call_signatures()
+        .iter()
+        .any(|signature| {
+            signature.parameters().len() == 1
+                && signature.parameters().first().is_some_and(|parameter| {
+                    !is_rest(parameter)
+                        && accepts_type(
+                            subject.ty(),
+                            parameter.get_type(),
+                            generic || !signature.type_parameters().is_empty(),
+                        )
+                })
+        })
+}
+
+fn returned_unary(pipeable: Signature<'_>) -> Option<Signature<'_>> {
+    let ty = pipeable.get_return_type();
+    if !ty.alias_type_arguments().is_empty()
+        && ty.object_flags().intersects(ObjectFlags::INSTANTIATED)
+    {
+        // A generic callable alias can carry an enclosing substitution.
+        return None;
+    }
+    let signatures = ty.get_call_signatures();
+    let signature = signatures.first()?;
+    (signatures.len() == 1
+        && signature.parameters().len() == 1
+        && !signature.parameters().first().is_some_and(is_rest))
+    .then_some(signature)
+}
+
+fn accepts_type<'a>(argument: Type<'a>, parameter: Type<'a>, generic: bool) -> bool {
+    let mut parameter = parameter;
+    for _ in 0..MAX_DEPTH {
+        if !parameter.is_type_parameter() {
+            return same_origin(argument, parameter)
+                || argument.is_assignable_to(parameter)
+                || (generic
+                    && argument.get_call_signatures().is_empty()
+                        == parameter.get_call_signatures().is_empty());
+        }
+        let Some(constraint) = parameter.get_base_constraint_of_type() else {
+            return true;
+        };
+        parameter = constraint;
+    }
+    false
+}
+
+fn same_reference_target<'a>(left: Type<'a>, right: Type<'a>) -> bool {
+    if left.is_tuple_type() || right.is_tuple_type() {
+        return left.has_same_target_as(right);
+    }
+    match (left.target(), right.target()) {
+        (Some(left), Some(right)) => left == right || same_symbol(left.symbol(), right.symbol()),
+        _ => false,
+    }
+}
+
+fn same_origin<'a>(left: Type<'a>, right: Type<'a>) -> bool {
+    if left == right {
+        return true;
+    }
+    let left_reference = left.object_flags().intersects(ObjectFlags::REFERENCE);
+    let right_reference = right.object_flags().intersects(ObjectFlags::REFERENCE);
+    if left_reference || right_reference {
+        return left_reference && right_reference && same_reference_target(left, right);
+    }
+    let left_alias = left.alias_symbol();
+    let right_alias = right.alias_symbol();
+    if left_alias.is_some() || right_alias.is_some() {
+        return same_symbol(left_alias, right_alias);
+    }
+    let left_symbol = left.symbol();
+    let right_symbol = right.symbol();
+    if left_symbol.is_some() || right_symbol.is_some() {
+        return same_symbol(left_symbol, right_symbol);
+    }
+    left.flags() == right.flags() && left.has_flags(TypeFlags::SINGLETON)
+}
+
+fn matches_shape<'a>(
+    data: Signature<'a>,
+    pipeable: Signature<'a>,
+    returned: Signature<'a>,
+    index: usize,
+    self_dual: bool,
+) -> bool {
+    let left = data.parameters();
+    let right = pipeable.parameters();
+    let Some(left_subject) = left.get(index) else {
+        return false;
+    };
+    let Some(right_subject) = returned.parameters().first() else {
+        return false;
+    };
+    if left.len() != right.len() + 1
+        || (self_dual && (!is_self(left_subject) || !is_self(right_subject)))
+    {
+        return false;
+    }
+    let limits = Limits::default();
+    let mut matcher = Matcher::new(&limits, self_dual);
+    matcher.register(data.type_parameters(), pipeable.type_parameters());
+    matcher.right_binders.extend(returned.type_parameters());
+    if matcher.right_binders.len() != matcher.left_binders.len() + usize::from(self_dual) {
+        return false;
+    }
+
+    if !left
+        .iter()
+        .enumerate()
+        .filter_map(|(i, param)| (i != index).then_some(param))
+        .zip(right)
+        .all(|(left, right)| matcher.parameter(left, right, 0))
+    {
+        return false;
+    }
+    let mut right_type = right_subject.get_type();
+    if self_dual
+        && right_type.alias_symbol().is_none()
+        && let TypeStructure::Conditional {
+            root_false_type, ..
+        } = right_type.structure()
+    {
+        right_type = root_false_type;
+    }
+    is_optional(left_subject) == is_optional(right_subject)
+        && matcher.ty(left_subject.get_type(), right_type, 1)
+        && matcher.ty(data.get_return_type(), returned.get_return_type(), 0)
+        && matcher.validate_binders()
+}
+
+#[derive(Default)]
+struct Limits {
+    work: Cell<usize>,
+    union_search: Cell<usize>,
+}
+
+impl Limits {
+    fn take(counter: &Cell<usize>, limit: usize) -> bool {
+        let next = counter.get() + 1;
+        counter.set(next);
+        next <= limit
+    }
+}
+
+#[derive(Clone)]
+struct Matcher<'a, 'b> {
+    limits: &'b Limits,
+    left_binders: FxHashSet<Type<'a>>,
+    right_binders: FxHashSet<Type<'a>>,
+    left_to_right: FxHashMap<Type<'a>, Type<'a>>,
+    right_to_left: FxHashMap<Type<'a>, Type<'a>>,
+    active: FxHashSet<(Type<'a>, Type<'a>)>,
+    self_dual: bool,
+    extra: Option<(Type<'a>, Type<'a>)>,
+    comparing_bounds: bool,
+}
+
+impl<'a, 'b> Matcher<'a, 'b> {
+    fn new(limits: &'b Limits, self_dual: bool) -> Self {
+        Self {
+            limits,
+            left_binders: FxHashSet::default(),
+            right_binders: FxHashSet::default(),
+            left_to_right: FxHashMap::default(),
+            right_to_left: FxHashMap::default(),
+            active: FxHashSet::default(),
+            self_dual,
+            extra: None,
+            comparing_bounds: false,
+        }
+    }
+
+    fn register(&mut self, left: TypeList<'a>, right: TypeList<'a>) {
+        self.left_binders
+            .extend(left.iter().filter(|param| param.is_type_parameter()));
+        self.right_binders
+            .extend(right.iter().filter(|param| param.is_type_parameter()));
+    }
+
+    fn parameter(&mut self, left: TsSymbol<'a>, right: TsSymbol<'a>, depth: usize) -> bool {
+        is_optional(left) == is_optional(right)
+            && is_rest(left) == is_rest(right)
+            && self.ty(left.get_type(), right.get_type(), depth + 1)
+    }
+
+    fn ty(&mut self, left: Type<'a>, right: Type<'a>, depth: usize) -> bool {
+        if left == right {
+            return true;
+        }
+        if depth > MAX_DEPTH || !Limits::take(&self.limits.work, MAX_WORK) {
+            return false;
+        }
+        if let Some(base) = no_infer_base(left) {
+            return self.ty(base, right, depth + 1);
+        }
+        if let Some(base) = no_infer_base(right) {
+            return self.ty(left, base, depth + 1);
+        }
+        if self.self_dual
+            && !left.is_type_parameter()
+            && self.right_binders.contains(&right)
+            && !self.right_to_left.contains_key(&right)
+        {
+            if let Some((extra, target)) = self.extra {
+                return right == extra && (self.comparing_bounds || left == target);
+            }
+            if self.comparing_bounds {
+                return false;
+            }
+            self.extra = Some((right, left));
+            return true;
+        }
+        if !self.active.insert((left, right)) {
+            return true;
+        }
+        let matches = self.type_shape(left, right, depth);
+        self.active.remove(&(left, right));
+        matches
+    }
+
+    fn type_shape(&mut self, left: Type<'a>, right: Type<'a>, depth: usize) -> bool {
+        let left_alias = left.alias_symbol();
+        let right_alias = right.alias_symbol();
+        if left_alias.is_some() || right_alias.is_some() {
+            return same_symbol(left_alias, right_alias)
+                && self.list(
+                    left.alias_type_arguments(),
+                    right.alias_type_arguments(),
+                    depth + 1,
+                );
+        }
+        if left.is_type_parameter() || right.is_type_parameter() {
+            return left.is_type_parameter()
+                && right.is_type_parameter()
+                && self.binder(left, right);
+        }
+
+        let flags = left.flags();
+        if flags != right.flags() {
+            return false;
+        }
+        if flags.intersects(TypeFlags::UNION) {
+            let left = left.types();
+            let right = right.types();
+            return left.len() == right.len()
+                && self.union(left, right, &mut vec![false; right.len()], 0, depth + 1);
+        }
+        if flags.intersects(TypeFlags::INTERSECTION) {
+            return self.list(left.types(), right.types(), depth + 1);
+        }
+        if flags.intersects(TypeFlags::OBJECT) {
+            return self.object(left, right, depth + 1);
+        }
+        if flags.intersects(TypeFlags::LITERAL) {
+            return left.value().is_some()
+                && left.value() == right.value()
+                && optional_symbol_matches(left.symbol(), right.symbol());
+        }
+        if flags.intersects(TypeFlags::UNIQUE_ES_SYMBOL | TypeFlags::ENUM) {
+            return same_symbol(left.symbol(), right.symbol());
+        }
+        if flags.intersects(TypeFlags::SINGLETON) {
+            return true;
+        }
+        self.structured(left, right, depth + 1)
+    }
+
+    fn binder(&mut self, left: Type<'a>, right: Type<'a>) -> bool {
+        if self.extra.is_some_and(|(extra, _)| right == extra) {
+            return false;
+        }
+        match (
+            self.left_binders.contains(&left),
+            self.right_binders.contains(&right),
+        ) {
+            (false, false) => same_symbol(left.symbol(), right.symbol()),
+            (true, true) => {
+                if let Some(&previous) = self.left_to_right.get(&left) {
+                    return previous == right;
+                }
+                if self.right_to_left.contains_key(&right) {
+                    return false;
+                }
+                self.left_to_right.insert(left, right);
+                self.right_to_left.insert(right, left);
+                true
+            }
+            _ => false,
+        }
+    }
+
+    fn structured(&mut self, left: Type<'a>, right: Type<'a>, depth: usize) -> bool {
+        use TypeStructure::{Conditional, Index, IndexedAccess, StringMapping, TemplateLiteral};
+        match (left.structure(), right.structure()) {
+            (
+                Conditional {
+                    check_type: lc,
+                    extends_type: le,
+                    root_true_type: ly,
+                    root_false_type: ln,
+                    ..
+                },
+                Conditional {
+                    check_type: rc,
+                    extends_type: re,
+                    root_true_type: ry,
+                    root_false_type: rn,
+                    ..
+                },
+            ) => {
+                self.ty(lc, rc, depth)
+                    && self.ty(le, re, depth)
+                    && self.ty(ly, ry, depth)
+                    && self.ty(ln, rn, depth)
+            }
+            (
+                IndexedAccess {
+                    object_type: lo,
+                    index_type: li,
+                },
+                IndexedAccess {
+                    object_type: ro,
+                    index_type: ri,
+                },
+            ) => self.ty(lo, ro, depth) && self.ty(li, ri, depth),
+            (Index { ty: left }, Index { ty: right }) => self.ty(left, right, depth),
+            (StringMapping { ty: lt }, StringMapping { ty: rt }) => {
+                same_symbol(left.symbol(), right.symbol()) && self.ty(lt, rt, depth)
+            }
+            (
+                TemplateLiteral {
+                    texts: left_text,
+                    types: left,
+                },
+                TemplateLiteral {
+                    texts: right_text,
+                    types: right,
+                },
+            ) => left_text == right_text && self.list(left, right, depth),
+            // Substitution bases and constraints are not exposed as type parts.
+            _ => false,
+        }
+    }
+
+    fn list(&mut self, left: TypeList<'a>, right: TypeList<'a>, depth: usize) -> bool {
+        left.len() == right.len()
+            && left
+                .iter()
+                .zip(right)
+                .all(|(left, right)| self.ty(left, right, depth + 1))
+    }
+
+    fn union(
+        &mut self,
+        left: TypeList<'a>,
+        right: TypeList<'a>,
+        used: &mut [bool],
+        index: usize,
+        depth: usize,
+    ) -> bool {
+        let Some(left_type) = left.get(index) else {
+            return true;
+        };
+        for (i, right_type) in right.iter().enumerate() {
+            if used[i] {
+                continue;
+            }
+            if !Limits::take(&self.limits.union_search, MAX_UNION_SEARCH) {
+                return false;
+            }
+            let mut branch = self.clone();
+            if branch.ty(left_type, right_type, depth + 1) {
+                used[i] = true;
+                let matches = branch.union(left, right, used, index + 1, depth + 1);
+                used[i] = false;
+                if matches {
+                    *self = branch;
+                    return true;
+                }
+            }
+        }
+        false
+    }
+
+    fn object(&mut self, left: Type<'a>, right: Type<'a>, depth: usize) -> bool {
+        let left_flags = left.object_flags();
+        let right_flags = right.object_flags();
+        if (left_flags | right_flags).intersects(ObjectFlags::MAPPED) {
+            return self.mapped(left, right, depth + 1);
+        }
+        if (left_flags | right_flags).intersects(
+            ObjectFlags::REVERSE_MAPPED
+                | ObjectFlags::EVOLVING_ARRAY
+                | ObjectFlags::INSTANTIATION_EXPRESSION_TYPE,
+        ) {
+            return false;
+        }
+        if (left_flags | right_flags).intersects(ObjectFlags::REFERENCE) {
+            return (left_flags & right_flags).intersects(ObjectFlags::REFERENCE)
+                && same_reference_target(left, right)
+                && self.list(
+                    left.get_type_arguments(),
+                    right.get_type_arguments(),
+                    depth + 1,
+                );
+        }
+        if !(left_flags & right_flags).intersects(ObjectFlags::ANONYMOUS) {
+            return !(left_flags | right_flags).intersects(ObjectFlags::ANONYMOUS)
+                && same_symbol(left.symbol(), right.symbol());
+        }
+        self.anonymous_object(left, right, depth + 1)
+    }
+
+    fn mapped(&mut self, left: Type<'a>, right: Type<'a>, depth: usize) -> bool {
+        let (
+            TypeStructure::Mapped {
+                type_parameter: lp,
+                constraint_type: lc,
+                name_type: ln,
+                template_type: lt,
+                readonly: lr,
+                optional: lo,
+            },
+            TypeStructure::Mapped {
+                type_parameter: rp,
+                constraint_type: rc,
+                name_type: rn,
+                template_type: rt,
+                readonly: rr,
+                optional: ro,
+            },
+        ) = (left.structure(), right.structure())
+        else {
+            return false;
+        };
+        if lr != rr || lo != ro {
+            return false;
+        }
+        self.left_binders.insert(lp);
+        self.right_binders.insert(rp);
+        self.ty(lp, rp, depth + 1)
+            && self.ty(lc, rc, depth + 1)
+            && self.optional_type(ln, rn, depth + 1)
+            && self.ty(lt, rt, depth + 1)
+    }
+
+    fn anonymous_object(&mut self, left: Type<'a>, right: Type<'a>, depth: usize) -> bool {
+        let left_props = left.get_properties();
+        let right_props = right.get_properties();
+        if left_props.len() != right_props.len()
+            || !left_props.iter().all(|left_property| {
+                right
+                    .get_property(left_property.name())
+                    .is_some_and(|right_property| {
+                        is_optional(left_property) == is_optional(right_property)
+                            && is_readonly(left_property) == is_readonly(right_property)
+                            && self.ty(
+                                left_property.get_type(),
+                                right_property.get_type(),
+                                depth + 1,
+                            )
+                    })
+            })
+        {
+            return false;
+        }
+
+        let left_indexes = left.get_index_infos();
+        let right_indexes = right.get_index_infos();
+        if left_indexes.len() != right_indexes.len()
+            || !left_indexes
+                .zip(right_indexes)
+                .all(|(left_index, right_index)| {
+                    left_index.is_readonly() == right_index.is_readonly()
+                        && self.ty(left_index.key_type(), right_index.key_type(), depth + 1)
+                        && self.ty(left_index.ty(), right_index.ty(), depth + 1)
+                })
+            || !left.get_construct_signatures().is_empty()
+            || !right.get_construct_signatures().is_empty()
+        {
+            return false;
+        }
+
+        let left_calls = left.get_call_signatures();
+        let right_calls = right.get_call_signatures();
+        left_calls.len() == right_calls.len()
+            && (left_calls.is_empty()
+                || (!(left.object_flags() | right.object_flags())
+                    .intersects(ObjectFlags::INSTANTIATED)
+                    && left_calls
+                        .iter()
+                        .zip(right_calls)
+                        .all(|(left, right)| self.signature(left, right, depth + 1))))
+    }
+
+    fn signature(&mut self, left: Signature<'a>, right: Signature<'a>, depth: usize) -> bool {
+        if required_arity(left) != required_arity(right)
+            || left.get_type_predicate().is_some()
+            || right.get_type_predicate().is_some()
+        {
+            return false;
+        }
+        self.register(left.type_parameters(), right.type_parameters());
+        let this_matches = match (left.this_parameter(), right.this_parameter()) {
+            (Some(left), Some(right)) => self.parameter(left, right, depth + 1),
+            (None, None) => true,
+            _ => false,
+        };
+        let left_params = left.parameters();
+        let right_params = right.parameters();
+        this_matches
+            && left_params.len() == right_params.len()
+            && left_params
+                .iter()
+                .zip(right_params)
+                .all(|(left, right)| self.parameter(left, right, depth + 1))
+            && self.ty(left.get_return_type(), right.get_return_type(), depth + 1)
+    }
+
+    fn validate_binders(&mut self) -> bool {
+        if self.self_dual {
+            let Some((extra, _)) = self.extra else {
+                return false;
+            };
+            if constraint(extra).is_some() || default_type(extra).is_some() {
+                return false;
+            }
+        }
+        if self.left_binders.len() + usize::from(self.extra.is_some()) != self.right_binders.len()
+            || self.left_to_right.len() != self.left_binders.len()
+        {
+            return false;
+        }
+
+        let pairs: Vec<_> = self
+            .left_to_right
+            .iter()
+            .map(|(&left, &right)| (left, right))
+            .collect();
+        self.comparing_bounds = true;
+        pairs.into_iter().all(|(left, right)| {
+            let left_constraint = constraint(left);
+            let right_constraint = constraint(right);
+            if modifiers(left) != modifiers(right)
+                || !self.optional_type(left_constraint, right_constraint, 0)
+            {
+                return false;
+            }
+            let mut left_default = default_type(left);
+            let mut right_default = default_type(right);
+            if self.self_dual && left_default.is_some() != right_default.is_some() {
+                left_default = left_default.or(left_constraint);
+                right_default = right_default.or(right_constraint);
+            }
+            self.optional_type(left_default, right_default, 0)
+        })
+    }
+
+    fn optional_type(
+        &mut self,
+        left: Option<Type<'a>>,
+        right: Option<Type<'a>>,
+        depth: usize,
+    ) -> bool {
+        match (left, right) {
+            (Some(left), Some(right)) => self.ty(left, right, depth + 1),
+            (None, None) => true,
+            _ => false,
+        }
+    }
+}
+
+fn is_readonly(symbol: TsSymbol<'_>) -> bool {
+    symbol.check_flags().intersects(CheckFlags::READONLY)
+        || symbol
+            .declarations()
+            .any(|decl| decl.has_modifier(ModifierFlags::READONLY))
+}
+
+fn optional_symbol_matches<'a>(left: Option<TsSymbol<'a>>, right: Option<TsSymbol<'a>>) -> bool {
+    (left.is_none() && right.is_none()) || same_symbol(left, right)
+}
+
+fn constraint(ty: Type<'_>) -> Option<Type<'_>> {
+    ty.symbol()
+        .and_then(|symbol| symbol.declarations().find_map(TsNode::constraint))
+        .map(TsNode::get_type_from_type_node)
+        .or_else(|| ty.get_base_constraint_of_type())
+}
+
+fn default_type(ty: Type<'_>) -> Option<Type<'_>> {
+    ty.symbol()?
+        .declarations()
+        .find_map(TsNode::default_type)
+        .map(TsNode::get_type_from_type_node)
+}
+
+fn modifiers(ty: Type<'_>) -> ModifierFlags {
+    ty.symbol().map_or(ModifierFlags::empty(), |symbol| {
+        symbol
+            .declarations()
+            .fold(ModifierFlags::empty(), |flags, declaration| {
+                flags | declaration.modifier_flags()
+            })
+            & (ModifierFlags::IN | ModifierFlags::OUT | ModifierFlags::CONST)
+    })
+}
+
+fn no_infer_base(ty: Type<'_>) -> Option<Type<'_>> {
+    let args = ty.alias_type_arguments();
+    if args.len() != 1 {
+        return None;
+    }
+    let symbol = ty.alias_symbol()?;
+    if symbol.declarations().any(is_no_infer_alias) {
+        args.first()
+    } else {
+        None
+    }
+}
+
+fn is_no_infer_alias<'a>(declaration: TsNode<'a>) -> bool {
+    if declaration.kind() != SyntaxKind::TypeAliasDeclaration {
+        return false;
+    }
+    let mut parameters = declaration
+        .children()
+        .filter(|node| node.kind() == SyntaxKind::TypeParameter);
+    let Some(parameter) = parameters.next() else {
+        return false;
+    };
+    if parameters.next().is_some() {
+        return false;
+    }
+    let Some(body) = declaration.type_node() else {
+        return false;
+    };
+    if body.kind() == SyntaxKind::IntrinsicKeyword {
+        return true;
+    }
+    if body.kind() != SyntaxKind::IndexedAccessType {
+        return false;
+    }
+
+    let parts: Vec<_> = body.children().collect();
+    let [object, index] = parts.as_slice() else {
+        return false;
+    };
+    if object.kind() != SyntaxKind::TupleType || index.kind() != SyntaxKind::ConditionalType {
+        return false;
+    }
+    let tuple: Vec<_> = object.children().collect();
+    let conditional: Vec<_> = index.children().collect();
+    let ([element], [check, extends, yes, no]) = (tuple.as_slice(), conditional.as_slice()) else {
+        return false;
+    };
+    let binder = parameter.name().and_then(TsNode::get_symbol_at_location);
+    let refers_to_binder = |node: TsNode<'a>| {
+        node.kind() == SyntaxKind::TypeReference
+            && node.children().len() == 1
+            && node
+                .children()
+                .next()
+                .is_some_and(|name| same_symbol(name.get_symbol_at_location(), binder))
+    };
+    extends.kind() == SyntaxKind::AnyKeyword
+        && no.kind() == SyntaxKind::NeverKeyword
+        && yes.kind() == SyntaxKind::LiteralType
+        && yes.children().next().is_some_and(|literal| {
+            literal.kind() == SyntaxKind::NumericLiteral && literal.text() == b"0"
+        })
+        && refers_to_binder(*element)
+        && refers_to_binder(*check)
+}
diff --git a/src/lint/plugins/effect/piping_flow.rs b/src/lint/plugins/effect/piping_flow.rs
new file mode 100644
index 000000000..a9a122f6c
--- /dev/null
+++ b/src/lint/plugins/effect/piping_flow.rs
@@ -0,0 +1,386 @@
+// Adapted from Effect's MIT-licensed ets_typeparser at 0e722d359c969bdf1b1316f08e8637022cde3cce.
+use super::generator_context::{call_syntax, is_direct_function};
+use super::pipeable_signature_shape::{data_subject, has_rest, is_curried, required_arity};
+use super::type_parser::{
+    is_node_reference_to_effect_module_api, is_node_reference_to_effect_package_export,
+    skip_parentheses,
+};
+use bun_lint::ast::{Expr, File, Node};
+use bun_lint::modules::Modules;
+use bun_lint::types::{SyntaxKind as Kind, TsNode, Type, TypeFlags};
+use smallvec::SmallVec;
+
+#[derive(Clone, Copy)]
+enum Output<'a> {
+    Expression(TsNode<'a>),
+    Call(TsNode<'a>),
+    Argument { call: TsNode<'a>, index: usize },
+}
+
+impl<'a> Output<'a> {
+    fn ty(self) -> Option<Type<'a>> {
+        match self {
+            Self::Expression(node) => usable(node.get_type_at_location()),
+            Self::Call(node) => usable(node.get_resolved_signature()?.get_return_type()),
+            Self::Argument { call, index } => {
+                let input = contextual_signature(call, index + 1)
+                    .and_then(|signature| signature.parameters().first())
+                    .and_then(|parameter| usable(parameter.get_type()));
+                if input.is_some_and(|ty| !ty.has_flags(TypeFlags::ANY | TypeFlags::UNKNOWN)) {
+                    return input;
+                }
+                let output = contextual_signature(call, index)
+                    .and_then(|signature| usable(signature.get_return_type()));
+                output
+                    .filter(|ty| !ty.has_flags(TypeFlags::ANY | TypeFlags::UNKNOWN))
+                    .or(input)
+                    .or(output)
+            }
+        }
+    }
+}
+
+fn usable(ty: Type<'_>) -> Option<Type<'_>> {
+    (!ty.is_error() && !ty.is_unresolved()).then_some(ty)
+}
+
+fn contextual_signature(call: TsNode<'_>, index: usize) -> Option<bun_lint::types::Signature<'_>> {
+    call.get_resolved_signature()
+        .and_then(|signature| signature.parameters().get(index))
+        .map(|parameter| parameter.get_type())
+        .and_then(|ty| ty.get_call_signatures().first())
+        .or_else(|| {
+            call.get_contextual_type_for_argument_at_index(index)?
+                .get_call_signatures()
+                .first()
+        })
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Step<'a> {
+    pub(super) callee: TsNode<'a>,
+    pub(super) argument_count: usize,
+    output: Output<'a>,
+    applied_input: Option<TsNode<'a>>,
+}
+
+impl<'a> Step<'a> {
+    pub(super) fn output_type(self) -> Option<Type<'a>> {
+        self.output.ty()
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Subject<'a> {
+    Expression(TsNode<'a>),
+    EffectFn { call: TsNode<'a>, first_step: usize },
+}
+
+impl<'a> Subject<'a> {
+    fn ty(self) -> Option<Type<'a>> {
+        match self {
+            Self::Expression(node) => usable(node.get_type_at_location()),
+            Self::EffectFn { call, first_step } => {
+                let contextual = call
+                    .get_contextual_type_for_argument_at_index(first_step)
+                    .and_then(|ty| ty.get_call_signatures().first());
+                let signature = contextual.or_else(|| contextual_signature(call, first_step))?;
+                usable(signature.parameters().first()?.get_type())
+            }
+        }
+    }
+}
+
+pub(super) struct Flow<'a> {
+    subject: Subject<'a>,
+    pub(super) steps: Vec<Step<'a>>,
+}
+
+impl<'a> Flow<'a> {
+    pub(super) fn input_type(&self, index: usize) -> Option<Type<'a>> {
+        match index.checked_sub(1) {
+            Some(previous) => self.steps[previous].output_type(),
+            None => self.subject.ty(),
+        }
+    }
+
+    pub(super) fn input_node(&self, index: usize) -> Option<TsNode<'a>> {
+        self.steps[index].applied_input.or_else(|| {
+            if index != 0 {
+                return None;
+            }
+            Some(match self.subject {
+                Subject::Expression(node) | Subject::EffectFn { call: node, .. } => node,
+            })
+        })
+    }
+}
+
+/// Walk source expressions once per rule. A subject chain is flattened, while the body,
+/// callee children and other value arguments can start independent flows.
+pub(super) fn visit<'a>(
+    file: &'a File<'a>,
+    modules: &dyn Modules,
+    include_effect_fn: bool,
+    mut visit_flow: impl FnMut(&Flow<'a>),
+) {
+    let root = file.type_checker().ts_node(file);
+    let mut pending: Vec<_> = root.children().collect();
+    let mut steps = Vec::new();
+
+    while let Some(root) = pending.pop() {
+        let mut node = skip_parentheses(root);
+        loop {
+            if let Some(subject) = normalize(
+                node,
+                modules,
+                include_effect_fn,
+                &mut pending,
+                &mut steps,
+                &mut visit_flow,
+            ) {
+                node = skip_parentheses(subject);
+                continue;
+            }
+            if !steps.is_empty() {
+                steps.reverse();
+                let mut flow = Flow {
+                    subject: Subject::Expression(node),
+                    steps: std::mem::take(&mut steps),
+                };
+                visit_flow(&flow);
+                flow.steps.clear();
+                steps = flow.steps;
+            }
+            break;
+        }
+    }
+}
+
+/// Append steps in reverse (outermost to innermost) as the walk follows the subject.
+fn normalize<'a>(
+    call: TsNode<'a>,
+    modules: &dyn Modules,
+    include_effect_fn: bool,
+    pending: &mut Vec<TsNode<'a>>,
+    steps: &mut Vec<Step<'a>>,
+    visit_flow: &mut impl FnMut(&Flow<'a>),
+) -> Option<TsNode<'a>> {
+    let Some(syntax) = call_syntax(call) else {
+        pending.extend(call.children());
+        return None;
+    };
+    let Some(callee) = call.expression() else {
+        pending.extend(call.children());
+        return None;
+    };
+    let args: SmallVec<[_; 4]> = syntax.args().iter().collect();
+
+    if include_effect_fn
+        && args.len() > 1
+        && let Some(body) = effect_fn_body(callee, &args, modules)
+        && body + 1 < args.len()
+    {
+        let first_step = body + 1;
+        let steps = argument_steps(call, &args[first_step..], first_step, false).collect();
+        visit_flow(&Flow {
+            subject: Subject::EffectFn { call, first_step },
+            steps,
+        });
+        pending.extend(args[body].ts_node_with_parentheses().children());
+        enqueue_step_children(pending, &args[first_step..]);
+        return None;
+    }
+
+    if let Some((subject, first_step)) = pipe_subject(callee, &args, modules) {
+        steps.extend(argument_steps(call, &args[first_step..], first_step, true).rev());
+        enqueue_step_children(pending, &args[first_step..]);
+        return Some(subject);
+    }
+
+    if args.is_empty()
+        || args
+            .iter()
+            .any(|arg| arg.ts_node_with_parentheses().kind() == Kind::SpreadElement)
+    {
+        pending.extend(call.children());
+        return None;
+    }
+
+    if args.len() == 1 {
+        let subject = args[0].ts_node_with_parentheses();
+        let factory = skip_parentheses(callee);
+        if let Some(factory_call) = call_syntax(factory)
+            && let Some(Node::Expr(factory_expr)) = factory.to_ast()
+            && let Some(factory_callee) = factory.expression()
+        {
+            let factory_args: SmallVec<[_; 4]> = factory_call.args().iter().collect();
+            let inner_callee = factory_call.callee();
+            if !factory_args.is_empty()
+                && is_curried(factory_expr, inner_callee, &factory_args, args[0])
+            {
+                steps.push(Step {
+                    callee: factory_callee,
+                    argument_count: factory_args.len(),
+                    output: Output::Call(call),
+                    applied_input: Some(subject),
+                });
+                pending.push(factory_callee);
+                pending.extend(
+                    factory_args
+                        .iter()
+                        .map(|arg| arg.ts_node_with_parentheses()),
+                );
+                return Some(subject);
+            }
+        }
+        steps.push(Step {
+            callee,
+            argument_count: 0,
+            output: Output::Call(call),
+            applied_input: Some(subject),
+        });
+        pending.extend(callee.children());
+        return Some(subject);
+    }
+
+    if let Some(index) = data_subject_from_node(call, callee, &args) {
+        return Some(append_call_step(
+            callee,
+            &args,
+            index,
+            Output::Expression(call),
+            steps,
+            pending,
+        ));
+    }
+
+    if let Some(Node::Expr(callee_expr)) = callee.to_ast()
+        && callee_expr.ty().get_call_signatures().len() == 1
+        && let Some(signature) = call.get_resolved_signature()
+        && required_arity(signature) == 1
+        && !has_rest(signature)
+        && args.len() <= signature.parameters().len()
+    {
+        return Some(append_call_step(
+            callee,
+            &args,
+            0,
+            Output::Call(call),
+            steps,
+            pending,
+        ));
+    }
+
+    pending.extend(call.children());
+    None
+}
+
+fn data_subject_from_node<'a>(
+    call: TsNode<'a>,
+    callee: TsNode<'a>,
+    args: &[Expr<'a>],
+) -> Option<usize> {
+    let (Node::Expr(call), Node::Expr(callee)) = (call.to_ast()?, callee.to_ast()?) else {
+        return None;
+    };
+    data_subject(call, callee, args)
+}
+
+fn append_call_step<'a>(
+    callee: TsNode<'a>,
+    args: &[Expr<'a>],
+    index: usize,
+    output: Output<'a>,
+    steps: &mut Vec<Step<'a>>,
+    pending: &mut Vec<TsNode<'a>>,
+) -> TsNode<'a> {
+    let subject = args[index].ts_node_with_parentheses();
+    steps.push(Step {
+        callee,
+        argument_count: args.len() - 1,
+        output,
+        applied_input: Some(subject),
+    });
+    pending.extend(callee.children());
+    pending.extend(
+        args.iter()
+            .enumerate()
+            .filter_map(|(i, arg)| (i != index).then(|| arg.ts_node_with_parentheses())),
+    );
+    subject
+}
+
+fn pipe_subject<'a>(
+    callee: TsNode<'a>,
+    args: &[Expr<'a>],
+    modules: &dyn Modules,
+) -> Option<(TsNode<'a>, usize)> {
+    let kind = callee.kind();
+    if kind == Kind::PropertyAccessExpression && callee.name()?.text() != b"pipe" {
+        return None;
+    }
+    if matches!(kind, Kind::Identifier | Kind::PropertyAccessExpression)
+        && is_node_reference_to_effect_package_export(callee, b"pipe", modules)
+    {
+        return Some((args.first()?.ts_node_with_parentheses(), 1));
+    }
+    if kind == Kind::PropertyAccessExpression {
+        return Some((callee.expression()?, 0));
+    }
+    None
+}
+
+fn effect_fn_body(callee: TsNode<'_>, args: &[Expr<'_>], modules: &dyn Modules) -> Option<usize> {
+    let index = args.iter().position(|&arg| is_direct_function(arg))?;
+    let (callee, apis): (_, &[&[u8]]) = if let Some(factory) = call_syntax(callee) {
+        if factory.args().is_empty() {
+            (
+                callee.expression()?,
+                &[b"fn", b"fnUntraced", b"fnUntracedEager"],
+            )
+        } else {
+            (callee.expression()?, &[b"fn"])
+        }
+    } else {
+        (callee, &[b"fn", b"fnUntraced", b"fnUntracedEager"])
+    };
+    is_node_reference_to_effect_module_api(callee, apis, modules).then_some(index)
+}
+
+fn enqueue_step_children<'a>(pending: &mut Vec<TsNode<'a>>, args: &[Expr<'a>]) {
+    for arg in args {
+        pending.extend(arg.ts_node_with_parentheses().children());
+    }
+}
+
+fn argument_steps<'a, 's>(
+    call: TsNode<'a>,
+    args: &'s [Expr<'a>],
+    start: usize,
+    last_is_call_result: bool,
+) -> impl DoubleEndedIterator<Item = Step<'a>> + 's
+where
+    'a: 's,
+{
+    args.iter().enumerate().map(move |(offset, arg)| {
+        let node = arg.ts_node_with_parentheses();
+        let (callee, argument_count) = call_syntax(node)
+            .and_then(|syntax| Some((node.expression()?, syntax.args().len())))
+            .unwrap_or((node, 0));
+        let output = if last_is_call_result && offset + 1 == args.len() {
+            Output::Expression(call)
+        } else {
+            Output::Argument {
+                call,
+                index: start + offset,
+            }
+        };
+        Step {
+            callee,
+            argument_count,
+            output,
+            applied_input: None,
+        }
+    })
+}
diff --git a/src/lint/plugins/effect/rules/bun_catch_unfailable_effect.rs b/src/lint/plugins/effect/rules/bun_catch_unfailable_effect.rs
new file mode 100644
index 000000000..e8196c36d
--- /dev/null
+++ b/src/lint/plugins/effect/rules/bun_catch_unfailable_effect.rs
@@ -0,0 +1,52 @@
+use crate::effect::{piping_flow, report, type_parser};
+use bun_lint::prelude::*;
+use bun_lint::types::TypeFlags;
+
+const MESSAGE: &Message = &Message::new(
+    "catchUnfailableEffect",
+    "The previous Effect does not fail, so this error-handling branch will never run.",
+);
+const CATCH_APIS: &[&[u8]] = &[
+    b"catch",
+    b"catchAll",
+    b"catchIf",
+    b"catchSome",
+    b"catchTag",
+    b"catchTags",
+];
+
+effect_rule!(
+    CatchUnfailableEffect,
+    b"catchUnfailableEffect",
+    "catch-unfailable-effect",
+    On::new().finish(),
+    fn finish(&self, cx: &mut Cx<'_, Self>) {
+        let file = cx.file();
+        let Some(modules) = file.modules() else {
+            return;
+        };
+        piping_flow::visit(file, modules, true, |flow| {
+            for (index, step) in flow.steps.iter().enumerate() {
+                if !type_parser::is_node_reference_to_effect_module_api(
+                    step.callee,
+                    CATCH_APIS,
+                    modules,
+                ) {
+                    continue;
+                }
+                if flow
+                    .input_type(index)
+                    .and_then(type_parser::effect)
+                    .is_some_and(|effect| effect.error.has_flags(TypeFlags::NEVER))
+                {
+                    report(
+                        cx,
+                        self.hidden_by_default,
+                        type_parser::diagnostic_span(file, step.callee),
+                        MESSAGE,
+                    );
