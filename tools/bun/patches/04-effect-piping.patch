+declare function differentSymbols<A>(self: Left.Same<A>, size: number): Thunk<A>;
+declare function differentSymbols<A>(size: number): (self: Right.Same<A>) => Thunk<A>;
+declare function differentDefault<A, B = A>(self: Box<A>, f: (value: A) => B): Thunk<B>;
+declare function differentDefault<A, B = string>(f: (value: A) => B): (self: Box<A>) => Thunk<B>;
+declare function differentReadonly<A, B>(self: Box<A>, options: { readonly f: (value: A) => B }): Thunk<B>;
+declare function differentReadonly<A, B>(options: { f: (value: A) => B }): (self: Box<A>) => Thunk<B>;
+declare function optionalSubject<A>(self: Box<A>, size: number): Thunk<A>;
