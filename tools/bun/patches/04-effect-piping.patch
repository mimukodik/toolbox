--- /dev/null
+++ b/src/lint/plugins/effect/rules/bun_lazy_promise_in_effect_sync.rs
@@ -0,0 +1,59 @@
+use crate::effect::{piping_flow, report, type_parser};
+use bun_lint::prelude::*;
+use bun_lint::types::Type;
+
+const MESSAGE: &Message = &Message::new(
+    "lazyPromiseInEffectSync",
+    "This `Effect.sync` thunk returns a Promise. Use `Effect.promise` or `Effect.tryPromise` to represent async work.",
+);
+
+fn thunk_returns_promise<'a>(input: Type<'a>, promise: Type<'a>) -> bool {
+    type_parser::union_members(input).into_iter().any(|member| {
+        member.get_call_signatures().into_iter().any(|signature| {
+            let output = signature.get_return_type();
+            output == promise || output.target() == Some(promise)
+        })
+    })
+}
+
+effect_rule!(
+    LazyPromiseInEffectSync,
+    b"lazyPromiseInEffectSync",
+    "lazy-promise-in-effect-sync",
+    On::new().finish(),
+    fn finish(&self, cx: &mut Cx<'_, Self>) {
+        let file = cx.file();
+        let Some(modules) = file.modules() else {
+            return;
+        };
+        let Some(promise) = type_parser::global_library_type(file.type_checker(), b"Promise")
+        else {
+            return;
+        };
+        piping_flow::visit(file, modules, false, |flow| {
+            for (index, step) in flow.steps.iter().enumerate() {
+                if step.argument_count != 0
+                    || !type_parser::is_node_reference_to_effect_module_api(
+                        step.callee,
+                        &[b"sync"],
+                        modules,
+                    )
+                {
+                    continue;
+                }
+                if flow
+                    .input_type(index)
+                    .is_some_and(|input| thunk_returns_promise(input, promise))
+                {
+                    let node = flow.input_node(index).unwrap_or(step.callee);
+                    report(
+                        cx,
+                        self.hidden_by_default,
+                        type_parser::diagnostic_span(file, node),
+                        MESSAGE,
+                    );
+                }
+            }
+        });
+    }
+);
