--- /dev/null
+++ b/src/lint/plugins/effect/rules/bun_effect_try_without_catch.rs
@@ -0,0 +1,53 @@
+use crate::effect::{piping_flow, report, type_parser};
+use bun_lint::prelude::*;
+use bun_lint::types::TypeFlags;
+
+const MESSAGE: &Message = &Message::new(
+    "effectTryWithoutCatch",
+    "Effect.{{api}} is called without a `catch` handler, so failures surface as the generic `{{type}}`. The object form `{ try, catch }` maps the cause to a typed, domain-specific error.",
+);
+
+effect_rule!(
+    EffectTryWithoutCatch,
+    b"effectTryWithoutCatch",
+    "effect-try-without-catch",
+    On::new().finish(),
+    fn finish(&self, cx: &mut Cx<'_, Self>) {
+        let file = cx.file();
+        let Some(modules) = file.modules() else {
+            return;
+        };
+        piping_flow::visit(file, modules, true, |flow| {
+            for (index, &step) in flow.steps.iter().enumerate() {
+                if step.argument_count != 0 {
+                    continue;
+                }
+                let Some(api) = [b"try".as_slice(), b"tryPromise".as_slice()]
+                    .into_iter()
+                    .find(|name| {
+                        type_parser::is_node_reference_to_effect_module_api(
+                            step.callee,
+                            &[*name],
+                            modules,
+                        )
+                    })
+                else {
+                    continue;
+                };
+                let Some(input) = flow.input_type(index) else {
+                    continue;
+                };
+                if input.has_flags(TypeFlags::ANY) || input.get_call_signatures().is_empty() {
+                    continue;
+                }
+                let Some(effect) = step.output_type().and_then(type_parser::strict_effect) else {
+                    continue;
+                };
+                let span = type_parser::diagnostic_span(file, step.callee);
+                if let Some(report) = report(cx, self.hidden_by_default, span, MESSAGE) {
+                    report.data("api", api).data("type", effect.error.to_text());
+                }
+            }
+        });
+    }
+);
diff --git a/src/lint/plugins/effect/rules/bun_lazy_promise_in_effect_sync.rs b/src/lint/plugins/effect/rules/bun_lazy_promise_in_effect_sync.rs
