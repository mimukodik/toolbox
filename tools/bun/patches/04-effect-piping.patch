+---
+title: "bun/catch-unfailable-effect"
+description: "Report error handlers on Effects that never fail"
+# Generated by src/codegen/lint-rule-docs.ts. Do not edit below this line.
+plugin: "bun"
+aliases: []
+kind: "problem"
+category: null
+default: "off"
+fixable: "no"
+typeAware: true
+deprecated: false
+---
+
+An Effect with a `never` error channel cannot run an error handler. Remove the handler or attach it to the step that can fail.
+
+{/* Generated by src/codegen/lint-rule-docs.ts. Do not edit this section. */}
+
+## Configure
+
+Off by default. This rule needs types, so turning it on makes `bun lint` type check your code first.
+
+```toml bunfig.toml
+[lint.rules]
+"bun/catch-unfailable-effect" = "error" # or "warn"
+```
+
+{/* End of the generated section. */}
+
+## Examples
+
+{/* file "node_modules/effect/index.d.ts" */}
+
+```ts
+export * as Effect from "./Effect";
+```
+
+{/* file "node_modules/effect/Effect.d.ts" */}
+
+```ts
+declare const TypeId: "~effect/Effect";
+export interface Effect<A, E = never, R = never> {
+  readonly [TypeId]: { _A: () => A; _E: () => E; _R: () => R };
+  pipe<B>(step: (self: Effect<A, E, R>) => B): B;
+}
+interface UnknownError { readonly _tag: "UnknownError" }
+declare function try_<A>(thunk: () => A): Effect<A, UnknownError>;
+declare function try_<A, E>(options: { try: () => A; catch: (cause: unknown) => E }): Effect<A, E>;
+declare function catch_<B>(handler: () => Effect<B>): <A, E>(self: Effect<A, E>) => Effect<A | B>;
+export { try_ as try, catch_ as catch };
+export declare function succeed<A>(value: A): Effect<A>;
+export declare function fail<E>(error: E): Effect<never, E>;
+export declare function sync<A>(thunk: () => A): Effect<A>;
+export declare function promise<A>(thunk: () => Promise<A>): Effect<A>;
