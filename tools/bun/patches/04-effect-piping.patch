+declare const object: { readonly a: number };
+    `, [
+      ['reordered(box, { onEmpty: () => "empty", onValue: (value) => value })', true],
+      ["moved(box, 0)", true],
+      ['mapped(object, "b", true)', true],
+      ['callableAlias("value", 1)', true],
+      ['inferredParameters("value", 1)', true],
+      ["distinctRoles(box, String)", false],
+      ["differentBinders(box, (value) => value)", false],
