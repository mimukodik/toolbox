+
+describe("Effect v4 missing channels", () => {
+  test.concurrent("reports the members missing from expected Effect and Layer types", async () => {
+    const code = [
+      'interface Effect<A, E = never, R = never> { "~effect/Effect": { _A: () => A; _E: () => E; _R: () => R } }',
+      'interface Layer<Out, E = never, In = never> { "~effect/Layer": { _ROut: (_: Out) => void; _E: () => E; _RIn: () => In } }',
+      'interface First { first: true }',
+      'interface Second { second: true }',
+      'declare const effectWithErrors: Effect<number, First | Second>;',
+      'declare const effectWithContext: Effect<number, never, First | Second>;',
+      'declare const layerWithServices: Layer<First, never, Second | First>;',
+      'declare function useLayer(layer: Layer<First, never, First>): void;',
+      'export const missingError: Effect<number, First> = effectWithErrors;',
+      '// @ts-expect-error',
+      'export const missingContext: Effect<number, never, First> = effectWithContext;',
+      'useLayer(layerWithServices);',
+      'export const acceptsErrors: Effect<number, First | Second> = effectWithErrors;',
+      'export const acceptsContext: Effect<number, never, First | Second> = effectWithContext;',
+      'export const onlySuccessMismatch: Effect<string, First | Second> = effectWithErrors;',
+      'export function load(): Effect<number> { return effectWithErrors; }',
+      'export const loadLater: () => Effect<number> = () => effectWithErrors;',
+      'declare function run<A, E>(effect: Effect<A, E>): A;',
+      'declare function pipe<A, B>(value: A, run: (value: NoInfer<A>) => B): B;',
+      'export const result = pipe(effectWithContext, run);',
+    ].join("\n");
+    const files = {
+      ".oxlintrc.json": JSON.stringify({ options: { typeAware: true }, categories: { correctness: "off" } }),
+      "tsconfig.json": JSON.stringify({
+        compilerOptions: { ...options, strict: true, plugins: [{ name: "@effect/language-service" }] },
+      }),
+      "channels.ts": code,
+    };
+    const { errors, exitCode } = await lint(files, ["channels.ts"]);
+    expect(errors.map(line => line.split(" ")[0])).toEqual(["9:14", "11:14", "12:10", "16:42", "17:54", "20:47"]);
+    expect(errors[0]).toContain("Missing errors Second in the expected Effect type.");
+    expect(errors[1]).toContain("expected Effect context: `Second`.");
+    expect(errors[2]).toContain("Missing 'Second' in the expected Layer context.");
+    expect(exitCode).toBe(1);
+  });
+});
