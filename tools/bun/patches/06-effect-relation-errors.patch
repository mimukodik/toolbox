@@ -0,0 +1,17 @@
+use crate::effect::relation_errors::{self, Channel};
+use bun_lint::prelude::*;
+
+const MESSAGE: &Message = &Message::new(
+    "missingEffectContext",
+    "This Effect requires a service that is missing from the expected Effect context: `{{types}}`.",
+);
+
+effect_rule!(
+    MissingEffectContext,
+    b"missingEffectContext",
+    "missing-effect-context",
+    On::new().finish(),
+    fn finish(&self, cx: &mut Cx<'_, Self>) {
+        relation_errors::check(cx, self.hidden_by_default, Channel::EffectContext, MESSAGE);
+    }
+);
