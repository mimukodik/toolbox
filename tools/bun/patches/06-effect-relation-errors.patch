index 00000000..560afe61
--- /dev/null
+++ b/src/lint/plugins/effect/relation_errors.rs
@@ -0,0 +1,177 @@
+// Adapted from Effect-TS/tsgo's MIT-licensed missing channel rules at
+// 0e722d359c969bdf1b1316f08e8637022cde3cce.
+use super::{
+    Directives,
+    expected_and_real_type::{self, ExpectedTypes},
+    generator_context::function_syntax,
+    report, type_parser,
+};
+use bun_lint::ast::FnBody;
+use bun_lint::prelude::*;
+use bun_lint::types::{SyntaxKind as Kind, TsNode, Type, TypeFlags};
+use std::collections::HashSet;
+
+#[derive(Clone, Copy)]
+pub(super) enum Channel {
+    EffectError,
+    EffectContext,
+    LayerContext,
+}
+
+pub(super) fn check<'a, R: Rule<State<'a> = Directives>>(
+    cx: &mut Cx<'a, R>,
+    hidden_by_default: bool,
+    channel: Channel,
+    message: &'static Message,
+) {
+    let file = cx.file();
+    let root = file.type_checker().ts_node(file);
+    let mut seen = HashSet::new();
+    expected_and_real_type::visit_relations(root, |pair| {
+        let source = pair.real.get_type_at_location();
+        let Some(ExpectedTypes::Single(target)) = pair.expected.resolve() else {
+            return;
+        };
+        let mut inspect = |node: TsNode<'a>, source: Type<'a>, target: Type<'a>| {
+            let parse = match channel {
+                Channel::EffectError | Channel::EffectContext => type_parser::effect,
+                Channel::LayerContext => type_parser::layer,
+            };
+            let (Some(source), Some(target)) = (parse(source), parse(target)) else {
+                return;
+            };
+            let (source, target) = match channel {
+                Channel::EffectError => (source.error, target.error),
+                Channel::EffectContext | Channel::LayerContext => {
+                    (source.requirements, target.requirements)
+                }
+            };
+            if matches!(channel, Channel::EffectError) && source.has_flags(TypeFlags::NEVER) {
+                return;
+            }
+            let mut missing: Vec<_> = type_parser::union_members(source)
+                .into_iter()
+                .filter(|&member| !member.is_assignable_to(target))
+                .map(|member| String::from_utf8_lossy(&member.to_text()).into_owned())
+                .collect();
+            if missing.is_empty() {
+                return;
+            }
+            if matches!(channel, Channel::LayerContext) {
+                missing.sort_unstable();
+            }
+            let text = missing.join(" | ");
+            let span = type_parser::diagnostic_span(file, node);
+            if seen.insert((span.start, text.clone()))
+                && let Some(report) = report(cx, hidden_by_default, span, message)
+            {
+                report.data("types", text);
+            }
+        };
+        visit_failed(pair.location, pair.real, source, target, &mut inspect);
+    });
+}
+
+fn visit_failed<'a>(
+    location: TsNode<'a>,
+    value: TsNode<'a>,
+    source: Type<'a>,
+    target: Type<'a>,
+    report: &mut impl FnMut(TsNode<'a>, Type<'a>, Type<'a>),
+) {
+    if source == target || source.is_assignable_to(target) {
+        return;
+    }
+    report(location, source, target);
+
+    // The checker can move a failed relation into an object property, array
+    // element or arrow body. Recover the inner comparison at its own node.
+    let value = type_parser::skip_parentheses(value);
+    match value.kind() {
+        Kind::ObjectLiteralExpression => {
+            for property in value.children() {
+                if !matches!(
+                    property.kind(),
+                    Kind::PropertyAssignment | Kind::ShorthandPropertyAssignment
+                ) {
+                    continue;
+                }
+                let Some(name) = property.name() else {
+                    continue;
+                };
+                let key = match name.kind() {
+                    Kind::Identifier | Kind::StringLiteral | Kind::NumericLiteral => name.text(),
+                    _ => continue,
+                };
+                let Some(expected) = target.get_type_of_property(key) else {
+                    continue;
+                };
+                let real = property.initializer().unwrap_or(name);
+                visit_failed(name, real, real.get_type_at_location(), expected, report);
+            }
+        }
+        Kind::ArrayLiteralExpression => {
+            for (index, element) in value.children().enumerate() {
+                if matches!(
+                    element.kind(),
+                    Kind::SpreadElement | Kind::OmittedExpression
+                ) {
+                    continue;
+                }
+                let expected = target
+                    .get_type_of_property(index.to_string().as_bytes())
+                    .or_else(|| target.get_number_index_type());
+                if let Some(expected) = expected {
+                    visit_failed(
+                        element,
+                        element,
+                        element.get_type_at_location(),
+                        expected,
+                        report,
+                    );
+                }
+            }
+        }
+        Kind::ArrowFunction => {
+            if let Some(function) = function_syntax(value)
+                && let FnBody::Expr(body) = function.body()
+                && function
+                    .params()
+                    .iter()
+                    .all(|param| param.ts_node().type_node().is_none())
+            {
+                let signatures = target.get_call_signatures();
+                if signatures.len() == 1
+                    && let Some(signature) = signatures.first()
+                {
+                    let body = body.ts_node_with_parentheses();
+                    visit_failed(
+                        body,
+                        body,
+                        body.get_type_at_location(),
+                        signature.get_return_type(),
+                        report,
+                    );
+                }
+            }
+        }
+        _ => {}
+    }
+
+    // Parameter comparison reverses the assignment: the expected callback's
+    // input must be accepted by the supplied callback. This also covers bare
+    // functions passed to pipe, whose failing Effect is in that input.
+    let source_signatures = source.get_call_signatures();
+    let target_signatures = target.get_call_signatures();
+    if source_signatures.len() == 1
+        && target_signatures.len() == 1
+        && let (Some(source), Some(target)) = (source_signatures.first(), target_signatures.first())
+    {
+        for (accepts, supplied) in source.parameters().into_iter().zip(target.parameters()) {
+            let (source, target) = (supplied.get_type(), accepts.get_type());
+            if !source.is_assignable_to(target) {
+                report(location, source, target);
+            }
+        }
+    }
+}
