--- /dev/null
+++ b/src/lint/plugins/effect/relation_errors.rs
@@ -0,0 +1,270 @@
+// Adapted from Effect-TS/tsgo's MIT-licensed missing channel rules at
+// 0e722d359c969bdf1b1316f08e8637022cde3cce.
+use super::{
+    Directives,
+    expected_and_real_type::{self, Expected, ExpectedTypes},
+    generator_context::function_syntax,
+    report, type_parser,
+};
+use bun_lint::ast::{FnBody, Node};
+use bun_lint::prelude::*;
+use bun_lint::types::{Literal, SignatureList, SyntaxKind as Kind, TsNode, Type, TypeFlags};
+use bun_lint::utils::text::number_to_string;
+use std::borrow::Cow;
+use std::collections::HashSet;
+
+#[derive(Clone, Copy)]
+pub(super) enum Channel {
+    EffectError,
+    EffectContext,
+    LayerContext,
+}
+
+pub(super) fn check<'a, R: Rule<State<'a> = Directives>>(
+    cx: &mut Cx<'a, R>,
+    hidden_by_default: bool,
+    channel: Channel,
+    message: &'static Message,
+) {
+    let file = cx.file();
+    let root = file.type_checker().ts_node(file);
+    let mut seen = HashSet::new();
+    expected_and_real_type::visit_relations(root, |pair| {
+        let returned_from = match &pair.expected {
+            Expected::RelationReturn(function) => function_syntax(*function),
+            _ => None,
+        };
+        let source = returned_from.is_none().then(|| pair.real.get_type_at_location());
+        let Some(ExpectedTypes::Single(target)) = pair.expected.resolve() else {
+            return;
+        };
+        let mut inspect = |node: TsNode<'a>, sources: &[Type<'a>], target: Type<'a>| {
+            let parse = match channel {
+                Channel::EffectError | Channel::EffectContext => type_parser::effect,
+                Channel::LayerContext => type_parser::layer,
+            };
+            let Some(target) = parse(target) else {
+                return;
+            };
+            let target = match channel {
+                Channel::EffectError => target.error,
+                Channel::EffectContext | Channel::LayerContext => target.requirements,
+            };
+            let mut missing = Vec::new();
+            for &source in sources {
+                let Some(source) = parse(source) else {
+                    return;
+                };
+                let source = match channel {
+                    Channel::EffectError => source.error,
+                    Channel::EffectContext | Channel::LayerContext => source.requirements,
+                };
+                if matches!(channel, Channel::EffectError) && source.has_flags(TypeFlags::NEVER) {
+                    continue;
+                }
+                missing.extend(
+                    type_parser::union_members(source)
+                        .into_iter()
+                        .filter(|&member| !member.is_assignable_to(target))
+                        .map(|member| String::from_utf8_lossy(&member.to_text()).into_owned()),
+                );
+            }
+            if missing.is_empty() {
+                return;
+            }
+            if sources.len() > 1 || matches!(channel, Channel::LayerContext) {
+                missing.sort_unstable();
+            }
+            if sources.len() > 1 {
+                missing.dedup();
+            }
+            let text = missing.join(" | ");
+            let span = type_parser::diagnostic_span(file, node);
+            if seen.insert((span.start, text.clone()))
+                && let Some(report) = report(cx, hidden_by_default, span, message)
+            {
+                report.data("types", text);
+            }
+        };
+        if let Some(function) = returned_from {
+            let is_async = function.is_async();
+            let target = if is_async {
+                target.get_awaited_type().unwrap_or(target)
+            } else {
+                target
+            };
+            visit_failed_return(pair.location, pair.real, target, is_async, &mut inspect);
+        } else if let Some(source) = source {
+            visit_failed(pair.location, pair.real, source, target, &mut inspect);
+        }
+    });
+}
+
+fn visit_failed_return<'a>(
+    location: TsNode<'a>,
+    value: TsNode<'a>,
+    target: Type<'a>,
+    is_async: bool,
+    report: &mut impl FnMut(TsNode<'a>, &[Type<'a>], Type<'a>),
+) {
+    let value = type_parser::skip_parentheses(value);
+    // The checker's return expression path checks each conditional arm at its
+    // own node. General assignment elaboration does not split conditionals.
+    if let Some(Node::Expr(expr)) = value.to_ast()
+        && let Some((_, yes, no)) = expr.as_cond()
+    {
+        for arm in [yes, no] {
+            let arm = type_parser::skip_parentheses(arm.ts_node_with_parentheses());
+            visit_failed_return(arm, arm, target, is_async, report);
+        }
+        return;
+    }
+    let source = value.get_type_at_location();
+    if is_async {
+        if let Some(awaited) = source.get_awaited_type() {
+            visit_failed(location, value, awaited, target, report);
+        }
+    } else {
+        visit_failed(location, value, source, target, report);
+    }
+}
+
+fn property_key(name: TsNode<'_>) -> Option<Cow<'_, [u8]>> {
+    match name.kind() {
+        Kind::Identifier | Kind::StringLiteral | Kind::NumericLiteral => {
+            Some(Cow::Borrowed(name.text()))
+        }
+        Kind::ComputedPropertyName => match name.expression()?.get_type_at_location().value()? {
+            Literal::String(value) => Some(Cow::Borrowed(value)),
+            Literal::Number(value) => Some(Cow::Owned(number_to_string(value))),
+            _ => None,
+        },
+        _ => None,
+    }
+}
+
+fn common_return_type(signatures: SignatureList<'_>) -> Option<Type<'_>> {
+    let mut signatures = signatures.into_iter();
+    let first = signatures.next()?.get_return_type();
+    signatures
+        .all(|signature| {
+            let ty = signature.get_return_type();
+            ty == first || (ty.is_assignable_to(first) && first.is_assignable_to(ty))
+        })
+        .then_some(first)
+}
+
+fn visit_failed<'a>(
+    location: TsNode<'a>,
+    value: TsNode<'a>,
+    source: Type<'a>,
+    target: Type<'a>,
+    report: &mut impl FnMut(TsNode<'a>, &[Type<'a>], Type<'a>),
+) {
+    if source == target || source.is_assignable_to(target) {
+        return;
+    }
+    report(location, &[source], target);
+
+    // The checker can move a failed relation into an object property, array
+    // element or arrow body. Recover the inner comparison at its own node.
+    let value = type_parser::skip_parentheses(value);
+    match value.kind() {
+        Kind::ObjectLiteralExpression => {
+            for property in value.children() {
+                if !matches!(
+                    property.kind(),
+                    Kind::PropertyAssignment | Kind::ShorthandPropertyAssignment
+                ) {
+                    continue;
+                }
+                let Some(name) = property.name() else {
+                    continue;
+                };
+                let Some(key) = property_key(name) else {
+                    continue;
+                };
+                let Some(expected) = target.get_type_of_property(&key) else {
+                    continue;
+                };
+                let real = property.initializer().unwrap_or(name);
+                visit_failed(name, real, real.get_type_at_location(), expected, report);
+            }
+        }
+        Kind::ArrayLiteralExpression => {
+            for (index, element) in value.children().enumerate() {
+                if matches!(
+                    element.kind(),
+                    Kind::SpreadElement | Kind::OmittedExpression
+                ) {
+                    continue;
+                }
+                let expected = target
+                    .get_type_of_property(index.to_string().as_bytes())
+                    .or_else(|| target.get_number_index_type());
+                if let Some(expected) = expected {
+                    visit_failed(
+                        element,
+                        element,
+                        element.get_type_at_location(),
+                        expected,
+                        report,
+                    );
+                }
+            }
+        }
+        _ => {}
+    }
+
+    let source_signatures = source.get_call_signatures();
+    let target_signatures = target.get_call_signatures();
+    if source_signatures.len() == 1
+        && let (Some(source), Some(target)) = (source_signatures.first(), target_signatures.first())
+    {
+        let single_target = target_signatures.len() == 1;
+        if matches!(value.kind(), Kind::ArrowFunction | Kind::FunctionExpression)
+            && let Some(function) = function_syntax(value)
+            && let Some(target) = common_return_type(target_signatures)
+        {
+            let source = source.get_return_type();
+            // Concise arrows with untyped parameters elaborate at the body.
+            // Block bodies retain the enclosing assignment or argument site.
+            let body = match function.body() {
+                FnBody::Expr(body)
+                    if value.kind() == Kind::ArrowFunction
+                        && function
+                            .params()
+                            .iter()
+                            .all(|param| param.ts_node().type_node().is_none()) =>
+                {
+                    Some(body.ts_node_with_parentheses())
+                }
+                _ => None,
+            };
+            if !source.is_assignable_to(target) {
+                if value.type_node().is_none() && source.has_flags(TypeFlags::UNION) {
+                    // The inferred signature already collects ternary arms and
+                    // block returns. Inspect the constituents at one location.
+                    let returns: Vec<_> = type_parser::union_members(source).into_iter().collect();
+                    report(body.unwrap_or(location), &returns, target);
+                } else if let Some(body) = body {
+                    visit_failed(body, body, source, target, report);
+                } else {
+                    report(location, &[source], target);
+                }
+            }
+        }
+
+        if !single_target {
+            return;
+        }
+        // The supplied callback must accept the expected callback's input.
+        // This also covers pipe stages that fail on an Effect input.
+        for (accepts, supplied) in source.parameters().into_iter().zip(target.parameters()) {
+            let (source, target) = (supplied.get_type(), accepts.get_type());
+            if !source.is_assignable_to(target) {
+                report(location, &[source], target);
+            }
+        }
+    }
+}
