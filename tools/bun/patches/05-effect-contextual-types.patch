+
+  test.concurrent("compares each expected position with the real Effect", async () => {
+    // Adapt the public diagnostic positions from expected_and_real_type_test.rs.
+    const source = [
+      'import { Effect } from "effect";',
+      "const nested = Effect.succeed(Effect.succeed(1));",
+      "const typed: Effect.Effect<void> = nested;",
+      "const inferred = nested;",
+      "function takesVoid(value: Effect.Effect<void>) {}",
+      "takesVoid(nested);",
+      "const config: { service: Effect.Effect<number>; host: string } = { service: Effect.succeed(1), host: 'localhost' };",
+      "let assigned: Effect.Effect<void> = Effect.succeed(undefined);",
+      "assigned = nested;",
+      "function returned(): Effect.Effect<void> {",
+      "  return nested;",
+      "}",
+      "const arrow: () => Effect.Effect<void> = () => nested;",
+      "const generic = <A>(): Effect.Effect<void> => nested;",
+      "const checked = nested satisfies Effect.Effect<void>;",
+      "function select(key: 'a'): Effect.Effect<void>;",
+      "function select(key: 'b'): Effect.Effect<void, string>;",
+      "function select(key: string): Effect.Effect<void, string> {",
+      "  return nested;",
+      "}",
+      "function mixed(key: 'a'): Effect.Effect<void>;",
+      "function mixed(key: 'b'): string;",
+      "function mixed(key: string): Effect.Effect<void> | string {",
+      "  return nested;",
+      "}",
+      "function predicate(value: unknown): value is Effect.Effect<void> { return typeof value === 'object'; }",
+      'function job(mode: "run"): Effect.Effect<void>;',
+      'function job(mode: "stop"): Effect.Effect<never>;',
+      'function job(mode: "run" | "stop"): Effect.Effect<void> {',
