index 0000000..b883e9a
--- /dev/null
+++ b/src/lint/plugins/effect/rules/bun_run_effect_inside_effect.rs
@@ -0,0 +1,92 @@
+use crate::effect::{
+    generator_context::{self, containing_function, function_syntax},
+    piping_flow, platform_runtime_api, report, type_parser,
+};
+use bun_lint::prelude::*;
+use bun_lint::types::TsNode;
+
+const DIRECT: &Message = &Message::new(
+    "runEffectInsideEffect",
+    "`{{callee}}` is called inside an existing Effect context. Here, the inner Effect can be used directly.",
+);
+const NESTED: &Message = &Message::new(
+    "runEffectInsideEffectNested",
+    "`{{callee}}` is called inside an Effect with a separate services invocation. In this context, child Effects run with the surrounding services, which can be accessed through `Effect.context` and `Effect.{{method}}With`.",
+);
+const PLATFORM: &Message = &Message::new(
+    "runEffectInsideEffectRunMain",
+    "`{{callee}}` is called inside an existing Effect context and starts a separate root runtime that the surrounding Effect does not own. Return the Effect instead and call `{{callee}}` once at the application entry point.",
+);
+const RUN_APIS: &[&[u8]] = &[
+    b"runSync",
+    b"runSyncExit",
+    b"runPromise",
+    b"runPromiseExit",
+    b"runFork",
+    b"runCallback",
+];
+
+fn has_statements(generator: TsNode<'_>) -> bool {
+    function_syntax(generator)
+        .and_then(|function| function.body_statements())
+        .is_some_and(|statements| !statements.is_empty())
+}
+
+effect_rule!(
+    RunEffectInsideEffect,
+    b"runEffectInsideEffect",
+    "run-effect-inside-effect",
+    On::new().finish(),
+    fn finish(&self, cx: &mut Cx<'_, Self>) {
+        let file = cx.file();
+        let Some(modules) = file.modules() else {
+            return;
+        };
+        piping_flow::visit(file, modules, true, |flow| {
+            let mut generator = None;
+            let mut in_thunk = None;
+            for step in &flow.steps {
+                let callee = step.callee;
+                let platform = platform_runtime_api::is_run_main(callee, modules);
+                let method = if platform {
+                    None
+                } else {
+                    type_parser::effect_api_name(callee, RUN_APIS, modules)
+                };
+                if !platform && method.is_none() {
+                    continue;
+                }
+
+                let generator = *generator.get_or_insert_with(|| {
+                    generator_context::runtime_generator(flow.root, modules)
+                });
+                let message = if platform {
+                    if generator.is_none()
+                        && !*in_thunk.get_or_insert_with(|| {
+                            generator_context::in_constructor_thunk(flow.root, modules)
+                        })
+                    {
+                        continue;
+                    }
+                    PLATFORM
+                } else {
+                    let Some(generator) = generator.filter(|&node| has_statements(node)) else {
+                        continue;
+                    };
+                    if containing_function(flow.root) == Some(generator) {
+                        DIRECT
+                    } else {
+                        NESTED
+                    }
+                };
+                let span = type_parser::diagnostic_span(file, callee);
+                if let Some(report) = report(cx, self.hidden_by_default, span, message) {
+                    let report = report.data("callee", callee.get_source_text());
+                    if let Some(method) = method {
+                        report.data("method", method);
+                    }
+                }
+            }
+        });
+    }
+);
