+
+/// Walk past nested function scopes to recover the generator used by the runtime rule.
+pub(super) fn runtime_generator<'a>(node: TsNode<'a>, modules: &dyn Modules) -> Option<TsNode<'a>> {
+    std::iter::once(node)
+        .chain(
+            node.ancestors()
+                .filter(|ancestor| ancestor.kind().is_function_like()),
+        )
+        .find_map(|scope| enclosing_generator(scope, Some(modules)))
+}
