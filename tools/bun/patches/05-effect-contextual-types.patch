+
+describe("Effect v4 expected types and runtime contexts", () => {
+  function project(source: string, severity: Record<string, string>, strictNullChecks = true) {
+    return {
+      ".oxlintrc.json": JSON.stringify({ options: { typeAware: true }, categories: { correctness: "off" } }),
+      "tsconfig.json": JSON.stringify({
+        compilerOptions: { ...options, strict: true, strictNullChecks, plugins: [{ name: "@effect/language-service", diagnosticSeverity: severity }] },
+      }),
+      "node_modules/effect/package.json": '{ "name": "effect", "version": "4.1.2", "types": "./index.d.ts" }',
+      "node_modules/effect/index.d.ts": 'export * as Effect from "./Effect";',
+      "node_modules/effect/Effect.d.ts": [
+        "export interface Effect<A, E = never, R = never> {",
+        '  readonly "~effect/Effect": { _A: () => A; _E: () => E; _R: () => R };',
+        "  pipe<B>(step: (value: Effect<A, E, R>) => B): B;",
+        "  [Symbol.iterator](): Generator<Effect<A, E, R>, A, unknown>;",
+        "}",
+        "export declare function succeed<A>(value: A): Effect<A>;",
+        "export declare const never: Effect<never>;",
+        "export declare function gen<A>(body: () => Generator<unknown, A, unknown>): Effect<A>;",
+        "export declare function runSync<A>(value: Effect<A>): A;",
+        "export declare function sync<A>(thunk: () => A): Effect<A>;",
+        "export declare function tryPromise<A>(options: { try: () => Promise<A>; catch: (error: unknown) => unknown }): Effect<A>;",
+      ].join("\n"),
+      "node_modules/@effect/platform-node/package.json": '{ "name": "@effect/platform-node", "types": "./index.d.ts" }',
+      "node_modules/@effect/platform-node/index.d.ts": 'export * as NodeRuntime from "./NodeRuntime";',
+      "node_modules/@effect/platform-node/NodeRuntime.d.ts": [
+        'import type { Effect } from "effect/Effect";',
+        "export declare function runMain(value: Effect<void>, options?: { disableErrorReporting?: boolean }): void;",
+      ].join("\n"),
+      "a.ts": source,
+    };
+  }
+
+  function expectedLocations(stdout: string, name: string) {
+    return stdout.split("\n").filter(line => line.endsWith(`[Error/bun(${name})]`))
+      .map(line => line.match(/:(\d+:\d+):/)?.[1]).sort();
