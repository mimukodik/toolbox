+      "  try: async () => NodeRuntime.runMain(program),",
+      "  catch: () => NodeRuntime.runMain(program),",
+      "});",
+      "export const local = Effect.sync(() => ({ runMain: () => {} }).runMain());",
+    ].join("\n");
+    const { stdout, exitCode } = await lint(project(source, { runEffectInsideEffect: "error" }), ["a.ts"]);
+    expect(expectedLocations(stdout, "run-effect-inside-effect")).toEqual([
+      "12:40", "14:20", "7:18", "8:39", "9:3",
+    ].sort());
+    expect(exitCode).toBe(1);
+  });
+
+  test.concurrent("skips an empty file", async () => {
+    const { stdout, exitCode } = await lint(project("", { effectInVoidSuccess: "error", runEffectInsideEffect: "error" }), ["a.ts"]);
+    expect(expectedLocations(stdout, "effect-in-void-success")).toEqual([]);
+    expect(expectedLocations(stdout, "run-effect-inside-effect")).toEqual([]);
+    expect(exitCode).toBe(0);
