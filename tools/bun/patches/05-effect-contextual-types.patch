+// ets_typeparser/src/effect_context.rs:262–297, 315–339, 379–390.
+pub(super) fn in_constructor_thunk(node: TsNode<'_>, modules: &dyn Modules) -> bool {
+    let mut child = node;
+    for parent in node.ancestors() {
+        if matches!(
+            parent.kind(),
+            Kind::ArrowFunction | Kind::FunctionExpression
+        ) && function_syntax(parent).is_some_and(|function| match function.body() {
+            FnBody::Block(_) => child.kind() == Kind::Block,
+            FnBody::Expr(body) => child == body.ts_node_with_parentheses(),
+            FnBody::None => false,
+        }) && is_constructor_thunk(parent, modules)
+        {
+            return true;
+        }
+        child = parent;
+    }
+    false
+}
+
+fn outside_thunk_wrappers(mut node: TsNode<'_>) -> TsNode<'_> {
+    while let Some(parent) = node.parent() {
+        if !matches!(
+            parent.kind(),
+            Kind::ParenthesizedExpression
+                | Kind::SatisfiesExpression
+                | Kind::AsExpression
+                | Kind::NonNullExpression
+                | Kind::TypeAssertionExpression
+        ) || parent.expression() != Some(node)
+        {
+            break;
+        }
+        node = parent;
+    }
+    node
+}
+
+fn is_constructor_thunk(function: TsNode<'_>, modules: &dyn Modules) -> bool {
+    const TRY: &[&[u8]] = &[b"try", b"tryPromise"];
+    const THUNK: &[&[u8]] = &[b"sync", b"promise", b"callback", b"suspend"];
+
+    let mut arg = outside_thunk_wrappers(function);
