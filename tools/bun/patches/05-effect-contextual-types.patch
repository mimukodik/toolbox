diff --git a/src/lint/plugins/effect/rules/bun_effect_in_void_success.rs b/src/lint/plugins/effect/rules/bun_effect_in_void_success.rs
new file mode 100644
index 0000000..f1e16ed
--- /dev/null
+++ b/src/lint/plugins/effect/rules/bun_effect_in_void_success.rs
@@ -0,0 +1,83 @@
+use crate::effect::{
+    expected_and_real_type::{self, ExpectedTypes},
+    report, type_parser,
+};
+use bun_lint::prelude::*;
+use bun_lint::types::{Type, TypeFlags};
+
+const MESSAGE: &Message = &Message::new(
+    "effectInVoidSuccess",
+    "There is a nested '{{type}}' in the 'void' success channel, beware that this could lead to nested Effect<Effect<...>> that won't be executed.",
+);
+
+fn has_expected_void_success<'a>(
+    expected: ExpectedTypes<'a>,
+    real: Type<'a>,
+    ignored_returns: TypeFlags,
+) -> bool {
+    match expected {
+        ExpectedTypes::Single(ty) => {
+            ty != real
+                && type_parser::effect(ty).is_some_and(|effect| effect.output.has_flags(TypeFlags::VOID))
+        }
+        ExpectedTypes::OverloadReturns(returns) => {
+            // In the union's success channel, never contributes no members.
+            // An all-nullish return list in loose mode cannot have Effect success.
+            let mut distinct = false;
+            let mut has_void = false;
+            for ty in returns.into_iter().filter(|ty| !ty.has_flags(ignored_returns)) {
+                let Some(effect) = type_parser::effect(ty) else {
+                    return false;
+                };
+                if !effect.output.has_flags(TypeFlags::VOID | TypeFlags::NEVER) {
+                    return false;
+                }
+                distinct |= ty != real;
+                has_void |= effect.output.has_flags(TypeFlags::VOID);
+            }
+            distinct && has_void
+        }
+    }
+}
+
+effect_rule!(
+    EffectInVoidSuccess,
+    b"effectInVoidSuccess",
+    "effect-in-void-success",
+    On::new().finish(),
+    fn finish(&self, cx: &mut Cx<'_, Self>) {
+        let file = cx.file();
+        let checker = file.type_checker();
+        let ignored_returns = if checker.compiler_options().strict_null_checks {
+            TypeFlags::NEVER
+        } else {
+            TypeFlags::NEVER | TypeFlags::NULL | TypeFlags::UNDEFINED
+        };
+        let root = checker.ts_node(file);
+        expected_and_real_type::visit(root, |pair| {
+            // ets_rules/src/effect_in_void_success.rs:31–75. Resolve the real Effect first.
+            let Some(real) = type_parser::type_at(pair.real) else {
+                return;
+            };
+            let Some(effect) = type_parser::effect(real) else {
+                return;
+            };
+            let Some(expected) = pair.expected.resolve() else {
+                return;
+            };
+            if !has_expected_void_success(expected, real, ignored_returns) {
+                return;
+            }
+            let Some(nested) = type_parser::union_members(effect.output)
+                .into_iter()
+                .find(|&ty| type_parser::strict_effect(ty).is_some())
+            else {
+                return;
+            };
+            let span = type_parser::diagnostic_span(file, pair.location);
+            if let Some(report) = report(cx, self.hidden_by_default, span, MESSAGE) {
+                report.data("type", nested.to_text());
+            }
+        });
+    }
+);
diff --git a/src/lint/plugins/effect/rules/bun_run_effect_inside_effect.rs b/src/lint/plugins/effect/rules/bun_run_effect_inside_effect.rs
