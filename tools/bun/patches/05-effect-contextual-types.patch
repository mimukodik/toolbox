+// Adapted from Effect's MIT-licensed ets_typeparser at 0e722d359c969bdf1b1316f08e8637022cde3cce.
+use super::generator_context::{call_syntax, containing_function, function_syntax};
+use bun_lint::ast::{FnBody, Node};
+use bun_lint::types::{SyntaxKind as Kind, TsNode, TsSymbol, Type};
+use std::collections::VecDeque;
+
+pub(super) struct Pair<'a> {
+    pub(super) location: TsNode<'a>,
+    pub(super) real: TsNode<'a>,
+    pub(super) expected: Expected<'a>,
+}
+
+pub(super) enum Expected<'a> {
+    At(TsNode<'a>),
+    Annotation(TsNode<'a>),
+    Symbol(TsSymbol<'a>, TsNode<'a>),
+    Contextual(TsNode<'a>),
+    Return(TsNode<'a>),
+}
+
+pub(super) enum ExpectedTypes<'a> {
+    Single(Type<'a>),
+    OverloadReturns(Vec<Type<'a>>),
+}
+
+impl<'a> Expected<'a> {
+    pub(super) fn resolve(self) -> Option<ExpectedTypes<'a>> {
+        let ty = match self {
+            Self::At(node) => node.get_type_at_location(),
+            Self::Annotation(node) => node.get_type_from_type_node(),
+            Self::Symbol(symbol, site) => symbol.get_type_at_location(site),
+            Self::Contextual(node) => node.get_contextual_type()?,
+            Self::Return(declaration) => return return_types(declaration),
+        };
+        Some(ExpectedTypes::Single(ty))
+    }
+}
+
+// ets_typeparser/src/expected_and_real_type.rs:52–92.
+fn return_types(declaration: TsNode<'_>) -> Option<ExpectedTypes<'_>> {
+    if !function_syntax(declaration)?.has_body() {
+        return None;
+    }
+    let signatures = declaration.get_type_at_location().get_call_signatures();
+    if signatures.len() > 1 {
+        // The consumer can interpret the returns without constructing a checker union.
+        let returns = signatures
+            .into_iter()
+            .map(|signature| signature.get_return_type())
+            .collect();
+        return Some(ExpectedTypes::OverloadReturns(returns));
+    }
+    let signature = declaration.get_signature_from_declaration()?;
+    let ty = signature
+        .get_type_predicate()
+        .and_then(|predicate| predicate.ty())
+        .unwrap_or_else(|| signature.get_return_type());
+    Some(ExpectedTypes::Single(ty))
+}
+
+// ets_typeparser/src/expected_and_real_type.rs:124–318.
+pub(super) fn visit<'a>(root: TsNode<'a>, mut visit_pair: impl FnMut(Pair<'a>)) {
+    let mut pending = VecDeque::from([root]);
+    while let Some(node) = pending.pop_front() {
+        let mut pair = |location, real, expected| {
+            visit_pair(Pair {
+                location,
+                real,
+                expected,
+            })
+        };
+        match node.kind() {
+            Kind::VariableDeclaration => {
+                if let (Some(name), Some(value)) = (node.name(), node.initializer()) {
+                    pair(name, value, Expected::At(name));
+                    pending.push_back(value);
+                    continue;
+                }
+            }
+            Kind::CallExpression => {
+                if let Some(call) = call_syntax(node)
+                    && !call.args().is_empty()
+                    && let Some(signature) = node.get_resolved_signature()
+                {
+                    for (arg, param) in call.args().iter().zip(signature.parameters()) {
+                        let arg = arg.ts_node_with_parentheses();
+                        pair(arg, arg, Expected::Symbol(param, node));
+                    }
+                }
+            }
+            Kind::Identifier | Kind::StringLiteral => {
+                if let Some(property) = node.parent()
+                    && matches!(
+                        property.kind(),
+                        Kind::PropertyAssignment | Kind::ShorthandPropertyAssignment
+                    )
+                    && property.name() == Some(node)
+                    && let Some(object) = property.parent()
+                    && object.kind() == Kind::ObjectLiteralExpression
+                {
+                    let name = if node.kind() == Kind::Identifier {
+                        node.get_source_text()
+                    } else {
+                        node.text()
+                    };
+                    if !name.is_empty()
+                        && let Some(symbol) = object
+                            .get_contextual_type()
+                            .and_then(|ty| ty.get_property(name))
+                    {
+                        pair(node, node, Expected::Symbol(symbol, node));
+                    }
+                }
+            }
+            Kind::BinaryExpression => {
+                if let Some(Node::Expr(expr)) = node.to_ast()
+                    && let Some((None, left, right)) = expr.as_assign()
+                {
+                    let left = left.ts_node_with_parentheses();
+                    let right = right.ts_node_with_parentheses();
+                    pair(left, right, Expected::At(left));
+                    pending.push_back(right);
+                    continue;
+                }
+            }
+            Kind::ReturnStatement => {
+                if let Some(value) = node.expression()
+                    && let Some(function) = containing_function(node)
+                {
+                    pair(node, value, Expected::Return(function));
+                }
+            }
+            Kind::ArrowFunction => {
+                if let Some(function) = function_syntax(node)
+                    && let FnBody::Expr(body) = function.body()
+                {
+                    let body = body.ts_node_with_parentheses();
+                    let expected = if function.type_params().is_empty() {
+                        Expected::Contextual(body)
+                    } else {
+                        Expected::Return(node)
+                    };
+                    pair(body, body, expected);
+                    pending.extend(body.children());
+                    continue;
+                }
+            }
+            Kind::SatisfiesExpression => {
+                if let (Some(value), Some(annotation)) = (node.expression(), node.type_node()) {
+                    pair(value, value, Expected::Annotation(annotation));
+                    pending.push_back(value);
+                    continue;
+                }
+            }
+            _ => {}
+        }
+        pending.extend(node.children());
+    }
+}
+
