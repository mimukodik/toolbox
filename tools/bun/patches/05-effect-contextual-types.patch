+---
+title: "bun/effect-in-void-success"
+description: "Report nested Effects in a void success channel"
+# Generated by src/codegen/lint-rule-docs.ts. Do not edit below this line.
+plugin: "bun"
+aliases: []
+kind: "problem"
+category: null
+default: "off"
+fixable: "no"
+typeAware: true
+deprecated: false
+---
+
+When an Effect is used where the expected success type is `void`, an Effect in its actual success channel can be discarded before it runs. Flatten the nested Effect or return it directly.
+
+{/* Generated by src/codegen/lint-rule-docs.ts. Do not edit this section. */}
+
+## Configure
+
+Off by default. This rule needs types, so turning it on makes `bun lint` type check your code first.
+
+```toml bunfig.toml
+[lint.rules]
+"bun/effect-in-void-success" = "error" # or "warn"
+```
+
+{/* End of the generated section. */}
+
+## Examples
+
+{/* file "node_modules/effect/index.d.ts" */}
+
+```ts
+export * as Effect from "./Effect";
+```
+
+{/* file "node_modules/effect/Effect.d.ts" */}
+
+```ts
+export interface Effect<A, E = never, R = never> {
+  readonly "~effect/Effect": { _A: () => A; _E: () => E; _R: () => R };
+  [Symbol.iterator](): Generator<Effect<A, E, R>, A, unknown>;
+}
+export declare function gen<A>(body: () => Generator<unknown, A, unknown>): Effect<A>;
+export declare function succeed<A>(value: A): Effect<A>;
+export declare function runSync<A>(value: Effect<A>): A;
+```
