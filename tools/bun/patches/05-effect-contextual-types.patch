+// Adapted from Effect's MIT-licensed ets_typeparser at 0e722d359c969bdf1b1316f08e8637022cde3cce.
+use super::type_parser::package_export_name;
+use bun_lint::modules::Modules;
+use bun_lint::types::TsNode;
+
+const PACKAGES: &[&[u8]] = &[
+    b"@effect/platform-node",
+    b"@effect/platform-bun",
+    b"@effect/platform-browser",
+];
