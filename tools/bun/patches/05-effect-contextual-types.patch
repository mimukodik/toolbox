+    };
+    let via_try_property = call.kind() == Kind::PropertyAssignment;
+    if via_try_property {
+        if call.initializer() != Some(arg) || call.name().is_none_or(|name| name.text() != b"try") {
+            return false;
+        }
+        let Some(object) = call
+            .parent()
+            .filter(|node| node.kind() == Kind::ObjectLiteralExpression)
+        else {
+            return false;
+        };
+        arg = outside_thunk_wrappers(object);
+        let Some(parent) = arg.parent() else {
+            return false;
+        };
+        call = parent;
+    }
+    let Some(first) = call_syntax(call).and_then(|call| call.args().iter().next()) else {
+        return false;
+    };
+    if first.ts_node_with_parentheses() != arg {
+        return false;
+    }
+    call.expression().is_some_and(|callee| {
+        is_node_reference_to_effect_module_api(callee, TRY, modules)
+            || !via_try_property && is_node_reference_to_effect_module_api(callee, THUNK, modules)
+    })
+}
