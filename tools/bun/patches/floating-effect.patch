diff --git a/src/lint/plugins/rules/bun_floating_effect.rs b/src/lint/plugins/rules/bun_floating_effect.rs
new file mode 100644
index 0000000000..b0aff93776
--- /dev/null
+++ b/src/lint/plugins/rules/bun_floating_effect.rs
@@ -0,0 +1,70 @@
+// Adapted from Effect-TS/tsgo's floatingEffect and Effect v4 type parser (MIT).
+use bun_lint::prelude::*;
+use bun_lint::rule::Plugin;
+use bun_lint::types::Type;
+
+pub struct FloatingEffect;
+
+const EFFECT_TYPE_ID: &[u8] = b"~effect/Effect";
+const STREAM_TYPE_ID: &[u8] = b"~effect/Stream";
+
+const FLOATING: &Message = &Message::new(
+    "floatingEffect",
+    "This Effect value is neither yielded nor used in an assignment.",
+);
+const FLOATING_EFFECT_ABLE: &Message = &Message::new(
+    "floatingEffectAble",
+    "This Effect-able '{{type}}' value is neither yielded nor assigned to a variable.",
+);
+
+fn has_variance(ty: Type<'_>, key: &[u8]) -> bool {
+    let Some(variance) = ty.get_type_of_property(key) else {
+        return false;
+    };
+    [b"_A", b"_E", b"_R"].iter().all(|name| {
+        variance.get_type_of_property(&name[..]).is_some_and(|parameter| {
+            let signatures = parameter.get_call_signatures();
+            signatures.len() == 1
+                && signatures.first().is_some_and(|sig| sig.type_parameters().is_empty())
+        })
+    })
+}
+
+impl Rule for FloatingEffect {
+    const META: Meta = Meta::plugin(Plugin::Bun, "floating-effect", Kind::Problem).requires_types();
+    const ON: On = On::new().stmts(&[StmtTag::Expr]);
+    no_state!();
+
+    fn new(_: &Options) -> Self {
+        Self
+    }
+
+    fn stmt<'a>(&self, stmt: Stmt<'a>, cx: &mut Cx<'a, Self>) {
+        let StmtKind::Expr(expression) = stmt.kind() else {
+            return;
+        };
+        if matches!(
+            expression.assign_op(),
+            Some(None | Some(BinOp::And | BinOp::Or | BinOp::Nullish))
+        ) {
+            return;
+        }
+
+        let ty = expression.ty();
+        if ty.get_property(EFFECT_TYPE_ID).is_some() {
+            let is_fiber = ty.get_property(b"await").is_some() && ty.get_property(b"poll").is_some();
+            let is_subtype = ty.get_property(b"_tag").is_some() || ty.get_property(b"get").is_some();
+            if is_fiber || is_subtype || !has_variance(ty, EFFECT_TYPE_ID) {
+                return;
+            }
+        } else if !has_variance(ty, STREAM_TYPE_ID) {
+            return;
+        }
+
+        if ty.symbol().is_some_and(|symbol| symbol.name() == b"Effect") {
+            cx.report(expression, FLOATING);
+        } else {
+            cx.report(expression, FLOATING_EFFECT_ABLE).data("type", ty.to_text());
+        }
+    }
+}
