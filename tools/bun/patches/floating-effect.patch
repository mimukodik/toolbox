+    })?;
+    match plugin.get(b"diagnosticSeverity")?.get(b"floatingEffect")?.as_str()? {
+        b"error" => Some(Severity::Error),
+        b"warning" => Some(Severity::Warn),
+        b"off" => Some(Severity::Off),
+        _ => None,
+    }
+}
