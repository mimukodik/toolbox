+describe("Effect v4 floating statements", () => {
+  const floating = [
+    'interface Variance { _A: () => number; _E: () => never; _R: () => never; }',
+    'interface Effect { readonly "~effect/Effect": Variance; }',
+    'declare function make(): Effect;',
+    'make();',
+  ].join("\n");
+
+  function project(severity: string) {
+    return {
+      ".oxlintrc.json": JSON.stringify({ options: { typeAware: true }, categories: { correctness: "off" } }),
+      "tsconfig.json": '{ "extends": "./base.json", }',
+      "base.json": `{
+        // Keep the Effect configuration in an extended JSONC file.
+        "compilerOptions": {
+          "lib": ["es2022"],
+          "types": [],
+          "strict": true,
+          "plugins": [{ "name": "@effect/language-service", "diagnosticSeverity": { "floatingEffect": "${severity}" } }],
+        },
+      }`,
+      "src/a.ts": [
+        'interface Variance { _A: () => number; _E: () => never; _R: () => never; }',
+        'interface Effect { readonly "~effect/Effect": Variance; }',
+        'interface Stream { readonly "~effect/Stream": Variance; }',
+        'declare function make(): Effect;',
+        'declare function stream(): Stream;',
+        'declare function fiber(): Effect & { await: unknown; poll: unknown };',
+        'declare function exit(): Effect & { _tag: "Success" };',
+        'declare function pool(): Effect & { get: unknown };',
+        'declare function ordinary(): number;',
+        'declare function impostor(): { "~effect/Effect": { _A: number } };',
+        'make();',
+        'stream();',
+        'export let kept = make();',
+        'kept = make();',
+        'export function returned() { return make(); }',
+        'for (make(); false;) {}',
+        'fiber();',
+        'exit();',
+        'pool();',
+        'ordinary();',
+        'impostor();',
+      ].join("\n"),
+    };
+  }
+
+  test.concurrent("recognizes Effect and Stream for explicit files, directories and glob matches", async () => {
+    for (const target of ["src/a.ts", "src", "src/**/*.ts"]) {
+      const { errors, exitCode } = await lint(project("error"), [target]);
+      expect(errors).toEqual([
+        "11:1 This Effect value is neither yielded nor used in an assignment.",
+        "12:1 This Effect-able `Stream` value is neither yielded nor assigned to a variable.",
+      ]);
+      expect(exitCode).toBe(1);
+    }
+  });
+
+  test.concurrent("uses project severity and respects off", async () => {
+    const warned = await lint(project("warning"), ["src"]);
+    expect(warned.stdout).toContain("[Warning/bun(floating-effect)]");
+    expect(warned.exitCode).toBe(0);
+    const disabled = await lint(project("off"), ["src"]);
+    expect(disabled.stdout).not.toContain("bun(floating-effect)");
+    expect(disabled.exitCode).toBe(0);
+  });
+
+  test.concurrent("applies Effect directives at the report location", async () => {
+    const declaration = floating.split("\n").slice(0, 3).join("\n") + " export {};";
+    const files = {
+      ...project("off"),
+      "src/a.ts": [
+        declaration,
+        'make();',
+        '// @effect-diagnostics-next-line FLOATINGEFFECT:warning',
+        'make();',
+        'make();',
+        '// @effect-diagnostics *:error',
+        'make() satisfies Effect;',
+        '// @effect-diagnostics-in-tsgo false',
+        'make();',
+        '// @effect-diagnostics-next-line floatingEffect:message',
+        'make();',
+        '// @effect-diagnostics floatingEffect:suggestion',
+        'make();',
+      ].join("\n"),
+      "src/skip.ts": [
+        declaration,
+        'make();',
+        '// @effect-diagnostics *:skip-file',
+        '// @effect-diagnostics-next-line floatingEffect:error',
+        'make();',
+      ].join("\n"),
+    };
+    const { errors, stdout, exitCode } = await lint(files, ["src"]);
+    const message = "This Effect value is neither yielded nor used in an assignment.";
+    expect(errors).toEqual([`9:8 ${message}`, `11:1 ${message}`]);
+    expect(stdout).toMatch(/a\.ts:6:1: .*\[Warning\/bun\(floating-effect\)\]/);
+    expect(stdout.match(/bun\(floating-effect\)/g)).toHaveLength(3);
+    expect(exitCode).toBe(1);
+  });
+
+  test.concurrent("reads the plugin from the referenced project for a directory or file", async () => {
+    const files = {
+      ".oxlintrc.json": JSON.stringify({ options: { typeAware: true }, categories: { correctness: "off" } }),
+      "tsconfig.json": JSON.stringify({ files: [], references: [{ path: "./tsconfig.app.json" }] }),
+      "tsconfig.app.json": JSON.stringify({
+        compilerOptions: {
+          ...options,
+          composite: true,
+          plugins: [{ name: "@effect/language-service", diagnosticSeverity: { floatingEffect: "error" } }],
+        },
+        include: ["src"],
+      }),
+      "src/a.ts": floating,
+    };
+    for (const target of ["src", "src/a.ts"]) {
+      const { errors, stdout, exitCode } = await lint(files, [target]);
+      expect(stdout).toContain("[Error/bun(floating-effect)]");
+      expect(errors).toEqual(["4:1 This Effect value is neither yielded nor used in an assignment."]);
+      expect(exitCode).toBe(1);
+    }
+  });
+});
