diff --git a/src/jsc/TestInputRecorder.rs b/src/jsc/TestInputRecorder.rs
new file mode 100644
index 000000000..8f5ee5004
--- /dev/null
+++ b/src/jsc/TestInputRecorder.rs
@@ -0,0 +1,1433 @@
+//! `BUN_TEST_INPUT_RECORD_DIR=<dir>` with `bun test --isolate`: for every test file, write
+//! `<dir>/<path relative to the record root, URI-component-encoded>.json` with what the file
+//! depended on: every resolution made while it was the current file (question and answer), every
+//! module it loaded with a hash of the bytes this process transpiled for it, the files that answered
+//! a resolution but were never loaded, what it did that a record can't replay, and its outcome counts.
+//!
+//! Paths under the record root (the repository, see [`record_root`]) are written relative to it, so a
+//! record holds in another checkout, and a test file is named by its path from there;
+//! a question's specifier, importer and `paths` say so with `specifierFromRoot`, `importerFromRoot`
+//! and `pathsFromRoot`. Each resolution carries `check`, a hash of its answer as written: asking the
+//! resolver the same question again gives the same `check` when the answer and its details are the same.
+//!
+//! Files run one at a time on the VM's thread, so the current file is state of the VM, set by
+//! [`will_run_file`] and cleared when the returned [`FileRecording`] ends. Work of a finished
+//! file that still resolves, loads or marks afterwards is counted as `unattributedBefore` in the next
+//! record. An async transpile carries the number of the file that started it, so one that completes
+//! while a later file is current is counted in that file's `lateFromEarlierFiles` instead of
+//! listed as its module. Worker VMs have no recorder.
+
+use core::cell::{OnceCell, RefCell};
+use core::ffi::{CStr, c_char};
+use std::io::Write as _;
+
+use bun_ast::Loader;
+use bun_collections::StringHashMap;
+use bun_core::String as BunString;
+use bun_resolver::Result as ResolverResult;
+
+use crate::test_input_store::{self as store, Entry, Segment};
+pub use crate::test_own_reads::Wrote;
+pub use crate::test_own_reads::Root;
+use crate::test_own_reads::{Look, OwnReads};
+use crate::virtual_machine::{ResolveMode, VirtualMachine};
+use crate::{JSGlobalObject, JSValue};
+
+/// The record format. 3 adds `reads`: a record without them did not record its own reads, so it
+/// must not be taken for one that read nothing.
+pub const RECORD_VERSION: u32 = 3;
+
+pub struct TestInputRecorder {
+    dir: Box<[u8]>,
+    /// What paths in records are relative to: see [`record_root`].
+    root: Root,
+    /// What the run was started with, one `name=value` per line; see `InputReuse::fingerprint`.
+    fingerprint: Box<[u8]>,
+    fingerprint_hash: [u8; 32],
+    state: RefCell<State>,
+    /// Opened at the first record; `Some(None)` when it could not be.
+    segment: RefCell<Option<Option<Segment>>>,
+}
+
+#[derive(Default)]
+struct State {
+    /// By module key (absolute path). What the isolation source cache serves for a key was
+    /// transpiled from one of the sources this process read for it, so the hash is unambiguous
+    /// unless two reads differed.
+    sources: StringHashMap<Source>,
+    file: Option<FileState>,
+    /// Resolutions under way, innermost last: an `onResolve` callback can resolve again.
+    open: Vec<Option<Found>>,
+    unattributed: u32,
+    /// Counts the files started; the current file's number while `file` is set.
+    file_number: u32,
+}
+
+struct Source {
+    sha256: [u8; 32],
+    loader: Loader,
+    is_virtual: bool,
+    changed_during_run: bool,
+}
+
+#[derive(Default)]
+struct FileState {
+    /// As a JSON record writes them, and as the store keeps them.
+    resolutions: Vec<(Box<[u8]>, Entry)>,
+    seen_resolutions: StringHashMap<()>,
+    modules: Vec<(Box<[u8]>, bool)>,
+    module_index: StringHashMap<usize>,
+    /// Absolute paths that answered a resolution.
+    answers: Vec<Box<[u8]>>,
+    seen_answers: StringHashMap<()>,
+    /// What the file did that a record can't replay, by name.
+    marks: Vec<Box<[u8]>>,
+    unattributed_before: u32,
+    /// Async transpiles started by an earlier file that completed while this file was current.
+    late_from_earlier_files: u32,
+    /// What the file's own code looked at on the file system.
+    own: OwnReads,
+    /// Modules and questions left out because the file's own code wrote them (see [`FileState::add_resolution`]).
+    generated: u32,
+    /// Writes whose call returned a promise that had not settled yet: their effects apply once it
+    /// is fulfilled (see [`FileState::settle`]).
+    pending: Vec<(crate::Strong, OwnWrites)>,
+    /// How many of the file's [`OwnWrites`] are alive: calls made but not completed yet, such as
+    /// an async `node:fs` call or a pending `Bun.write`. A call that completes after its file
+    /// counts down its own file's count, never the next one's.
+    in_flight: std::sync::Arc<core::sync::atomic::AtomicU32>,
+}
+
+/// What the resolver's result says about the module, beyond its path.
+struct Found {
+    path: Box<[u8]>,
+    json: Box<[u8]>,
+}
+
+/// `fingerprint` describes the run; records of another fingerprint are not reused.
+pub fn enable(vm: &VirtualMachine, fingerprint: &[u8]) {
+    let Some(dir) = bun_core::env_var::BUN_TEST_INPUT_RECORD_DIR.get_not_empty() else {
+        return;
+    };
+    let dir = bun_paths::Path::resolve(&[vm.top_level_dir(), dir]);
+    let recorder = TestInputRecorder {
+        dir: Box::from(dir.as_bytes()),
+        root: record_root(vm),
+        fingerprint: Box::from(fingerprint),
+        fingerprint_hash: source_hash(fingerprint),
+        state: RefCell::default(),
+        segment: RefCell::default(),
+    };
+    let _ = vm
+        .test_isolation_state
+        .input_recorder
+        .set(Box::new(recorder));
+    Bun__TestInputRecorder__enabled.store(true, core::sync::atomic::Ordering::Relaxed);
+}
+
+/// What paths in records are relative to, so that a record holds in another checkout: the unit that
+/// moves is the repository, not the package. `BUN_TEST_INPUT_RECORD_ROOT` (resolved against the
+/// project directory), else the nearest directory at or above the project directory that has a
+/// lockfile or `pnpm-workspace.yaml`, which is where the install put `node_modules`, else the
+/// project directory. The root itself is in no record, hash or fingerprint.
+pub fn record_root(vm: &VirtualMachine) -> Root {
+    let top = vm.top_level_dir();
+    if let Some(given) = bun_core::env_var::BUN_TEST_INPUT_RECORD_ROOT.get_not_empty() {
+        return Root::new(bun_paths::Path::resolve(&[top, given]).as_bytes());
+    }
+    Root::new(install_root(top).unwrap_or(top))
+}
+
+/// Whether the record root is the project directory or above it, either as given or with its
+/// symbolic links resolved. Always so unless `BUN_TEST_INPUT_RECORD_ROOT` says otherwise.
+pub fn root_holds_project(vm: &VirtualMachine) -> bool {
+    let root = record_root(vm);
+    let top = Root::new(vm.top_level_dir());
+    [&*top.given, &*top.real]
+        .into_iter()
+        .any(|top| root.relative(top).is_some())
+}
+
+fn install_root(top: &[u8]) -> Option<&[u8]> {
+    const MARKS: [&[u8]; 6] = [
+        b"bun.lock",
+        b"bun.lockb",
+        b"pnpm-lock.yaml",
+        b"pnpm-workspace.yaml",
+        b"yarn.lock",
+        b"package-lock.json",
+    ];
+    let mut dir = top.strip_suffix(&[bun_paths::SEP]).filter(|it| !it.is_empty()).unwrap_or(top);
+    loop {
+        for mark in MARKS {
+            let mut path = dir.to_vec();
+            if !path.last().is_some_and(|&c| bun_paths::is_sep(c)) {
+                path.push(bun_paths::SEP);
+            }
+            path.extend_from_slice(mark);
+            if bun_sys::exists(&path) {
+                return Some(dir);
+            }
+        }
+        dir = bun_paths::dirname(dir).filter(|it| *it != dir && !it.is_empty())?;
+    }
+}
+
+/// When recording, the number of the current file (0 between files): asked on the JS thread when an async
+/// transpile is scheduled, and handed back to [`did_hash_source`] when it completes.
+pub fn recording_token(vm: &VirtualMachine) -> Option<u32> {
+    let state = recorder_of(vm)?.state.borrow();
+    Some(if state.file.is_some() {
+        state.file_number
+    } else {
+        0
+    })
+}
+
+/// SHA-256 of the bytes given to the transpiler; safe on the transpiler pool's threads.
+pub fn source_hash(contents: &[u8]) -> [u8; 32] {
+    let mut sha256 = [0u8; 32];
+    bun_sha_hmac::sha::hashers::SHA256::hash(contents, &mut sha256);
+    sha256
+}
+
+pub fn write_hex(out: &mut Vec<u8>, bytes: &[u8]) {
+    for byte in bytes {
+        let _ = write!(out, "{byte:02x}");
+    }
+}
+
+fn recorder_of(vm: &VirtualMachine) -> Option<&TestInputRecorder> {
+    vm.test_isolation_state.input_recorder.get().map(|it| &**it)
+}
+
+pub type InputRecorderCell = OnceCell<Box<TestInputRecorder>>;
+
+pub struct PendingResolve<'a> {
+    recording: Option<(&'a TestInputRecorder, Question)>,
+}
+
+struct Question {
+    specifier: Box<[u8]>,
+    importer: Box<[u8]>,
+    importer_is_file: bool,
+    kind: &'static str,
+    paths: Vec<Box<[u8]>>,
+}
+
+/// At the start of `VirtualMachine::resolve_maybe_needs_trailing_slash`.
+pub fn will_resolve<'a>(
+    global: &'a JSGlobalObject,
+    specifier: &BunString,
+    source: &BunString,
+    mode: ResolveMode,
+    importer_is_file: bool,
+) -> PendingResolve<'a> {
+    let vm = global.bun_vm();
+    let Some(recorder) = recorder_of(vm) else {
+        return PendingResolve { recording: None };
+    };
+    let mut state = recorder.state.borrow_mut();
+    if state.file.is_none() {
+        state.unattributed += 1;
+        return PendingResolve { recording: None };
+    }
+    state.open.push(None);
+    let paths = vm
+        .transpiler
+        .get()
+        .resolver
+        .custom_dir_paths
+        .map(|paths| {
+            paths
+                .iter()
+                .map(|it| Box::from(it.to_utf8().slice()))
+                .collect()
+        })
+        .unwrap_or_default();
+    PendingResolve {
+        recording: Some((
+            recorder,
+            Question {
+                specifier: Box::from(specifier.to_utf8().slice()),
+                importer: Box::from(source.to_utf8().slice()),
+                importer_is_file,
+                kind: kind_of(mode),
+                paths,
+            },
+        )),
+    }
+}
+
+fn kind_of(mode: ResolveMode) -> &'static str {
+    match mode {
+        ResolveMode::Esm => "import",
+        ResolveMode::Require => "require",
+        ResolveMode::RequireResolve => "require-resolve",
+        ResolveMode::EsmResolve => "esm-resolve",
+    }
+}
+
+impl PendingResolve<'_> {
+    /// Passes `resolved` through.
+    pub fn did_resolve(
+        mut self,
+        resolved: Result<BunString, JSValue>,
+        by_plugin: bool,
+    ) -> Result<BunString, JSValue> {
+        let Some((recorder, question)) = self.recording.take() else {
+            return resolved;
+        };
+        let mut state = recorder.state.borrow_mut();
+        let found = state.open.pop().flatten();
+        let answer = resolved.as_ref().ok().map(|it| it.to_utf8());
+        let answer = answer.as_ref().map(|it| it.slice());
+        let found = found.filter(|found| answer == Some(&*found.path));
+        let line = recorder.resolution_line(&question, answer, by_plugin, found.as_ref());
+        if let Some(file) = state.file.as_mut() {
+            file.add_resolution(line, &question.importer, answer);
+        }
+        resolved
+    }
+}
+
+impl Drop for PendingResolve<'_> {
+    /// A resolution that ended without [`PendingResolve::did_resolve`] threw (a plugin's
+    /// `onResolve`, or a termination): its question has no answer to check, so the record is not
+    /// reusable. An import that finds nothing is an answer, not this.
+    fn drop(&mut self) {
+        if let Some((recorder, _)) = self.recording.take() {
+            let mut state = recorder.state.borrow_mut();
+            state.open.pop();
+            if let Some(file) = state.file.as_mut() {
+                file.mark(b"resolve-threw");
+            }
+        }
+    }
+}
+
+/// In `VirtualMachine::_resolve`, with the resolver's answer to the innermost resolution.
+pub fn did_find(vm: &VirtualMachine, result: &ResolverResult<'_>) {
+    let Some(recorder) = recorder_of(vm) else {
+        return;
+    };
+    let mut state = recorder.state.borrow_mut();
+    let Some(slot) = state.open.last_mut() else {
+        return;
+    };
+    *slot = recorder.found(result);
+}
+
+/// A resolution made by calling the resolver itself: a preload, or the test file named on the
+/// command line.
+pub fn did_resolve_directly(
+    vm: &VirtualMachine,
+    kind: &'static str,
+    specifier: &[u8],
+    dir: &[u8],
+    result: &ResolverResult<'_>,
+) {
+    let Some(recorder) = recorder_of(vm) else {
+        return;
+    };
+    let found = recorder.found(result);
+    let question = Question {
+        specifier: Box::from(specifier),
+        importer: Box::from(dir),
+        importer_is_file: false,
+        kind,
+        paths: Vec::new(),
+    };
+    let answer = found.as_ref().map(|found| &*found.path);
+    let line = recorder.resolution_line(&question, answer, false, found.as_ref());
+    let mut state = recorder.state.borrow_mut();
+    match state.file.as_mut() {
+        Some(file) => file.add_resolution(line, b"", answer),
+        None => state.unattributed += 1,
+    }
+}
+
+/// Where the transpiler has read a module's source: `contents` are the bytes it transpiles.
+pub fn did_read_source(
+    vm: &VirtualMachine,
+    path: &[u8],
+    loader: Loader,
+    contents: &[u8],
+    is_virtual: bool,
+) {
+    if let Some(token) = recording_token(vm) {
+        did_hash_source(vm, token, path, loader, source_hash(contents), is_virtual);
+    }
+}
+
+/// An async transpile hashed its source on the pool thread; this records it on the JS thread when the job completes.
+pub fn did_hash_source(
+    vm: &VirtualMachine,
+    token: u32,
+    path: &[u8],
+    loader: Loader,
+    sha256: [u8; 32],
+    is_virtual: bool,
+) {
+    let Some(recorder) = recorder_of(vm) else {
+        return;
+    };
+    let path = module_file(path);
+    let mut state = recorder.state.borrow_mut();
+    match state.sources.get_mut(path) {
+        Some(source) => {
+            source.changed_during_run |= source.sha256 != sha256;
+            source.sha256 = sha256;
+            source.loader = loader;
+            source.is_virtual = is_virtual;
+        }
+        None => {
+            let source = Source {
+                sha256,
+                loader,
+                is_virtual,
+                changed_during_run: false,
+            };
+            bun_core::handle_oom(state.sources.put(path, source));
+        }
+    }
+    if state.file.is_some() && token == state.file_number {
+        state.note_module(path, false);
+    } else if let Some(file) = state.file.as_mut() {
+        file.late_from_earlier_files += 1;
+    } else {
+        state.unattributed += 1;
+    }
+}
+
+/// Whether a VM of this process records: read by `IsolatedModuleCache::lookup`, so a cache hit
+/// calls into the recorder only then.
+#[unsafe(no_mangle)]
+pub static Bun__TestInputRecorder__enabled: core::sync::atomic::AtomicBool =
+    core::sync::atomic::AtomicBool::new(false);
+
+/// `IsolatedModuleCache::lookup` found a provider for `key`.
+#[unsafe(no_mangle)]
+pub extern "C" fn Bun__TestInputRecorder__didServeCachedSource(
+    vm: &VirtualMachine,
+    key: &BunString,
+) {
+    let Some(recorder) = recorder_of(vm) else {
+        return;
+    };
+    let key = key.to_utf8();
+    recorder.state.borrow_mut().note_module(module_file(key.slice()), true);
+}
+
+/// The file a module key loads: the key without its query. A specifier with a query (`?raw`, `?url`)
+/// is loaded from the file without it, and its key keeps the query; the original of a mocked module
+/// is loaded under the file's path with `?actual` (or `&actual`, then maybe `&spy`; see
+/// `withoutOriginalModuleQuery` in `BunPlugin.cpp`). Either way the source is the file's bytes, so it
+/// is the same input as the plain import; how the query changes the loader is in the question,
+/// whose specifier carries it. A file whose name has a `?` in it gets the hash of another path,
+/// which makes its record never hold: a rerun, not a miss.
+fn module_file(key: &[u8]) -> &[u8] {
+    match key.iter().position(|&c| c == b'?') {
+        Some(query) => &key[..query],
+        None => key,
+    }
+}
+
+/// The current file did something whose effect a record can't replay, such as spawning a process:
+/// its record names it and is not reused.
+pub fn mark(vm: &VirtualMachine, name: &[u8]) {
+    let Some(recorder) = recorder_of(vm) else {
+        return;
+    };
+    let mut state = recorder.state.borrow_mut();
+    match state.file.as_mut() {
+        Some(file) => file.mark(name),
+        None => state.unattributed += 1,
+    }
+}
+
+/// Whether this VM records, so a hook can skip work that only recording needs.
+pub fn is_recording(vm: &VirtualMachine) -> bool {
+    recorder_of(vm).is_some()
+}
+
+/// The current file's own code looks at `path` (absolute, or relative to the working directory now)
+/// the way `look` says. Called on the JS thread when the call is made, also for async calls, so the
+/// file that started the work is the one credited; a look while no file is current makes the next
+/// record not reusable.
+pub fn own_read(vm: &VirtualMachine, look: Look, path: &[u8]) {
+    own_read_with(vm, look, path, b"");
+}
+
+/// [`own_read`] with what else the look needs, such as a glob's pattern.
+pub fn own_read_with(vm: &VirtualMachine, look: Look, path: &[u8], extra: &[u8]) {
+    let Some(recorder) = recorder_of(vm) else {
+        return;
+    };
+    let path = joined_now(path);
+    let mut state = recorder.state.borrow_mut();
+    match state.file.as_mut() {
+        Some(file) => {
+            file.settle();
+            if !file.own.read(&recorder.root, look, &path, extra) {
+                file.mark(b"link-loop");
+            }
+        }
+        None => state.unattributed += 1,
+    }
+}
+
+/// What one call writes, for [`own_wrote`] to apply when it succeeded. Made when the call is made:
+/// paths are absolute then, and what the file looked at there is observed then.
+pub struct OwnWrites {
+    /// The number of the file that made the call; 0 between files.
+    file: u32,
+    effects: Vec<OwnEffect>,
+    /// The making file's count of calls in flight, counted down when this is dropped.
+    in_flight: Option<std::sync::Arc<core::sync::atomic::AtomicU32>>,
+}
+
+impl Drop for OwnWrites {
+    fn drop(&mut self) {
+        if let Some(count) = &self.in_flight {
+            count.fetch_sub(1, core::sync::atomic::Ordering::Relaxed);
+        }
+    }
+}
+
+// SAFETY: plain data, made and applied on the JS thread of the VM that records.
+unsafe impl crate::job::JsAffine for OwnWrites {}
+
+enum OwnEffect {
+    Wrote(Box<[u8]>, Wrote),
+    /// `fs.mkdtemp`: the directory it returns is new.
+    Created,
+}
+
+impl OwnWrites {
+    /// `None` when not recording.
+    pub fn new(vm: &VirtualMachine) -> Option<OwnWrites> {
+        let state = recorder_of(vm)?.state.borrow();
+        let in_flight = state.file.as_ref().map(|file| {
+            file.in_flight.fetch_add(1, core::sync::atomic::Ordering::Relaxed);
+            file.in_flight.clone()
+        });
+        Some(OwnWrites {
+            file: if in_flight.is_some() { state.file_number } else { 0 },
+            effects: Vec::new(),
+            in_flight,
+        })
+    }
+
+    /// The call is about to write `path` as `wrote` says: what the file looked at there is observed
+    /// now, and the write's effect waits for the call to succeed.
+    pub fn write(&mut self, vm: &VirtualMachine, path: &[u8], wrote: Wrote) {
+        let Some(recorder) = recorder_of(vm) else {
+            return;
+        };
+        let path = absolute_now(path);
+        if let Some(file) = recorder.state.borrow_mut().file.as_mut() {
+            file.own.before_write(&recorder.root, &path);
+        }
+        self.effects.push(OwnEffect::Wrote(path.into_boxed_slice(), wrote));
+    }
+
+    /// The call puts a tree at `path` (an archive extracted there): [`Self::write`] with
+    /// [`Wrote::Tree`], except into a directory that is there and is not the file's product, where
+    /// the tree merges with what was there, which stays an input ([`Wrote::Merge`]).
+    pub fn write_tree(&mut self, vm: &VirtualMachine, path: &[u8]) {
+        let merges = !own_generated(vm, path)
+            && bun_sys::stat(&bun_core::ZBox::from_vec(absolute_now(path))).is_ok_and(|st| {
+                st.st_mode as u32 & bun_sys::S::IFMT as u32 == bun_sys::S::IFDIR as u32
+            });
+        self.write(vm, path, if merges { Wrote::Merge } else { Wrote::Tree });
+    }
+
+    /// The call is `fs.mkdtemp`: the directory it returns is the file's product.
+    pub fn created(&mut self) {
+        self.effects.push(OwnEffect::Created);
+    }
+}
+
+/// The call that made `writes` succeeded, returning `returned` if it returns a path: its effects
+/// apply, if the file that made it is still the current one. A failed call, or one that completes
+/// after its file, leaves what it wrote an input of whatever reads it.
+pub fn own_wrote(vm: &VirtualMachine, writes: OwnWrites, returned: Option<&[u8]>) {
+    let Some(recorder) = recorder_of(vm) else {
+        return;
+    };
+    let mut state = recorder.state.borrow_mut();
+    if writes.file == 0 || writes.file != state.file_number {
+        return;
+    }
+    let Some(file) = state.file.as_mut() else {
+        return;
+    };
+    file.apply(writes, returned);
+}
+
+/// [`own_wrote`] for a call that returns `promise`: its effects apply once the promise is
+/// fulfilled. One that is rejected leaves what it wrote an input of whatever reads it. One still
+/// pending when the file ends marks the record `pending-write`, so it does not hold: what the write
+/// leaves is not known when the record is written. Whether it is fulfilled is asked when the file next looks at a path,
+/// so a look after an `await` of the call sees its effects.
+pub fn own_wrote_when_fulfilled(vm: &VirtualMachine, writes: OwnWrites, promise: JSValue) {
+    use crate::js_promise::Status;
+    let Some(recorder) = recorder_of(vm) else {
+        return;
+    };
+    let Some(any) = promise.as_any_promise() else {
+        return;
+    };
+    match any.status() {
+        Status::Fulfilled => own_wrote(vm, writes, None),
+        Status::Rejected => {}
+        Status::Pending => {
+            let mut state = recorder.state.borrow_mut();
+            if writes.file == 0 || writes.file != state.file_number {
+                return;
+            }
+            if let Some(file) = state.file.as_mut() {
+                file.pending.push((crate::Strong::create(promise, vm.global()), writes));
+            }
+        }
+    }
+}
+
+/// Whether what is at `path` now is the current file's own product.
+pub fn own_generated(vm: &VirtualMachine, path: &[u8]) -> bool {
+    let Some(recorder) = recorder_of(vm) else {
+        return false;
+    };
+    let path = absolute_now(path);
+    let mut state = recorder.state.borrow_mut();
+    state.file.as_mut().is_some_and(|file| {
+        file.settle();
+        file.own.generated(&path)
+    })
+}
+
+/// Looks at a path again the way a record says it was looked at, for validation.
+pub fn observe_again(vm: &VirtualMachine, look: Look, path: &[u8], extra: &[u8]) -> Box<[u8]> {
+    match recorder_of(vm) {
+        Some(recorder) => crate::test_own_reads::observe(&recorder.root, look, path, extra),
+        None => crate::test_own_reads::observe(&record_root(vm), look, path, extra),
+    }
+}
+
+/// `path` made absolute against the working directory as it is now, without `.` and `..`: a `..` is
+/// taken where the kernel's walk takes it, which after a symbolic link is not where folding the
+/// text puts it.
+fn absolute_now(path: &[u8]) -> Vec<u8> {
+    crate::test_own_reads::walked(&joined_now(path))
+}
+
+/// `path` made absolute against the working directory as it is now. Without `..` it is also
+/// without `.`; one with a `..` is kept for [`OwnReads::read`] to walk.
+fn joined_now(path: &[u8]) -> Vec<u8> {
+    let joined = if bun_paths::is_absolute(path) {
+        path.to_vec()
+    } else {
+        let mut buf = bun_paths::path_buffer_pool::get();
+        match bun_sys::getcwd_z(&mut *buf) {
+            Ok(cwd) => {
+                let mut out = cwd.as_bytes().to_vec();
+                if !out.last().is_some_and(|&c| bun_paths::is_sep(c)) {
+                    out.push(bun_paths::SEP);
+                }
+                out.extend_from_slice(path);
+                out
+            }
+            Err(_) => return path.to_vec(),
+        }
+    };
+    if crate::test_own_reads::has_dotdot(&joined) {
+        return joined;
+    }
+    bun_paths::Path::resolve(&[&joined[..]]).as_bytes().to_vec()
+}
+
+/// [`mark`] on the VM of this thread, for code that has none at hand.
+pub fn mark_current(name: &[u8]) {
+    if let Some(vm) = VirtualMachine::get_or_null() {
+        mark(vm, name);
+    }
+}
+
+/// [`mark`] from C++; `name` is a string literal.
+#[unsafe(no_mangle)]
+pub extern "C" fn Bun__TestInputRecorder__mark(vm: &VirtualMachine, name: *const c_char) {
+    // SAFETY: the callers pass a NUL-terminated literal.
+    mark(vm, unsafe { CStr::from_ptr(name) }.to_bytes());
+}
+
+impl State {
+    fn note_module(&mut self, path: &[u8], cached: bool) {
+        let Some(file) = self.file.as_mut() else {
+            self.unattributed += 1;
+            return;
+        };
+        if !bun_paths::is_absolute(path) {
+            // A module that is no file (a plugin's `namespace:path`, or anything else without a
+            // path) can't be hashed again, so the record is not reusable. Builtins load no source.
+            let builtin = path.starts_with(b"node:") || path.starts_with(b"bun:");
+            if !builtin {
+                file.mark(b"module-without-file");
+            }
+            return;
+        }
+        file.settle();
+        if !file.module_index.contains_key(path) && file.own.generated(path) {
+            file.generated += 1;
+            return;
+        }
+        match file.module_index.get(path) {
+            Some(&index) => file.modules[index].1 &= cached,
+            None => {
+                bun_core::handle_oom(file.module_index.put(path, file.modules.len()));
+                file.modules.push((Box::from(path), cached));
+            }
+        }
+    }
+}
+
+impl FileState {
+    fn mark(&mut self, name: &[u8]) {
+        if !self.marks.iter().any(|it| &**it == name) {
+            self.marks.push(Box::from(name));
+        }
+    }
+
+    fn apply(&mut self, mut writes: OwnWrites, returned: Option<&[u8]>) {
+        for effect in core::mem::take(&mut writes.effects) {
+            match effect {
+                OwnEffect::Wrote(path, wrote) => self.own.wrote(&path, wrote),
+                OwnEffect::Created => {
+                    if let Some(path) = returned {
+                        self.own.created(&absolute_now(path));
+                    }
+                }
+            }
+        }
+    }
+
+    /// Applies the effects of the pending writes whose promise is fulfilled by now, and forgets the
+    /// rejected ones.
+    fn settle(&mut self) {
+        use crate::js_promise::Status;
+        if self.pending.is_empty() {
+            return;
+        }
+        let mut i = 0;
+        while i < self.pending.len() {
+            let status = self.pending[i]
+                .0
+                .get()
+                .as_any_promise()
+                .map_or(Status::Rejected, |it| it.status());
+            match status {
+                Status::Pending => i += 1,
+                Status::Fulfilled => {
+                    let (_, writes) = self.pending.remove(i);
+                    self.apply(writes, None);
+                }
+                Status::Rejected => {
+                    self.pending.remove(i);
+                }
+            }
+        }
+    }
+
+    /// A question asked from a module the file's own code wrote, or answered by one, is left out:
+    /// that module is the product of the file's code and recorded inputs, and its path may never
+    /// exist again (a temporary directory), so the question can't be asked again. What such a
+    /// question reaches that the file did not write is still an answer file, hashed.
+    fn add_resolution(
+        &mut self,
+        line: (Box<[u8]>, Entry),
+        importer: &[u8],
+        answer: Option<&[u8]>,
+    ) {
+        self.settle();
+        let own = &self.own;
+        let generated = |path: &[u8]| bun_paths::is_absolute(path) && own.generated(path);
+        let answer_generated = answer.is_some_and(generated);
+        if generated(importer) || answer_generated {
+            self.generated += 1;
+            if let Some(answer) = answer.filter(|it| bun_paths::is_absolute(it) && !answer_generated)
+                && !self.seen_answers.contains_key(answer)
+            {
+                bun_core::handle_oom(self.seen_answers.put(answer, ()));
+                self.answers.push(Box::from(answer));
+            }
+            return;
+        }
+        if !self.seen_resolutions.contains_key(&*line.0) {
+            bun_core::handle_oom(self.seen_resolutions.put(&line.0, ()));
+            self.resolutions.push(line);
+        }
+        if let Some(answer) = answer.filter(|it| bun_paths::is_absolute(it))
+            && !self.seen_answers.contains_key(answer)
+        {
+            bun_core::handle_oom(self.seen_answers.put(answer, ()));
+            self.answers.push(Box::from(answer));
+        }
+    }
+}
+
+/// Counts of the reporter's summary, by name, at a point in the run.
+pub type Counts = [(&'static str, u32); 6];
+
+pub struct FileRecording<'a> {
+    vm: &'a VirtualMachine,
+    recording: Option<(&'a TestInputRecorder, Box<[u8]>, Counts)>,
+}
+
+/// At the start of `TestCommand::run`, before the test file is resolved.
+pub fn will_run_file<'a>(
+    vm: &'a VirtualMachine,
+    file_name: &[u8],
+    counts: Counts,
+) -> FileRecording<'a> {
+    let Some(recorder) = recorder_of(vm) else {
+        return FileRecording {
+            vm,
+            recording: None,
+        };
+    };
+    let mut state = recorder.state.borrow_mut();
+    let unattributed_before = core::mem::take(&mut state.unattributed);
+    state.file_number += 1;
+    state.file = Some(FileState {
+        unattributed_before,
+        ..Default::default()
+    });
+    FileRecording {
+        vm,
+        recording: Some((recorder, Box::from(file_name), counts)),
+    }
+}
+
+impl FileRecording<'_> {
+    /// After the file's last test and hook, with the counts as they are now.
+    pub fn did_run_file(mut self, file_path: &[u8], counts: Counts) {
+        if let Some((recorder, _, before)) = self.recording.take() {
+            recorder.write_record(self.vm, file_path, Some((&before, &counts)));
+        }
+    }
+}
+
+impl Drop for FileRecording<'_> {
+    /// `TestCommand::run` returned early with an error: the record says so and has no outcome.
+    fn drop(&mut self) {
+        if let Some((recorder, file_name, _)) = self.recording.take() {
+            recorder.write_record(self.vm, &file_name, None);
+        }
+    }
+}
+
+/// Where the record of the test file at `file_path` is; `None` when not recording.
+pub fn record_path(vm: &VirtualMachine, file_path: &[u8]) -> Option<Vec<u8>> {
+    Some(recorder_of(vm)?.record_path(file_path))
+}
+
+/// The record directory; `None` when not recording.
+pub fn record_dir(vm: &VirtualMachine) -> Option<&[u8]> {
+    Some(&recorder_of(vm)?.dir)
+}
+
+/// The fingerprint of this run; `None` when not recording.
+pub fn fingerprint_hash(vm: &VirtualMachine) -> Option<[u8; 32]> {
+    Some(recorder_of(vm)?.fingerprint_hash)
+}
+
+/// A path as records write it: relative to the root when under it.
+pub fn written_path(vm: &VirtualMachine, path: &[u8]) -> Option<Box<[u8]>> {
+    Some(recorder_of(vm)?.written(path).0)
+}
+
+/// Closes this process's segment of the store, so a merge in this process can take it.
+pub fn close_segment(vm: &VirtualMachine) {
+    if let Some(recorder) = recorder_of(vm) {
+        recorder.segment.borrow_mut().take();
+    }
+}
+
+/// The fingerprint of this run as records write it; `None` when not recording.
+pub fn fingerprint_hex(vm: &VirtualMachine) -> Option<Vec<u8>> {
+    let mut out = Vec::with_capacity(64);
+    write_hex(&mut out, &recorder_of(vm)?.fingerprint_hash);
+    Some(out)
+}
+
+/// The fingerprint text records carry; `None` when not recording.
+pub fn fingerprint_text(vm: &VirtualMachine) -> Option<&[u8]> {
+    Some(&recorder_of(vm)?.fingerprint)
+}
+
+/// A path as a record writes it, made absolute again: relative ones are under the record root.
+pub fn from_root(vm: &VirtualMachine, path: &[u8]) -> Vec<u8> {
+    let mut out = match recorder_of(vm) {
+        Some(recorder) => recorder.root.given.to_vec(),
+        None => record_root(vm).given.into_vec(),
+    };
+    match path {
+        b"." => {}
+        b"./" => out.push(bun_paths::SEP),
+        _ => {
+            if !out.last().is_some_and(|&c| bun_paths::is_sep(c)) {
+                out.push(bun_paths::SEP);
+            }
+            out.extend_from_slice(path);
+        }
+    }
+    out
+}
+
+/// What a package with the "aot" condition says about JSX, decorators and class fields of the
+/// TypeScript file at `path`, which both transpile paths put in place of the run's options
+/// (`ParseOptions::apply_aot_package_config`). The resolver's result does not carry it. `None`
+/// when no such package config applies, which is always so without the "aot" condition.
+pub fn aot_config_check(vm: &VirtualMachine, path: &[u8]) -> Option<[u8; 32]> {
+    let own = vm
+        .transpiler
+        .with_mut(|t| t.resolver.aot_package_config(path))?;
+    let jsx = own.merge_jsx(bun_bundler::options_impl::jsx::Pragma {
+        development: vm.transpiler.get().options.jsx.development,
+        ..Default::default()
+    });
+    let text = format!(
+        "{jsx:?}|{}|{}|{:?}",
+        own.emit_decorator_metadata, own.experimental_decorators, own.use_define_for_class_fields
+    );
+    Some(source_hash(text.as_bytes()))
+}
+
+/// A recorded question with its paths made absolute again.
+pub struct Asked<'a> {
+    pub kind: &'a [u8],
+    pub specifier: &'a [u8],
+    pub importer: &'a [u8],
+    pub importer_is_file: bool,
+    pub paths: &'a [Box<[u8]>],
+}
+
+/// Asks the resolver `asked` again, the way it was asked while recording but without plugins, and
+/// returns the `check` of the answer as a record would write it. `None` when it can't be asked again.
+/// Holds the API lock: a failed resolution makes an error object.
+pub fn check_again(vm: &VirtualMachine, asked: &Asked<'_>) -> Option<[u8; 32]> {
+    let recorder = recorder_of(vm)?;
+    let mut part = Vec::with_capacity(256);
+    match asked.kind {
+        b"entry" | b"preload" => {
+            let mut log = bun_ast::Log::default();
+            let prev_log = vm.transpiler.get().log;
+            vm.transpiler.with_mut(|t| t.set_log(&raw mut log));
+            scopeguard::defer! {
+                vm.transpiler.with_mut(|t| t.set_log(prev_log));
+            }
+            let found = if asked.kind == b"entry" {
+                let dot_slash = OnceCell::new();
+                match vm
+                    .transpiler
+                    .with_mut(|t| t.resolve_entry_point(asked.specifier, &dot_slash))
+                {
+                    Ok(result) => recorder.found(&result),
+                    Err(_) => None,
+                }
+            } else {
+                let global_cache = if vm.standalone_module_graph.is_none() {
+                    bun_resolver::GlobalCache::read_only
+                } else {
+                    bun_resolver::GlobalCache::disable
+                };
+                match vm.transpiler.with_mut(|t| {
+                    t.resolver.resolve_and_auto_install(
+                        asked.importer,
+                        asked.specifier,
+                        bun_ast::ImportKind::Stmt,
+                        global_cache,
+                    )
+                }) {
+                    bun_resolver::ResultUnion::Success(result) => recorder.found(&result),
+                    _ => None,
+                }
+            };
+            let answer = found.as_ref().map(|found| &*found.path);
+            recorder.write_answer(&mut part, answer, false, found.as_ref());
+        }
+        kind => {
+            let mode = match kind {
+                b"import" => ResolveMode::Esm,
+                b"require" => ResolveMode::Require,
+                b"require-resolve" => ResolveMode::RequireResolve,
+                b"esm-resolve" => ResolveMode::EsmResolve,
+                _ => return None,
+            };
+            let global = vm.global();
+            let specifier = BunString::clone_utf8(asked.specifier);
+            let importer = BunString::clone_utf8(asked.importer);
+            let paths: Vec<BunString> = asked
+                .paths
+                .iter()
+                .map(|it| BunString::clone_utf8(it))
+                .collect();
+            if !paths.is_empty() {
+                // SAFETY: `paths` outlives the resolution below; the slot is cleared after it.
+                let paths = unsafe { bun_ptr::detach_lifetime(&paths[..]) };
+                vm.transpiler
+                    .with_mut(|t| t.resolver.custom_dir_paths = Some(paths));
+            }
+            recorder.state.borrow_mut().open.push(None);
+            let global_cache = vm.transpiler.get().resolver.opts.global_cache;
+            let resolved = if asked.importer_is_file {
+                VirtualMachine::resolve_without_on_resolve::<true>(
+                    global,
+                    &specifier,
+                    &importer,
+                    None,
+                    mode,
+                    global_cache,
+                )
+            } else {
+                VirtualMachine::resolve_without_on_resolve::<false>(
+                    global,
+                    &specifier,
+                    &importer,
+                    None,
+                    mode,
+                    global_cache,
+                )
+            };
+            let found = recorder.state.borrow_mut().open.pop().flatten();
+            vm.transpiler
+                .with_mut(|t| t.resolver.custom_dir_paths = None);
+            let answer = match resolved {
+                Ok(Ok(answer)) => Some(answer),
+                Ok(Err(_)) => None,
+                Err(_) => {
+                    global.clear_exception();
+                    return None;
+                }
+            };
+            let answer = answer.as_ref().map(|it| it.to_utf8());
+            let answer = answer.as_ref().map(|it| it.slice());
+            let found = found.filter(|found| answer == Some(&*found.path));
+            recorder.write_answer(&mut part, answer, false, found.as_ref());
+        }
+    }
+    Some(source_hash(&part))
+}
+
+impl TestInputRecorder {
+    fn found(&self, result: &ResolverResult<'_>) -> Option<Found> {
+        let path = result.path_const()?.text;
+        let mut json = Vec::with_capacity(128);
+        let _ = write!(
+            json,
+            ",\"moduleType\":\"{:?}\",\"flags\":{}",
+            result.module_type,
+            result.flags.bits()
+        );
+        if let Some(package_json) = result.package_json {
+            json.extend_from_slice(b",\"packageJson\":");
+            self.write_path(&mut json, package_json.source.path.text);
+        }
+        Some(Found {
+            path: Box::from(path),
+            json: json.into_boxed_slice(),
+        })
+    }
+
+    /// One entry of `resolutions`: the question, the answer with its details, and the `check` of the
+    /// answer; as JSON, and as the store keeps it.
+    fn resolution_line(
+        &self,
+        question: &Question,
+        answer: Option<&[u8]>,
+        by_plugin: bool,
+        found: Option<&Found>,
+    ) -> (Box<[u8]>, Entry) {
+        let mut line = Vec::with_capacity(320);
+        self.write_question(&mut line, question);
+        let start = line.len();
+        self.write_answer(&mut line, answer, by_plugin, found);
+        let check = source_hash(&line[start..]);
+        line.extend_from_slice(b",\"check\":\"");
+        write_hex(&mut line, &check);
+        line.extend_from_slice(b"\"}");
+        let (specifier, specifier_from_root) = self.written(&question.specifier);
+        let (importer, importer_from_root) = self.written(&question.importer);
+        let flags = if question.importer_is_file { store::IMPORTER_IS_FILE } else { 0 }
+            | if specifier_from_root { store::SPECIFIER_FROM_ROOT } else { 0 }
+            | if importer_from_root { store::IMPORTER_FROM_ROOT } else { 0 }
+            | if by_plugin { store::PLUGIN } else { 0 };
+        let entry = Entry::Resolution {
+            flags,
+            kind: Box::from(question.kind.as_bytes()),
+            specifier,
+            importer,
+            paths: question.paths.iter().map(|it| self.written(it)).collect(),
+            check: Some(check),
+        };
+        (line.into_boxed_slice(), entry)
+    }
+
+    /// A path as records write it, and whether it was made relative to the root.
+    fn written(&self, path: &[u8]) -> (Box<[u8]>, bool) {
+        match self.relative(path) {
+            Some(relative) => (Box::from(relative), true),
+            None => (Box::from(path), false),
+        }
+    }
+
+    fn write_answer(
+        &self,
+        out: &mut Vec<u8>,
+        answer: Option<&[u8]>,
+        by_plugin: bool,
+        found: Option<&Found>,
+    ) {
+        out.extend_from_slice(b",\"answer\":");
+        match answer {
+            Some(path) => {
+                self.write_path(out, path);
+            }
+            None => out.extend_from_slice(b"null"),
+        }
+        if by_plugin {
+            out.extend_from_slice(b",\"plugin\":true");
+        }
+        if let Some(found) = found {
+            out.extend_from_slice(&found.json);
+        }
+    }
+
+    fn write_question(&self, out: &mut Vec<u8>, question: &Question) {
+        out.extend_from_slice(b"{\"specifier\":");
+        let specifier_from_root = self.write_path(out, &question.specifier);
+        out.extend_from_slice(b",\"importer\":");
+        let importer_from_root = self.write_path(out, &question.importer);
+        let _ = write!(out, ",\"kind\":\"{}\"", question.kind);
+        if !question.importer_is_file {
+            out.extend_from_slice(b",\"importerIsDir\":true");
+        }
+        if specifier_from_root {
+            out.extend_from_slice(b",\"specifierFromRoot\":true");
+        }
+        if importer_from_root {
+            out.extend_from_slice(b",\"importerFromRoot\":true");
+        }
+        if !question.paths.is_empty() {
+            let mut from_root = Vec::new();
+            out.extend_from_slice(b",\"paths\":[");
+            for (i, path) in question.paths.iter().enumerate() {
+                if i > 0 {
+                    out.push(b',');
+                }
+                if self.write_path(out, path) {
+                    from_root.push(i);
+                }
+            }
+            out.push(b']');
+            if !from_root.is_empty() {
+                out.extend_from_slice(b",\"pathsFromRoot\":[");
+                for (n, i) in from_root.iter().enumerate() {
+                    let _ = write!(out, "{}{i}", if n > 0 { "," } else { "" });
+                }
+                out.push(b']');
+            }
+        }
+    }
+
+    /// Inside the root, relative to it; elsewhere as it is. Whether it was made relative.
+    fn write_path(&self, out: &mut Vec<u8>, path: &[u8]) -> bool {
+        let relative = self.relative(path);
+        let _ = write!(
+            out,
+            "{}",
+            bun_core::fmt::format_json_string_utf8(relative.unwrap_or(path), Default::default())
+        );
+        relative.is_some()
+    }
+
+    /// The root itself is `.`, and `./` with a separator after it.
+    fn relative<'p>(&self, path: &'p [u8]) -> Option<&'p [u8]> {
+        self.root.relative(path)
+    }
+
+    fn write_record(
+        &self,
+        vm: &VirtualMachine,
+        file_path: &[u8],
+        counts: Option<(&Counts, &Counts)>,
+    ) {
+        let Some(mut file) = self.state.borrow_mut().file.take() else {
+            return;
+        };
+        file.settle();
+        // A write still under way when the file ends, a pending `Bun.write` or an async `node:fs`
+        // call not completed yet, may land before or after the looks below, and a reused file
+        // would not make it: its record must not hold, whatever the timing.
+        if file.in_flight.load(core::sync::atomic::Ordering::Relaxed) != 0 {
+            file.mark(b"pending-write");
+        }
+        let mut own = core::mem::take(&mut file.own);
+        own.finish(&self.root);
+        // What the file read was changed before it was observed, by another process or a file in
+        // another worker: the values below may not be what the file saw.
+        if own.changed {
+            file.mark(b"changed-during-run");
+        }
+        // An answer that was never loaded, such as an `import()` the file did not wait for: hashed as it is now.
+        let answers: Vec<(&[u8], Option<[u8; 32]>)> = (file.answers.iter())
+            .filter(|answer| !file.module_index.contains_key(&***answer))
+            .map(|answer| {
+                let contents = bun_sys::File::read_from(bun_sys::Fd::cwd(), answer).ok();
+                (&**answer, contents.map(|it| source_hash(&it)))
+            })
+            .collect();
+        let aot: Vec<Option<[u8; 32]>> = (file.modules.iter())
+            .map(|(path, _)| aot_config_check(vm, path))
+            .collect();
+        let outcome = counts.map(|(before, after)| {
+            let mut out = [0u32; 6];
+            for (out, ((_, before), (_, after))) in out.iter_mut().zip(before.iter().zip(after)) {
+                *out = after.wrapping_sub(*before);
+            }
+            out
+        });
+        if bun_core::env_var::BUN_TEST_INPUT_RECORD_JSON
+            .get_not_empty()
+            .is_some_and(|it| it != b"0")
+        {
+            self.write_json(file_path, counts, &file, &own, &answers, &aot);
+        }
+        let state = self.state.borrow();
+        let mut entries = Vec::with_capacity(
+            file.resolutions.len() + file.modules.len() + answers.len() + own.reads.len(),
+        );
+        for ((path, _), aot) in file.modules.iter().zip(aot) {
+            let source = state.sources.get(&**path);
+            let flags = source.map_or(0, |source| {
+                (if source.is_virtual { store::VIRTUAL } else { 0 })
+                    | (if source.changed_during_run { store::CHANGED_DURING_RUN } else { 0 })
+            });
+            entries.push(Entry::Module {
+                flags,
+                path: self.written(path).0,
+                sha256: source.map(|it| it.sha256),
+                aot,
+            });
+        }
+        drop(state);
+        for (path, sha256) in answers {
+            entries.push(Entry::Answer {
+                path: self.written(path).0,
+                sha256,
+            });
+        }
+        for read in &own.reads {
+            entries.push(Entry::Read {
+                look: read.look.name(),
+                path: self.written(&read.path).0,
+                extra: read.extra.clone(),
+                value: read.value.clone().unwrap_or_default(),
+            });
+        }
+        entries.extend(file.resolutions.into_iter().map(|(_, entry)| entry));
+        let header = store::Header {
+            outcome,
+            unattributed_before: file.unattributed_before,
+            late_from_earlier_files: file.late_from_earlier_files,
+            marks: file.marks,
+        };
+        let written_file = self.written(file_path).0;
+        let new = store::NewState {
+            file: &written_file,
+            fingerprint: self.fingerprint_hash,
+            header,
+            entries: &entries,
+        };
+        let mut segment = self.segment.borrow_mut();
+        let segment = segment.get_or_insert_with(|| match Segment::open(&self.dir) {
+            Ok(segment) => Some(segment),
+            Err(err) => {
+                bun_core::pretty_errorln!(
+                    "<r><yellow>warn<r><d>:<r> test input records can't be written to {}: {}",
+                    bstr::BStr::new(&self.dir),
+                    err
+                );
+                None
+            }
+        });
+        if let Some(segment) = segment
+            && let Err(err) = segment.append(&new)
+        {
+            bun_core::pretty_errorln!(
+                "<r><yellow>warn<r><d>:<r> the test input record of {} could not be written: {}",
+                bstr::BStr::new(file_path),
+                err
+            );
+        }
+    }
+
+    /// The record of one file as JSON, to read: `BUN_TEST_INPUT_RECORD_JSON=1`.
+    fn write_json(
+        &self,
+        file_path: &[u8],
+        counts: Option<(&Counts, &Counts)>,
+        file: &FileState,
+        own: &OwnReads,
+        answers: &[(&[u8], Option<[u8; 32]>)],
+        aot: &[Option<[u8; 32]>],
+    ) {
+        let state = self.state.borrow();
+        let mut out = Vec::with_capacity(4096);
+        let _ = write!(out, "{{\"version\":{RECORD_VERSION},\"file\":");
+        self.write_path(&mut out, file_path);
+        let _ = write!(
+            out,
+            ",\"root\":{},\"fingerprint\":\"",
+            bun_core::fmt::format_json_string_utf8(&self.root.given, Default::default())
+        );
+        write_hex(&mut out, &self.fingerprint_hash);
+        out.extend_from_slice(b"\",\"outcome\":");
+        match counts {
+            Some((before, after)) => {
+                out.push(b'{');
+                for (i, ((name, before), (_, after))) in before.iter().zip(after).enumerate() {
+                    let comma = if i > 0 { "," } else { "" };
+                    let delta = after.wrapping_sub(*before);
+                    let _ = write!(out, "{comma}\"{name}\":{delta}");
+                }
+                out.push(b'}');
+            }
+            None => out.extend_from_slice(b"null,\"error\":true"),
+        }
+        let _ = write!(
+            out,
+            ",\"unattributedBefore\":{},\"lateFromEarlierFiles\":{},\"generated\":{},\"marks\":[",
+            file.unattributed_before, file.late_from_earlier_files, file.generated
+        );
+        for (i, name) in file.marks.iter().enumerate() {
+            let _ = write!(
+                out,
+                "{}{}",
+                if i > 0 { "," } else { "" },
+                bun_core::fmt::format_json_string_utf8(name, Default::default())
+            );
+        }
+        out.extend_from_slice(b"],\"resolutions\":[");
+        for (i, (line, _)) in file.resolutions.iter().enumerate() {
+            out.extend_from_slice(if i > 0 { b",\n" } else { b"\n" });
+            out.extend_from_slice(line);
+        }
+        out.extend_from_slice(b"],\"modules\":[");
+        for (i, ((path, cached), aot)) in file.modules.iter().zip(aot).enumerate() {
+            out.extend_from_slice(if i > 0 { b",\n" } else { b"\n" });
+            out.extend_from_slice(b"{\"path\":");
+            self.write_path(&mut out, path);
+            match state.sources.get(&**path) {
+                Some(source) => {
+                    out.extend_from_slice(b",\"sha256\":\"");
+                    write_hex(&mut out, &source.sha256);
+                    let loader: &'static str = source.loader.into();
+                    let _ = write!(out, "\",\"loader\":\"{loader}\"");
+                    if source.is_virtual {
+                        out.extend_from_slice(b",\"virtual\":true");
+                    }
+                    if source.changed_during_run {
+                        out.extend_from_slice(b",\"changedDuringRun\":true");
+                    }
+                }
+                None => out.extend_from_slice(b",\"sha256\":null"),
+            }
+            if let Some(own) = aot {
+                out.extend_from_slice(b",\"aotConfig\":\"");
+                write_hex(&mut out, own);
+                out.push(b'"');
+            }
+            if *cached {
+                out.extend_from_slice(b",\"cached\":true");
+            }
+            out.push(b'}');
+        }
+        out.extend_from_slice(b"],\"answerFiles\":[");
+        for (i, (answer, sha256)) in answers.iter().enumerate() {
+            out.extend_from_slice(if i > 0 { b",\n" } else { b"\n" });
+            out.extend_from_slice(b"{\"path\":");
+            self.write_path(&mut out, answer);
+            match sha256 {
+                Some(sha256) => {
+                    out.extend_from_slice(b",\"sha256\":\"");
+                    write_hex(&mut out, sha256);
+                    out.extend_from_slice(b"\"}");
+                }
+                None => out.extend_from_slice(b",\"sha256\":null}"),
+            }
+        }
+        out.extend_from_slice(b"],\"reads\":[");
+        for (i, read) in own.reads.iter().enumerate() {
+            out.extend_from_slice(if i > 0 { b",\n" } else { b"\n" });
+            let _ = write!(out, "{{\"look\":\"{}\",\"path\":", read.look.name());
+            self.write_path(&mut out, &read.path);
+            if !read.extra.is_empty() {
+                let _ = write!(
+                    out,
+                    ",\"extra\":{}",
+                    bun_core::fmt::format_json_string_utf8(&read.extra, Default::default())
+                );
+            }
+            let _ = write!(
+                out,
+                ",\"value\":{}}}",
+                bun_core::fmt::format_json_string_utf8(
+                    read.value.as_deref().unwrap_or(b""),
+                    Default::default()
+                )
+            );
+        }
+        out.extend_from_slice(b"]}\n");
+        drop(state);
+        self.write_file(file_path, &out);
+    }
+
+    fn record_path(&self, file_path: &[u8]) -> Vec<u8> {
+        let mut path = self.dir.to_vec();
+        if !path.last().is_some_and(|&c| bun_paths::is_sep(c)) {
+            path.push(bun_paths::SEP);
+        }
+        for &c in self.relative(file_path).unwrap_or(file_path) {
+            match c {
+                b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' => path.push(c),
+                b'-' | b'_' | b'.' | b'!' | b'~' | b'*' | b'\'' | b'(' | b')' => path.push(c),
+                _ => {
+                    let _ = write!(path, "%{c:02X}");
+                }
+            }
+        }
+        path.extend_from_slice(b".json");
+        path
+    }
+
+    fn write_file(&self, file_path: &[u8], text: &[u8]) {
+        let path = self.record_path(file_path);
+        let mut tmp = path.clone();
+        let _ = write!(tmp, ".{}.tmp", std::process::id());
+        let tmp = bun_sys::UnlinkOnDrop::new(bun_sys::Fd::cwd(), bun_core::ZBox::from_vec(tmp));
+        let dest = bun_core::ZBox::from_vec(path);
+        let flags =
+            bun_sys::O::WRONLY | bun_sys::O::CREAT | bun_sys::O::TRUNC | bun_sys::O::CLOEXEC;
+        let result = bun_sys::File::make_open(tmp.as_bytes(), flags, 0o666)
+            .and_then(|f| f.write_all(text))
+            .and_then(|()| tmp.rename_to(bun_sys::Fd::cwd(), &dest));
+        if let Err(err) = result {
+            bun_core::Output::err(
+                err,
+                "failed to write the test input record <b>{}<r>",
+                (bstr::BStr::new(dest.as_bytes()),),
+            );
+        }
+    }
+}
diff --git a/src/jsc/TestInputStore.rs b/src/jsc/TestInputStore.rs
new file mode 100644
index 000000000..df5a546b9
--- /dev/null
+++ b/src/jsc/TestInputStore.rs
@@ -0,0 +1,882 @@
+//! The store of test input records: one per record directory, so a suite's records are tens of
+//! megabytes instead of one JSON file per test file that repeats the same resolutions and modules.
+//!
+//! What a test file's pass depended on is a list of entries: resolutions (the question and the
+//! `check` of its answer), modules and answer files (path and content hash) and own reads (look,
+//! path, what else the look needs, value). Test files of one suite share most of them, so the store
+//! keeps one table of strings and one of entries, and per test file a few states: the fingerprint of
+//! the run, the outcome and what else the record says, and one list of entry ids per kind.
+//!
+//! Lookup is in two steps. The first key, the fingerprint of the run and the test file's path, gives
+//! the candidate states. Every entry carries its recorded value, so a state's lists are its second
+//! key: they hold on the current tree when looking at each entry again gives the value it carries,
+//! and then the state names the result. Each entry is looked at again once per run, however many
+//! states list it. A file keeps its last [`STATES_PER_FILE`] distinct states, so going to a failing
+//! state and back finds the old pass.
+//!
+//! On disk, `<dir>/store.btis` is the merged store, and `<dir>/segments/` holds one file per process
+//! that recorded since. A process appends one chunk per test file to its own segment and holds an
+//! exclusive `flock` on it while it lives. At the end of a run, the process that started it merges:
+//! under an exclusive lock of `<dir>/store.lock` it reads the store and every segment it can lock
+//! (its writer has exited, or crashed), writes the merged store to a temporary file, renames it over
+//! `store.btis`, and only then removes those segments. Loading takes the same lock shared, so it sees
+//! the store and segments of one moment. A torn chunk at the end of a segment fails its length or
+//! checksum and is ignored with what follows it, so a killed writer loses only its last file.
+//!
+//! Every file starts with `BTIS` and [`STORE_VERSION`]; a file of another version is ignored, and
+//! the next merge replaces it.
+
+use std::collections::HashMap;
+use std::io::{Read as _, Write as _};
+
+/// 2: paths are relative to the record root (the repository) instead of the project directory.
+pub const STORE_VERSION: u32 = 2;
+const MAGIC: &[u8; 4] = b"BTIS";
+/// How many distinct input states of one test file the store keeps, newest first.
+pub const STATES_PER_FILE: usize = 4;
+pub const STORE_FILE: &str = "store.btis";
+const LOCK_FILE: &str = "store.lock";
+const SEGMENTS: &str = "segments";
+
+/// The kinds of entries, in the order a state lists them.
+pub const RESOLUTION: u8 = 0;
+pub const MODULE: u8 = 1;
+pub const ANSWER: u8 = 2;
+pub const READ: u8 = 3;
+
+pub const IMPORTER_IS_FILE: u32 = 1;
+pub const SPECIFIER_FROM_ROOT: u32 = 2;
+pub const IMPORTER_FROM_ROOT: u32 = 4;
+pub const PLUGIN: u32 = 8;
+pub const HAS_CHECK: u32 = 16;
+
+pub const HAS_SHA: u32 = 1;
+pub const VIRTUAL: u32 = 2;
+pub const CHANGED_DURING_RUN: u32 = 4;
+pub const HAS_AOT: u32 = 8;
+
+/// An entry as the recorder hands it over: strings as records write them, paths under the root
+/// relative to it.
+pub enum Entry {
+    Resolution {
+        flags: u32,
+        kind: Box<[u8]>,
+        specifier: Box<[u8]>,
+        importer: Box<[u8]>,
+        /// With whether each was made relative to the root.
+        paths: Vec<(Box<[u8]>, bool)>,
+        check: Option<[u8; 32]>,
+    },
+    Module {
+        flags: u32,
+        path: Box<[u8]>,
+        sha256: Option<[u8; 32]>,
+        aot: Option<[u8; 32]>,
+    },
+    Answer {
+        path: Box<[u8]>,
+        sha256: Option<[u8; 32]>,
+    },
+    Read {
+        look: &'static str,
+        path: Box<[u8]>,
+        extra: Box<[u8]>,
+        value: Box<[u8]>,
+    },
+}
+
+impl Entry {
+    fn kind(&self) -> u8 {
+        match self {
+            Entry::Resolution { .. } => RESOLUTION,
+            Entry::Module { .. } => MODULE,
+            Entry::Answer { .. } => ANSWER,
+            Entry::Read { .. } => READ,
+        }
+    }
+}
+
+/// What a record says besides its inputs.
+#[derive(Clone, Default)]
+pub struct Header<S> {
+    /// pass, fail, skip, todo, expectations, unhandledErrors; `None` when the file failed before its tests.
+    pub outcome: Option<[u32; 6]>,
+    pub unattributed_before: u32,
+    pub late_from_earlier_files: u32,
+    pub marks: Vec<S>,
+}
+
+/// One test file's pass, as the recorder appends it.
+pub struct NewState<'a> {
+    pub file: &'a [u8],
+    pub fingerprint: [u8; 32],
+    pub header: Header<Box<[u8]>>,
+    pub entries: &'a [Entry],
+}
+
+/// A state in the store: strings and entries by id.
+#[derive(Clone)]
+pub struct State {
+    pub file: u32,
+    pub fingerprint: [u8; 32],
+    /// Nanoseconds since the epoch when it was written.
+    pub time: u64,
+    pub header: Header<u32>,
+    /// Entry ids by kind: [`RESOLUTION`], [`MODULE`], [`ANSWER`], [`READ`].
+    pub lists: [Vec<u32>; 4],
+}
+
+/// An entry of the store, decoded.
+pub enum EntryView<'a> {
+    Resolution {
+        flags: u32,
+        kind: &'a [u8],
+        specifier: &'a [u8],
+        importer: &'a [u8],
+        paths: Vec<(&'a [u8], bool)>,
+        check: Option<&'a [u8; 32]>,
+    },
+    Module {
+        flags: u32,
+        path: &'a [u8],
+        sha256: Option<&'a [u8; 32]>,
+        aot: Option<&'a [u8; 32]>,
+    },
+    Answer {
+        path: &'a [u8],
+        sha256: Option<&'a [u8; 32]>,
+    },
+    Read {
+        look: &'a [u8],
+        path: &'a [u8],
+        extra: &'a [u8],
+        value: &'a [u8],
+    },
+}
+
+#[derive(Default)]
+pub struct Store {
+    pub strings: Vec<Box<[u8]>>,
+    string_ids: HashMap<Box<[u8]>, u32>,
+    /// Encoded with ids of `strings`.
+    pub entries: Vec<Box<[u8]>>,
+    entry_ids: HashMap<Box<[u8]>, u32>,
+    pub states: Vec<State>,
+    /// Bytes read from disk, and how many segments.
+    pub bytes: u64,
+    pub segments: usize,
+    /// Files of another store version: ignored.
+    pub other_format: usize,
+}
+
+// ── Encoding ──
+
+fn put_varint(out: &mut Vec<u8>, mut value: u64) {
+    while value >= 0x80 {
+        out.push((value as u8) | 0x80);
+        value >>= 7;
+    }
+    out.push(value as u8);
+}
+
+fn varint(input: &mut &[u8]) -> Option<u64> {
+    let mut value = 0u64;
+    for shift in (0..64).step_by(7) {
+        let (&byte, rest) = input.split_first()?;
+        *input = rest;
+        value |= u64::from(byte & 0x7f) << shift;
+        if byte < 0x80 {
+            return Some(value);
+        }
+    }
+    None
+}
+
+fn id(input: &mut &[u8]) -> Option<u32> {
+    u32::try_from(varint(input)?).ok()
+}
+
+fn take<'a>(input: &mut &'a [u8], n: usize) -> Option<&'a [u8]> {
+    if input.len() < n {
+        return None;
+    }
+    let (head, rest) = input.split_at(n);
+    *input = rest;
+    Some(head)
+}
+
+fn hash32<'a>(input: &mut &'a [u8]) -> Option<&'a [u8; 32]> {
+    take(input, 32)?.try_into().ok()
+}
+
+/// Reads one encoded entry from `input` and writes it to `out` with every string id passed through `map`.
+fn remap_entry(input: &mut &[u8], out: &mut Vec<u8>, map: &mut impl FnMut(u32) -> Option<u32>) -> Option<()> {
+    let mut sid = |input: &mut &[u8], out: &mut Vec<u8>| -> Option<()> {
+        put_varint(out, u64::from(map(id(input)?)?));
+        Some(())
+    };
+    let (&kind, rest) = input.split_first()?;
+    *input = rest;
+    out.push(kind);
+    match kind {
+        RESOLUTION => {
+            let flags = id(input)?;
+            put_varint(out, u64::from(flags));
+            for _ in 0..3 {
+                sid(input, out)?;
+            }
+            let n = id(input)?;
+            put_varint(out, u64::from(n));
+            for _ in 0..n {
+                sid(input, out)?;
+                out.extend_from_slice(take(input, 1)?);
+            }
+            if flags & HAS_CHECK != 0 {
+                out.extend_from_slice(take(input, 32)?);
+            }
+        }
+        MODULE | ANSWER => {
+            let flags = id(input)?;
+            put_varint(out, u64::from(flags));
+            sid(input, out)?;
+            if flags & HAS_SHA != 0 {
+                out.extend_from_slice(take(input, 32)?);
+            }
+            if flags & HAS_AOT != 0 {
+                out.extend_from_slice(take(input, 32)?);
+            }
+        }
+        READ => {
+            for _ in 0..4 {
+                sid(input, out)?;
+            }
+        }
+        _ => return None,
+    }
+    Some(())
+}
+
+fn put_state(out: &mut Vec<u8>, state: &State) {
+    put_varint(out, u64::from(state.file));
+    out.extend_from_slice(&state.fingerprint);
+    put_varint(out, state.time);
+    match state.header.outcome {
+        Some(counts) => {
+            out.push(1);
+            for count in counts {
+                put_varint(out, u64::from(count));
+            }
+        }
+        None => out.push(0),
+    }
+    put_varint(out, u64::from(state.header.unattributed_before));
+    put_varint(out, u64::from(state.header.late_from_earlier_files));
+    put_varint(out, state.header.marks.len() as u64);
+    for &mark in &state.header.marks {
+        put_varint(out, u64::from(mark));
+    }
+    for list in &state.lists {
+        put_varint(out, list.len() as u64);
+        for &entry in list {
+            put_varint(out, u64::from(entry));
+        }
+    }
+}
+
+/// Reads a state with its string and entry ids passed through the maps.
+fn get_state(
+    input: &mut &[u8],
+    strings: &mut impl FnMut(u32) -> Option<u32>,
+    entries: &mut impl FnMut(u32) -> Option<u32>,
+) -> Option<State> {
+    let file = strings(id(input)?)?;
+    let fingerprint = *hash32(input)?;
+    let time = varint(input)?;
+    let outcome = match take(input, 1)?[0] {
+        0 => None,
+        _ => {
+            let mut counts = [0u32; 6];
+            for count in &mut counts {
+                *count = id(input)?;
+            }
+            Some(counts)
+        }
+    };
+    let unattributed_before = id(input)?;
+    let late_from_earlier_files = id(input)?;
+    let mut marks = Vec::new();
+    for _ in 0..id(input)? {
+        marks.push(strings(id(input)?)?);
+    }
+    let mut lists: [Vec<u32>; 4] = Default::default();
+    for list in &mut lists {
+        let n = id(input)? as usize;
+        list.reserve(n.min(input.len()));
+        for _ in 0..n {
+            list.push(entries(id(input)?)?);
+        }
+    }
+    Some(State {
+        file,
+        fingerprint,
+        time,
+        header: Header {
+            outcome,
+            unattributed_before,
+            late_from_earlier_files,
+            marks,
+        },
+        lists,
+    })
+}
+
+/// A chunk: length and checksum of the payload, then the payload.
+fn put_chunk(out: &mut Vec<u8>, payload: &[u8]) {
+    out.extend_from_slice(&(payload.len() as u32).to_le_bytes());
+    out.extend_from_slice(&bun_wyhash::hash32(payload).to_le_bytes());
+    out.extend_from_slice(payload);
+}
+
+fn file_header(out: &mut Vec<u8>) {
+    out.extend_from_slice(MAGIC);
+    out.extend_from_slice(&STORE_VERSION.to_le_bytes());
+}
+
+// ── Files and locks ──
+
+#[cfg(unix)]
+pub fn os_path(path: &[u8]) -> std::path::PathBuf {
+    use std::os::unix::ffi::OsStrExt as _;
+    std::path::PathBuf::from(std::ffi::OsStr::from_bytes(path))
+}
+
+#[cfg(not(unix))]
+pub fn os_path(path: &[u8]) -> std::path::PathBuf {
+    std::path::PathBuf::from(String::from_utf8_lossy(path).into_owned())
+}
+
+/// `flock`; `false` when `nonblocking` and it is held elsewhere, or on an error.
+#[cfg(unix)]
+fn lock(file: &std::fs::File, exclusive: bool, nonblocking: bool) -> bool {
+    use std::os::fd::AsRawFd as _;
+    let op = if exclusive { libc::LOCK_EX } else { libc::LOCK_SH }
+        | if nonblocking { libc::LOCK_NB } else { 0 };
+    loop {
+        // SAFETY: `file` is open.
+        if unsafe { libc::flock(file.as_raw_fd(), op) } == 0 {
+            return true;
+        }
+        if std::io::Error::last_os_error().raw_os_error() != Some(libc::EINTR) {
+            return false;
+        }
+    }
+}
+
+/// Without `flock`, two runs at once in one directory are not safe.
+#[cfg(not(unix))]
+fn lock(_file: &std::fs::File, _exclusive: bool, _nonblocking: bool) -> bool {
+    true
+}
+
+fn open_lock(dir: &std::path::Path) -> Option<std::fs::File> {
+    std::fs::OpenOptions::new()
+        .create(true)
+        .write(true)
+        .truncate(false)
+        .open(dir.join(LOCK_FILE))
+        .ok()
+}
+
+fn now_ns() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |it| it.as_nanos() as u64)
+}
+
+// ── Writing ──
+
+/// The segment this process appends to. Ids are local to it and grow with each chunk.
+pub struct Segment {
+    file: std::fs::File,
+    strings: HashMap<Box<[u8]>, u32>,
+    entries: HashMap<Box<[u8]>, u32>,
+    /// A write failed: what follows would refer to ids a reader never sees.
+    broken: bool,
+}
+
+impl Segment {
+    pub fn open(dir: &[u8]) -> std::io::Result<Segment> {
+        let segments = os_path(dir).join(SEGMENTS);
+        std::fs::create_dir_all(&segments)?;
+        let name = format!("{}-{}", std::process::id(), now_ns());
+        let new = segments.join(format!("{name}.new"));
+        let file = std::fs::OpenOptions::new()
+            .create_new(true)
+            .append(true)
+            .open(&new)?;
+        // Held until the process exits, so a merge leaves the segment alone while it can still grow.
+        // Taken before the segment has the name a merge looks for.
+        lock(&file, true, true);
+        let mut header = Vec::with_capacity(8);
+        file_header(&mut header);
+        (&file).write_all(&header)?;
+        std::fs::rename(&new, segments.join(format!("{name}.seg")))?;
+        Ok(Segment {
+            file,
+            strings: HashMap::new(),
+            entries: HashMap::new(),
+            broken: false,
+        })
+    }
+
+    /// One chunk: the strings and entries this segment has not had yet, and the state.
+    pub fn append(&mut self, state: &NewState<'_>) -> std::io::Result<()> {
+        if self.broken {
+            return Ok(());
+        }
+        let mut new_strings = Vec::new();
+        let mut n_strings = 0u64;
+        let strings = &mut self.strings;
+        let mut sid = |bytes: &[u8]| -> u32 {
+            if let Some(&id) = strings.get(bytes) {
+                return id;
+            }
+            let id = strings.len() as u32;
+            strings.insert(Box::from(bytes), id);
+            put_varint(&mut new_strings, bytes.len() as u64);
+            new_strings.extend_from_slice(bytes);
+            n_strings += 1;
+            id
+        };
+        let mut new_entries = Vec::new();
+        let mut n_entries = 0u64;
+        let mut lists: [Vec<u32>; 4] = Default::default();
+        let mut encoded = Vec::with_capacity(128);
+        for entry in state.entries {
+            encoded.clear();
+            encoded.push(entry.kind());
+            match entry {
+                Entry::Resolution {
+                    flags,
+                    kind,
+                    specifier,
+                    importer,
+                    paths,
+                    check,
+                } => {
+                    let flags = flags | if check.is_some() { HAS_CHECK } else { 0 };
+                    put_varint(&mut encoded, u64::from(flags));
+                    for part in [kind, specifier, importer] {
+                        put_varint(&mut encoded, u64::from(sid(&part[..])));
+                    }
+                    put_varint(&mut encoded, paths.len() as u64);
+                    for (path, from_root) in paths {
+                        put_varint(&mut encoded, u64::from(sid(&path[..])));
+                        encoded.push(*from_root as u8);
+                    }
+                    if let Some(check) = check {
+                        encoded.extend_from_slice(check);
+                    }
+                }
+                Entry::Module {
+                    flags,
+                    path,
+                    sha256,
+                    aot,
+                } => {
+                    let flags = flags
+                        | if sha256.is_some() { HAS_SHA } else { 0 }
+                        | if aot.is_some() { HAS_AOT } else { 0 };
+                    put_varint(&mut encoded, u64::from(flags));
+                    put_varint(&mut encoded, u64::from(sid(&path[..])));
+                    for hash in [sha256, aot].into_iter().flatten() {
+                        encoded.extend_from_slice(hash);
+                    }
+                }
+                Entry::Answer { path, sha256 } => {
+                    put_varint(&mut encoded, u64::from(if sha256.is_some() { HAS_SHA } else { 0 }));
+                    put_varint(&mut encoded, u64::from(sid(&path[..])));
+                    if let Some(sha256) = sha256 {
+                        encoded.extend_from_slice(sha256);
+                    }
+                }
+                Entry::Read {
+                    look,
+                    path,
+                    extra,
+                    value,
+                } => {
+                    for part in [look.as_bytes(), &path[..], &extra[..], &value[..]] {
+                        put_varint(&mut encoded, u64::from(sid(part)));
+                    }
+                }
+            }
+            let id = match self.entries.get(&encoded[..]) {
+                Some(&id) => id,
+                None => {
+                    let id = self.entries.len() as u32;
+                    self.entries.insert(Box::from(&encoded[..]), id);
+                    new_entries.extend_from_slice(&encoded);
+                    n_entries += 1;
+                    id
+                }
+            };
+            lists[usize::from(entry.kind())].push(id);
+        }
+        let stored = State {
+            file: sid(state.file),
+            fingerprint: state.fingerprint,
+            time: now_ns(),
+            header: Header {
+                outcome: state.header.outcome,
+                unattributed_before: state.header.unattributed_before,
+                late_from_earlier_files: state.header.late_from_earlier_files,
+                marks: state.header.marks.iter().map(|it| sid(&it[..])).collect(),
+            },
+            lists,
+        };
+        let mut payload = Vec::with_capacity(new_strings.len() + new_entries.len() + 1024);
+        put_varint(&mut payload, n_strings);
+        payload.extend_from_slice(&new_strings);
+        put_varint(&mut payload, n_entries);
+        payload.extend_from_slice(&new_entries);
+        put_varint(&mut payload, 1);
+        put_state(&mut payload, &stored);
+        let mut chunk = Vec::with_capacity(payload.len() + 8);
+        put_chunk(&mut chunk, &payload);
+        let written = (&self.file).write_all(&chunk);
+        self.broken = written.is_err();
+        written
+    }
+}
+
+// ── Reading ──
+
+impl Store {
+    fn intern_string(&mut self, bytes: &[u8]) -> u32 {
+        if let Some(&id) = self.string_ids.get(bytes) {
+            return id;
+        }
+        let id = self.strings.len() as u32;
+        self.strings.push(Box::from(bytes));
+        self.string_ids.insert(Box::from(bytes), id);
+        id
+    }
+
+    fn intern_entry(&mut self, encoded: &[u8]) -> u32 {
+        if let Some(&id) = self.entry_ids.get(encoded) {
+            return id;
+        }
+        let id = self.entries.len() as u32;
+        self.entries.push(Box::from(encoded));
+        self.entry_ids.insert(Box::from(encoded), id);
+        id
+    }
+
+    /// Adds what a store or segment file holds. `false` when it is of another version.
+    fn add_file(&mut self, bytes: &[u8]) -> bool {
+        let mut input = bytes;
+        let Some(header) = take(&mut input, 8) else {
+            // An empty segment: its writer had not written its header yet.
+            return true;
+        };
+        if &header[..4] != MAGIC || header[4..] != STORE_VERSION.to_le_bytes() {
+            self.other_format += 1;
+            return false;
+        }
+        self.bytes += bytes.len() as u64;
+        let mut local_strings: Vec<u32> = Vec::new();
+        let mut local_entries: Vec<u32> = Vec::new();
+        while let Some(chunk) = Self::next_chunk(&mut input) {
+            if self.add_chunk(chunk, &mut local_strings, &mut local_entries).is_none() {
+                break;
+            }
+        }
+        true
+    }
+
+    fn next_chunk<'a>(input: &mut &'a [u8]) -> Option<&'a [u8]> {
+        let len = u32::from_le_bytes(take(input, 4)?.try_into().ok()?) as usize;
+        let sum = u32::from_le_bytes(take(input, 4)?.try_into().ok()?);
+        let payload = take(input, len)?;
+        (bun_wyhash::hash32(payload) == sum).then_some(payload)
+    }
+
+    fn add_chunk(
+        &mut self,
+        mut input: &[u8],
+        local_strings: &mut Vec<u32>,
+        local_entries: &mut Vec<u32>,
+    ) -> Option<()> {
+        let input = &mut input;
+        for _ in 0..varint(input)? {
+            let len = varint(input)? as usize;
+            let bytes = take(input, len)?;
+            let id = self.intern_string(bytes);
+            local_strings.push(id);
+        }
+        let mut encoded = Vec::with_capacity(128);
+        for _ in 0..varint(input)? {
+            encoded.clear();
+            remap_entry(input, &mut encoded, &mut |it| local_strings.get(it as usize).copied())?;
+            let id = self.intern_entry(&encoded);
+            local_entries.push(id);
+        }
+        for _ in 0..varint(input)? {
+            let state = get_state(
+                input,
+                &mut |it| local_strings.get(it as usize).copied(),
+                &mut |it| local_entries.get(it as usize).copied(),
+            )?;
+            self.states.push(state);
+        }
+        Some(())
+    }
+
+    fn read_into(&mut self, path: &std::path::Path) -> Option<bool> {
+        let mut bytes = Vec::new();
+        std::fs::File::open(path).ok()?.read_to_end(&mut bytes).ok()?;
+        Some(self.add_file(&bytes))
+    }
+
+    /// The store and every segment of `dir`, as one moment of them.
+    pub fn load(dir: &[u8]) -> Store {
+        let dir = os_path(dir);
+        let mut store = Store::default();
+        let Some(lock_file) = open_lock(&dir) else {
+            return store;
+        };
+        lock(&lock_file, false, false);
+        store.read_into(&dir.join(STORE_FILE));
+        for path in segment_paths(&dir) {
+            if store.read_into(&path).is_some() {
+                store.segments += 1;
+            }
+        }
+        store
+    }
+
+    pub fn string(&self, id: u32) -> &[u8] {
+        self.strings.get(id as usize).map_or(b"", |it| &**it)
+    }
+
+    pub fn entry(&self, entry_id: u32) -> Option<EntryView<'_>> {
+        let mut input: &[u8] = self.entries.get(entry_id as usize)?;
+        let input = &mut input;
+        let (&kind, rest) = input.split_first()?;
+        *input = rest;
+        let strings = &self.strings[..];
+        let s = |input: &mut &[u8]| string_at(strings, input);
+        Some(match kind {
+            RESOLUTION => {
+                let flags = id(input)?;
+                let kind = s(input)?;
+                let specifier = s(input)?;
+                let importer = s(input)?;
+                let n = id(input)?;
+                let mut paths = Vec::with_capacity(n as usize);
+                for _ in 0..n {
+                    let path = s(input)?;
+                    paths.push((path, take(input, 1)?[0] != 0));
+                }
+                let check = if flags & HAS_CHECK != 0 { Some(hash32(input)?) } else { None };
+                EntryView::Resolution {
+                    flags,
+                    kind,
+                    specifier,
+                    importer,
+                    paths,
+                    check,
+                }
+            }
+            MODULE | ANSWER => {
+                let flags = id(input)?;
+                let path = s(input)?;
+                let sha256 = if flags & HAS_SHA != 0 { Some(hash32(input)?) } else { None };
+                if kind == ANSWER {
+                    EntryView::Answer { path, sha256 }
+                } else {
+                    let aot = if flags & HAS_AOT != 0 { Some(hash32(input)?) } else { None };
+                    EntryView::Module {
+                        flags,
+                        path,
+                        sha256,
+                        aot,
+                    }
+                }
+            }
+            READ => EntryView::Read {
+                look: s(input)?,
+                path: s(input)?,
+                extra: s(input)?,
+                value: s(input)?,
+            },
+            _ => return None,
+        })
+    }
+
+    /// State indexes by the test file's path as records write it, newest first.
+    pub fn by_file(&self) -> HashMap<&[u8], Vec<usize>> {
+        let mut out: HashMap<&[u8], Vec<usize>> = HashMap::new();
+        for (i, state) in self.states.iter().enumerate() {
+            out.entry(self.string(state.file)).or_default().push(i);
+        }
+        for list in out.values_mut() {
+            list.sort_by_key(|&i| core::cmp::Reverse(self.states[i].time));
+        }
+        out
+    }
+
+    /// The bytes of the merged store: the newest distinct states of each file, and only the strings
+    /// and entries they use.
+    fn merged(&self) -> (Vec<u8>, usize) {
+        let mut kept: Vec<&State> = Vec::new();
+        for list in self.by_file().values() {
+            let mut seen: Vec<&State> = Vec::new();
+            for &i in list {
+                let state = &self.states[i];
+                if seen
+                    .iter()
+                    .any(|it| it.fingerprint == state.fingerprint && it.lists == state.lists)
+                {
+                    continue;
+                }
+                seen.push(state);
+                if seen.len() == STATES_PER_FILE {
+                    break;
+                }
+            }
+            kept.extend(seen);
+        }
+        kept.sort_by_key(|it| (it.file, it.time));
+        let mut string_map: Vec<u32> = vec![u32::MAX; self.strings.len()];
+        let mut entry_map: Vec<u32> = vec![u32::MAX; self.entries.len()];
+        let mut strings = Vec::new();
+        let mut n_strings = 0u64;
+        let mut entries = Vec::new();
+        let mut n_entries = 0u64;
+        let mut states = Vec::new();
+        let mut new_string = |old: u32, strings: &mut Vec<u8>| -> Option<u32> {
+            let slot = string_map.get_mut(old as usize)?;
+            if *slot == u32::MAX {
+                *slot = n_strings as u32;
+                n_strings += 1;
+                let bytes = &self.strings[old as usize];
+                put_varint(strings, bytes.len() as u64);
+                strings.extend_from_slice(bytes);
+            }
+            Some(*slot)
+        };
+        for state in &kept {
+            let mut lists: [Vec<u32>; 4] = Default::default();
+            for (list, old) in lists.iter_mut().zip(&state.lists) {
+                for &entry in old {
+                    let slot = &mut entry_map[entry as usize];
+                    if *slot == u32::MAX {
+                        *slot = n_entries as u32;
+                        n_entries += 1;
+                        let mut input: &[u8] = &self.entries[entry as usize];
+                        let _ = remap_entry(&mut input, &mut entries, &mut |it| new_string(it, &mut strings));
+                    }
+                    list.push(*slot);
+                }
+            }
+            let state = State {
+                file: new_string(state.file, &mut strings).unwrap_or(0),
+                header: Header {
+                    marks: (state.header.marks.iter())
+                        .filter_map(|&it| new_string(it, &mut strings))
+                        .collect(),
+                    ..state.header.clone()
+                },
+                lists,
+                ..(*state).clone()
+            };
+            put_state(&mut states, &state);
+        }
+        let mut payload = Vec::with_capacity(strings.len() + entries.len() + states.len() + 32);
+        put_varint(&mut payload, n_strings);
+        payload.extend_from_slice(&strings);
+        put_varint(&mut payload, n_entries);
+        payload.extend_from_slice(&entries);
+        put_varint(&mut payload, kept.len() as u64);
+        payload.extend_from_slice(&states);
+        let mut out = Vec::with_capacity(payload.len() + 16);
+        file_header(&mut out);
+        put_chunk(&mut out, &payload);
+        (out, kept.len())
+    }
+}
+
+fn string_at<'a>(strings: &'a [Box<[u8]>], input: &mut &[u8]) -> Option<&'a [u8]> {
+    Some(&**strings.get(id(input)? as usize)?)
+}
+
+fn segment_paths(dir: &std::path::Path) -> Vec<std::path::PathBuf> {
+    let Ok(items) = std::fs::read_dir(dir.join(SEGMENTS)) else {
+        return Vec::new();
+    };
+    let mut out: Vec<_> = items
+        .filter_map(|it| it.ok())
+        .map(|it| it.path())
+        .filter(|it| it.extension().is_some_and(|ext| ext == "seg"))
+        .collect();
+    out.sort();
+    out
+}
+
+/// What [`merge`] did.
+pub struct Merged {
+    pub segments: usize,
+    pub states: usize,
+    pub bytes: usize,
+}
+
+/// Merges the segments whose writers have exited into the store of `dir`. Segments of processes
+/// still running stay as they are; a later merge takes them.
+pub fn merge(dir: &[u8]) -> std::io::Result<Option<Merged>> {
+    let dir = os_path(dir);
+    let paths = segment_paths(&dir);
+    if paths.is_empty() {
+        return Ok(None);
+    }
+    let Some(lock_file) = open_lock(&dir) else {
+        return Ok(None);
+    };
+    lock(&lock_file, true, false);
+    let mut store = Store::default();
+    store.read_into(&dir.join(STORE_FILE));
+    let mut taken = Vec::new();
+    for path in segment_paths(&dir) {
+        let Ok(file) = std::fs::File::open(&path) else {
+            continue;
+        };
+        if !lock(&file, true, true) {
+            continue;
+        }
+        let mut bytes = Vec::new();
+        if (&file).read_to_end(&mut bytes).is_ok() {
+            store.add_file(&bytes);
+        }
+        taken.push((path, file));
+    }
+    if taken.is_empty() {
+        return Ok(None);
+    }
+    let (bytes, states) = store.merged();
+    let dest = dir.join(STORE_FILE);
+    let tmp = dir.join(format!("{STORE_FILE}.{}.tmp", std::process::id()));
+    let written = std::fs::write(&tmp, &bytes).and_then(|()| std::fs::rename(&tmp, &dest));
+    if let Err(err) = written {
+        let _ = std::fs::remove_file(&tmp);
+        return Err(err);
+    }
+    for (path, _) in &taken {
+        let _ = std::fs::remove_file(path);
+    }
+    Ok(Some(Merged {
+        segments: taken.len(),
+        states,
+        bytes: bytes.len(),
+    }))
+}
diff --git a/src/jsc/TestOwnReads.rs b/src/jsc/TestOwnReads.rs
new file mode 100644
index 000000000..1814b8c71
--- /dev/null
+++ b/src/jsc/TestOwnReads.rs
@@ -0,0 +1,761 @@
+//! What a test file's own code read from the file system, as part of its input record.
+//!
+//! The JavaScript-facing file APIs (`node:fs` in all three forms, `Bun.file` and `Bun.write`,
+//! `Bun.Glob`, `fs.watch`) and the runner's snapshot files report each look at a path on the JS
+//! thread, when the call is made, so async work is credited to the file that started it. A look is
+//! not taken then: it is observed the way validation repeats it, the first time the file writes to
+//! the path or near it, or else when the record is written. So a read followed by the file's own
+//! write keeps what the path held before the write. A stamp taken at the look and again after the
+//! value proves the value is what the file saw; when it changed in between, as when a file in
+//! another worker wrote the path, the record does not hold. A path the file wrote before it looked at it is
+//! not an input, and neither is anything under a directory it created. What the file's writes left
+//! at each path it wrote is a look too, taken when it ends: a reused file writes nothing, so its
+//! record holds only while that is still there.
+//!
+//! The resolver's and the module loader's reads are not here: resolutions are asked again and
+//! modules are hashed.
+
+use std::io::Write as _;
+
+use bun_collections::StringHashMap;
+
+/// One way of looking at a path; validation looks again the same way and compares.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Look {
+    /// The bytes.
+    Content,
+    /// Type, size and the owner's permission bits, following a symbolic link.
+    Stat,
+    /// The same, of the path itself.
+    Lstat,
+    /// Whether it exists.
+    Exists,
+    /// Whether `access` with the mode in `extra` (decimal) succeeds.
+    Access,
+    /// A symbolic link's target.
+    Readlink,
+    /// The canonical path.
+    Realpath,
+    /// The names and types of a directory's entries.
+    List,
+    /// The same, for every directory below it too.
+    ListRecursive,
+    /// Names, types and the bytes of every file below a directory (`fs.cp`).
+    Tree,
+    /// What a `Bun.Glob` scan from this directory matches. `extra` holds the pattern and options.
+    Glob,
+}
+
+const LOOKS: [(Look, &str); 11] = [
+    (Look::Content, "content"),
+    (Look::Stat, "stat"),
+    (Look::Lstat, "lstat"),
+    (Look::Exists, "exists"),
+    (Look::Access, "access"),
+    (Look::Readlink, "readlink"),
+    (Look::Realpath, "realpath"),
+    (Look::List, "list"),
+    (Look::ListRecursive, "listRecursive"),
+    (Look::Tree, "tree"),
+    (Look::Glob, "glob"),
+];
+
+impl Look {
+    pub fn name(self) -> &'static str {
+        LOOKS.iter().find(|(look, _)| *look == self).map_or("", |(_, name)| name)
+    }
+
+    pub fn from_name(name: &[u8]) -> Option<Look> {
+        LOOKS
+            .iter()
+            .find(|(_, it)| it.as_bytes() == name)
+            .map(|(look, _)| *look)
+    }
+}
+
+pub struct Read {
+    pub look: Look,
+    /// Absolute.
+    pub path: Box<[u8]>,
+    pub extra: Box<[u8]>,
+    /// `None` until observed.
+    pub value: Option<Box<[u8]>>,
+    /// What [`stamp`] gave when the file looked, to prove that the value observed later is the one
+    /// it saw. `None` for a look at what the file's writes left.
+    pub stamp: Option<Box<[u8]>>,
+}
+
+impl Read {
+    /// Observes the look now, and returns whether what is there changed since the file looked:
+    /// the stamp is taken again after the value, so an equal stamp proves the value is what the
+    /// file saw.
+    fn observe(&mut self, root: &Root) -> bool {
+        self.value = Some(observe(root, self.look, &self.path, &self.extra));
+        self.stamp
+            .as_deref()
+            .is_some_and(|then| *stamp(root, self.look, &self.path, &self.extra) != *then)
+    }
+}
+
+/// What a write did to a path, which decides what is there afterwards because of the file's own code.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Wrote {
+    /// Wrote or created the file at the path: its bytes are the file's own product.
+    File,
+    /// Removed the path, made it a new directory, or moved or copied a tree to it: whatever is at
+    /// or below it afterwards is the file's own product.
+    Tree,
+    /// Changed only metadata, or made a directory that may have been there already: what is at or
+    /// below it is not the file's product.
+    Meta,
+    /// Put a tree into a directory that was there and is not the file's product (an archive
+    /// extracted or a tree copied into it): as [`Wrote::Meta`], what is at or below it is not the
+    /// file's product, but the whole tree is what the write left there.
+    Merge,
+}
+
+#[derive(Default)]
+pub struct OwnReads {
+    pub reads: Vec<Read>,
+    keys: StringHashMap<()>,
+    /// Absolute paths the file wrote, created or removed, as given and with the symbolic links of
+    /// their parent resolved (a module's path is the resolved one, as `/private/tmp` on macOS).
+    written: Vec<(Box<[u8]>, Wrote)>,
+    /// Absolute paths, as given, that the file's calls wrote or tried to write, with the strongest
+    /// effect that applied there (`None` when none did): what is there when the file ends is a look
+    /// of the record, with [`AFTER_WRITE`] as its `extra`.
+    touched: Vec<(Box<[u8]>, Option<Wrote>)>,
+    /// The directories `fs.mkdtemp` made for the file: new names each run, so what is at or below
+    /// them is never a look.
+    created: Vec<Box<[u8]>>,
+    /// A path the file looked at changed before its look was observed, so the record may not hold
+    /// what the file saw: another process wrote it, such as a file running in another worker.
+    pub changed: bool,
+}
+
+/// The `extra` of a look at what the file's own writes left at a path when it ended. A record
+/// holds only if that is still there: when the file is reused instead of run, nothing writes it
+/// again, and a later file may read it.
+pub const AFTER_WRITE: &[u8] = b"after";
+
+/// Where the kernel's walk of a path lands, and the symbolic links on the way that the file did not
+/// make: a change to one of those changes where a look lands.
+struct Landing {
+    path: Vec<u8>,
+    links: Vec<Vec<u8>>,
+}
+
+/// As many symbolic links as Linux follows in one walk; past that the walk fails with `ELOOP`.
+const MAX_LINKS: u32 = 40;
+
+/// `path` with the symbolic links of its parent directory resolved, when that changes it.
+fn real_parent(path: &[u8]) -> Option<Vec<u8>> {
+    let split = path.iter().rposition(|&c| bun_paths::is_sep(c))?;
+    let (parent, name) = (&path[..split.max(1)], &path[split + 1..]);
+    let zparent = bun_core::ZBox::from_vec(parent.to_vec());
+    let mut buf = bun_paths::path_buffer_pool::get();
+    let real: &[u8] = bun_sys::realpath(&zparent, &mut buf).ok()?;
+    if real == parent {
+        return None;
+    }
+    let mut out = real.to_vec();
+    if !out.last().is_some_and(|&c| bun_paths::is_sep(c)) {
+        out.push(bun_paths::SEP);
+    }
+    out.extend_from_slice(name);
+    Some(out)
+}
+
+/// The directory a record's paths are relative to, as given and with its symbolic links resolved:
+/// a module's path is the resolved one, a path the test's code passes may be either.
+pub struct Root {
+    pub given: Box<[u8]>,
+    pub real: Box<[u8]>,
+}
+
+impl Root {
+    pub fn new(given: &[u8]) -> Root {
+        let zgiven = bun_core::ZBox::from_vec(given.to_vec());
+        let mut buf = bun_paths::path_buffer_pool::get();
+        let real: Box<[u8]> = match bun_sys::realpath(&zgiven, &mut buf) {
+            Ok(real) => Box::from(real),
+            Err(_) => Box::from(given),
+        };
+        Root {
+            given: Box::from(given),
+            real,
+        }
+    }
+
+    /// `path` relative to the root, if it is under it: the root itself is `.`, and `./` with a
+    /// separator after it.
+    pub fn relative<'p>(&self, path: &'p [u8]) -> Option<&'p [u8]> {
+        [&*self.given, &*self.real].into_iter().find_map(|root| {
+            let rest = path.strip_prefix(root)?;
+            if rest.is_empty() {
+                return Some(&b"."[..]);
+            }
+            if root.last().is_some_and(|&c| bun_paths::is_sep(c)) {
+                return Some(rest);
+            }
+            if !bun_paths::is_sep(rest[0]) {
+                return None;
+            }
+            Some(if rest.len() == 1 { &b"./"[..] } else { &rest[1..] })
+        })
+    }
+}
+
+/// `inner` is `outer` or below it.
+fn under(inner: &[u8], outer: &[u8]) -> bool {
+    match inner.strip_prefix(outer) {
+        Some(rest) => {
+            rest.is_empty()
+                || bun_paths::is_sep(rest[0])
+                || outer.last().is_some_and(|&c| bun_paths::is_sep(c))
+        }
+        None => false,
+    }
+}
+
+impl OwnReads {
+    /// Whether what is at `path` now is the product of the file's own writes so far: a file it
+    /// wrote, or a path in a tree it removed, made new or replaced.
+    pub fn generated(&self, path: &[u8]) -> bool {
+        self.written.iter().any(|(written, wrote)| match wrote {
+            Wrote::File => **written == *path,
+            Wrote::Tree => under(path, written),
+            Wrote::Meta | Wrote::Merge => false,
+        })
+    }
+
+    /// Whether `path` is at or below something the file wrote: a look there may go through a
+    /// symbolic link the file made.
+    fn reaches_written(&self, path: &[u8]) -> bool {
+        self.written
+            .iter()
+            .any(|(written, wrote)| {
+                matches!(wrote, Wrote::File | Wrote::Tree) && under(path, written)
+            })
+    }
+
+    fn land(&self, path: &[u8], follow_last: bool) -> Option<Landing> {
+        land(path, follow_last, &|path| self.generated(path))
+    }
+
+    /// Notes a look at the absolute `path`, unless what is there is the file's own product. A path
+    /// at or below something the file wrote, or with a `..` in it, is walked now, as the kernel
+    /// walks it: what a symbolic link leads to is looked at where it lands (a `..` after a link goes
+    /// up from where the link led), and every link on the way that the file did not make is an
+    /// input too. Returns `false` when the walk met more links than the kernel follows, which the
+    /// record can't repeat.
+    pub fn read(&mut self, root: &Root, look: Look, path: &[u8], extra: &[u8]) -> bool {
+        if !has_dotdot(path) && !self.reaches_written(path) {
+            self.note(root, look, path, extra);
+            return true;
+        }
+        // `lstat` and `readlink` look at the last component itself.
+        let follow_last = !matches!(look, Look::Lstat | Look::Readlink);
+        let Some(landing) = self.land(path, follow_last) else {
+            return false;
+        };
+        for link in &landing.links {
+            self.note(root, Look::Readlink, link, b"");
+        }
+        if !self.generated(&landing.path) {
+            self.note(root, look, &landing.path, extra);
+        }
+        true
+    }
+
+    fn note(&mut self, root: &Root, look: Look, path: &[u8], extra: &[u8]) {
+        if self.generated(path) {
+            return;
+        }
+        let mut key = Vec::with_capacity(path.len() + extra.len() + 16);
+        key.extend_from_slice(look.name().as_bytes());
+        key.push(0);
+        key.extend_from_slice(path);
+        key.push(0);
+        key.extend_from_slice(extra);
+        if self.keys.contains_key(&*key) {
+            return;
+        }
+        bun_core::handle_oom(self.keys.put(&key, ()));
+        self.reads.push(Read {
+            look,
+            path: Box::from(path),
+            extra: Box::from(extra),
+            value: None,
+            stamp: Some(stamp(root, look, path, extra)),
+        });
+    }
+
+    /// [`Self::before_write`] and [`Self::wrote`] at once, for a write that is not undone when it fails.
+    pub fn write(&mut self, root: &Root, path: &[u8], wrote: Wrote) {
+        self.before_write(root, path);
+        self.wrote(path, wrote);
+    }
+
+    /// Before the file writes to `path`: what it looked at there, below it, or above it is observed
+    /// now, so the record keeps what was there before the write.
+    pub fn before_write(&mut self, root: &Root, path: &[u8]) {
+        for read in self.reads.iter_mut().filter(|read| read.value.is_none()) {
+            if under(&read.path, path) || under(path, &read.path) {
+                self.changed |= read.observe(root);
+            }
+        }
+        if !self.touched.iter().any(|(it, _)| **it == *path) {
+            self.touched.push((Box::from(path), None));
+        }
+    }
+
+    /// `fs.mkdtemp` made the directory at `path` for the file: what is at or below it is the
+    /// file's product.
+    pub fn created(&mut self, path: &[u8]) {
+        self.wrote(path, Wrote::Tree);
+        self.created.push(Box::from(path));
+    }
+
+    /// After a write to `path` succeeded: what it left there is the file's product, as `wrote` says.
+    pub fn wrote(&mut self, path: &[u8], wrote: Wrote) {
+        if let Some((_, strongest)) = self.touched.iter_mut().find(|(it, _)| **it == *path)
+            && !(wrote == Wrote::Meta && strongest.is_some())
+        {
+            *strongest = Some(wrote);
+        }
+        if matches!(wrote, Wrote::Meta | Wrote::Merge) {
+            return;
+        }
+        let real = real_parent(path);
+        for path in core::iter::once(path).chain(real.as_deref()) {
+            if !self
+                .written
+                .iter()
+                .any(|(written, was)| *was == wrote && **written == *path)
+            {
+                self.written.push((Box::from(path), wrote));
+            }
+        }
+    }
+
+    /// When the record is written: observes what was not observed yet, and what the file's writes
+    /// left at each path it wrote or tried to write, outside the directories `fs.mkdtemp` made.
+    /// Where no effect applied (the call failed, or its effect is not known, as a Blob writer's),
+    /// what is there was an input already, so only its type, size and owner bits (`lstat`), which
+    /// still see an output that went away. Else a symbolic link's target; where only metadata
+    /// changed, the type and permission bits; else a directory's tree, or the bytes or the error.
+    pub fn finish(&mut self, root: &Root) {
+        for read in self.reads.iter_mut().filter(|read| read.value.is_none()) {
+            self.changed |= read.observe(root);
+        }
+        let touched = core::mem::take(&mut self.touched);
+        for (path, strongest) in touched {
+            if self.created.iter().any(|created| under(&path, created)) {
+                continue;
+            }
+            let look = if strongest.is_none() {
+                Look::Lstat
+            } else {
+                match bun_sys::lstat(&bun_core::ZBox::from_vec(path.to_vec())) {
+                    Ok(stat) => match stat.st_mode as u32 & bun_sys::S::IFMT as u32 {
+                        kind if kind == bun_sys::S::IFLNK as u32 => Look::Readlink,
+                        _ if strongest == Some(Wrote::Meta) => Look::Stat,
+                        kind if kind == bun_sys::S::IFDIR as u32 => Look::Tree,
+                        _ => Look::Content,
+                    },
+                    Err(_) => Look::Content,
+                }
+            };
+            let value = observe(root, look, &path, AFTER_WRITE);
+            self.reads.push(Read {
+                look,
+                path,
+                extra: Box::from(AFTER_WRITE),
+                value: Some(value),
+                stamp: None,
+            });
+        }
+    }
+}
+
+/// Whether `path` has a `..` component, which only a walk resolves: after a symbolic link it goes up
+/// from where the link led, not from the link.
+pub fn has_dotdot(path: &[u8]) -> bool {
+    path.split(|&c| bun_paths::is_sep(c)).any(|it| it == b"..")
+}
+
+/// The absolute `path` with its `..` components taken where the kernel's walk takes them, now: what
+/// comes before the last `..` is walked, what comes after it is kept as it is. Unchanged when it has
+/// none, or the walk meets too many links.
+pub fn walked(path: &[u8]) -> Vec<u8> {
+    let parts: Vec<&[u8]> = path.split(|&c| bun_paths::is_sep(c)).collect();
+    let Some(last) = parts.iter().rposition(|it| *it == b"..") else {
+        return path.to_vec();
+    };
+    let head = parts[..=last].join(&bun_paths::SEP);
+    let Some(landing) = land(&head, true, &|_| true) else {
+        return path.to_vec();
+    };
+    let mut out = landing.path;
+    for part in parts[last + 1..].iter().filter(|it| !it.is_empty() && **it != b".") {
+        if !out.last().is_some_and(|&c| bun_paths::is_sep(c)) {
+            out.push(bun_paths::SEP);
+        }
+        out.extend_from_slice(part);
+    }
+    out
+}
+
+/// Walks the absolute `path` the way the kernel does, now: component by component, following every
+/// symbolic link (the last one too when `follow_last`), with `..` taken from where a link led. It
+/// stops at the first component that is missing or is not a directory, since the walk fails there:
+/// what is there decides the look. The links on the way that `made` does not claim are returned.
+/// `None` past [`MAX_LINKS`] links.
+fn land(path: &[u8], follow_last: bool, made: &dyn Fn(&[u8]) -> bool) -> Option<Landing> {
+    let mut pending: Vec<Vec<u8>> = path
+        .split(|&c| bun_paths::is_sep(c))
+        .filter(|it| !it.is_empty() && *it != b".")
+        .rev()
+        .map(<[u8]>::to_vec)
+        .collect();
+    let mut at: Vec<u8> = vec![bun_paths::SEP];
+    let mut links = Vec::new();
+    let mut hops = 0;
+    let join = |dir: &[u8], name: &[u8]| {
+        let mut out = dir.to_vec();
+        if !out.last().is_some_and(|&c| bun_paths::is_sep(c)) {
+            out.push(bun_paths::SEP);
+        }
+        out.extend_from_slice(name);
+        out
+    };
+    while let Some(name) = pending.pop() {
+        if name == b"." {
+            continue;
+        }
+        if name == b".." {
+            if let Some(split) = at.iter().rposition(|&c| bun_paths::is_sep(c)) {
+                at.truncate(split.max(1));
+            }
+            continue;
+        }
+        let next = join(&at, &name);
+        if pending.is_empty() && !follow_last {
+            return Some(Landing { path: next, links });
+        }
+        let znext = bun_core::ZBox::from_vec(next.clone());
+        let Ok(stat) = bun_sys::lstat(&znext) else {
+            return Some(Landing { path: next, links });
+        };
+        let kind = stat.st_mode as u32 & bun_sys::S::IFMT as u32;
+        if kind == bun_sys::S::IFLNK as u32 {
+            hops += 1;
+            if hops > MAX_LINKS {
+                return None;
+            }
+            let mut buf = bun_paths::path_buffer_pool::get();
+            let Ok(len) = bun_sys::readlink(&znext, &mut buf[..]) else {
+                return Some(Landing { path: next, links });
+            };
+            let target = buf[..len].to_vec();
+            if !made(&next) {
+                links.push(next);
+            }
+            if target.first().is_some_and(|&c| bun_paths::is_sep(c)) {
+                at = vec![bun_paths::SEP];
+            }
+            pending.extend(
+                target
+                    .split(|&c| bun_paths::is_sep(c))
+                    .filter(|it| !it.is_empty())
+                    .rev()
+                    .map(<[u8]>::to_vec),
+            );
+            continue;
+        }
+        at = next;
+        if kind != bun_sys::S::IFDIR as u32 && !pending.is_empty() {
+            return Some(Landing { path: at, links });
+        }
+    }
+    Some(Landing { path: at, links })
+}
+
+/// Looks at `path` the way `look` says. The same call records and validates, so the two agree on
+/// the encoding: a hex SHA-256 for bytes and listings, a short text for the rest, and the error's
+/// name (such as `ENOENT`) when the look fails. Paths under `root` in a value are relative to it.
+pub fn observe(root: &Root, look: Look, path: &[u8], extra: &[u8]) -> Box<[u8]> {
+    let zpath = bun_core::ZBox::from_vec(path.to_vec());
+    let error = |err: bun_sys::Error| -> Box<[u8]> { Box::from(err.name()) };
+    let value: Vec<u8> = match look {
+        Look::Content => content(&zpath),
+        Look::Stat | Look::Lstat => {
+            let stat = if look == Look::Stat {
+                bun_sys::stat(&zpath)
+            } else {
+                bun_sys::lstat(&zpath)
+            };
+            match stat {
+                Ok(stat) => describe(stat.st_mode as u32, stat.st_size as u64),
+                Err(err) => return error(err),
+            }
+        }
+        Look::Access => {
+            let mode = core::str::from_utf8(extra)
+                .ok()
+                .and_then(|it| it.parse::<i32>().ok())
+                .unwrap_or(0);
+            match bun_sys::access(&zpath, mode) {
+                Ok(()) => b"yes".to_vec(),
+                Err(err) => return error(err),
+            }
+        }
+        Look::Exists => {
+            if bun_sys::stat(&zpath).is_ok() {
+                b"yes".to_vec()
+            } else {
+                b"no".to_vec()
+            }
+        }
+        Look::Readlink => {
+            let mut buf = bun_paths::path_buffer_pool::get();
+            match bun_sys::readlink(&zpath, &mut buf[..]) {
+                Ok(len) => buf[..len].to_vec(),
+                Err(err) => return error(err),
+            }
+        }
+        Look::Realpath => {
+            let mut buf = bun_paths::path_buffer_pool::get();
+            match bun_sys::realpath(&zpath, &mut buf) {
+                Ok(real) => from_root(root, real),
+                Err(err) => return error(err),
+            }
+        }
+        Look::List | Look::ListRecursive | Look::Tree => {
+            let mut lines = Vec::new();
+            if let Err(err) = list(path, b"", look, content, &mut lines) {
+                return error(err);
+            }
+            lines.sort();
+            hex(&crate::test_input_recorder::source_hash(&lines.concat()))
+        }
+        Look::Glob => match glob(root, path, extra) {
+            Some(mut matches) => {
+                matches.sort();
+                let mut joined = Vec::new();
+                for it in matches {
+                    joined.extend_from_slice(&it);
+                    joined.push(b'\n');
+                }
+                hex(&crate::test_input_recorder::source_hash(&joined))
+            }
+            None => b"error".to_vec(),
+        },
+    };
+    value.into_boxed_slice()
+}
+
+/// What a look's value rests on, taken when the file looks and again after the value is observed:
+/// when the two differ, the value may not be what the file saw. For the cheap looks it is the value
+/// itself. For bytes it is the file's device, inode, size and modification and change times in
+/// nanoseconds, which any write changes, so it also sees a write that restored the size or the
+/// bytes; for a tree, the same for every file in it, with the names and types.
+fn stamp(root: &Root, look: Look, path: &[u8], extra: &[u8]) -> Box<[u8]> {
+    match look {
+        Look::Content => file_stamp(&bun_core::ZBox::from_vec(path.to_vec())).into_boxed_slice(),
+        Look::Tree => {
+            let mut lines = Vec::new();
+            if let Err(err) = list(path, b"", look, file_stamp, &mut lines) {
+                return Box::from(err.name());
+            }
+            lines.sort();
+            hex(&crate::test_input_recorder::source_hash(&lines.concat())).into_boxed_slice()
+        }
+        _ => observe(root, look, path, extra),
+    }
+}
+
+/// A regular file's device, inode, size and times; what a content look takes of anything else.
+fn file_stamp(path: &bun_core::ZStr) -> Vec<u8> {
+    let stat = match bun_sys::stat(path) {
+        Ok(stat) => stat,
+        Err(err) => return err.name().to_vec(),
+    };
+    if stat.st_mode as u32 & bun_sys::S::IFMT as u32 != bun_sys::S::IFREG as u32 {
+        return content(path);
+    }
+    let (modified, changed) = (bun_sys::stat_mtime(&stat), bun_sys::stat_ctime(&stat));
+    format!(
+        "{} {} {} {}.{} {}.{}",
+        stat.st_dev, stat.st_ino, stat.st_size, modified.sec, modified.nsec, changed.sec, changed.nsec
+    )
+    .into_bytes()
+}
+
+/// A content look: the SHA-256 of a regular file's bytes, read in chunks so that memory stays
+/// bounded whatever the size. Anything else (a device such as `/dev/stdout` or `/dev/urandom`, a
+/// pipe, a directory) is never opened: its kind is the value. There is no size cap: a large file
+/// costs time to hash, once per record and once per validation, not memory.
+fn content(path: &bun_core::ZStr) -> Vec<u8> {
+    let stat = match bun_sys::stat(path) {
+        Ok(stat) => stat,
+        Err(err) => return err.name().to_vec(),
+    };
+    let kind = stat.st_mode as u32 & bun_sys::S::IFMT as u32;
+    if kind != bun_sys::S::IFREG as u32 {
+        return if kind == bun_sys::S::IFDIR as u32 {
+            b"directory".to_vec()
+        } else {
+            b"not a file".to_vec()
+        };
+    }
+    // Non-blocking, in case the path became a pipe since the `stat`.
+    let fd = match bun_sys::open(path, bun_sys::O::RDONLY | bun_sys::O::NONBLOCK, 0) {
+        Ok(fd) => fd,
+        Err(err) => return err.name().to_vec(),
+    };
+    let file = bun_sys::File::from_fd(fd);
+    let mut hasher = bun_sha_hmac::sha::hashers::SHA256::init();
+    let mut chunk = vec![0u8; 64 * 1024];
+    loop {
+        match bun_sys::read(file.handle, &mut chunk) {
+            Ok(0) => break,
+            Ok(n) => hasher.update(&chunk[..n]),
+            Err(err) => return err.name().to_vec(),
+        }
+    }
+    let mut sha256 = [0u8; 32];
+    hasher.r#final(&mut sha256);
+    hex(&sha256)
+}
+
+fn hex(bytes: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(64);
+    crate::test_input_recorder::write_hex(&mut out, bytes);
+    out
+}
+
+/// Type, size and the owner's permission bits: what a test asserts with `stat().mode` or
+/// `access`, such as an executable bit, which git keeps. The group's and others' bits come from the
+/// umask of the checkout, not from the repository, so they are left out and a record holds on a
+/// machine with another umask. Times are never compared.
+fn describe(mode: u32, size: u64) -> Vec<u8> {
+    let kind = mode & bun_sys::S::IFMT as u32;
+    let owner = mode & 0o700;
+    if kind == bun_sys::S::IFREG as u32 {
+        format!("file {size} {owner:o}").into_bytes()
+    } else if kind == bun_sys::S::IFDIR as u32 {
+        format!("directory {owner:o}").into_bytes()
+    } else if kind == bun_sys::S::IFLNK as u32 {
+        b"symlink".to_vec()
+    } else {
+        b"other".to_vec()
+    }
+}
+
+fn from_root(root: &Root, path: &[u8]) -> Vec<u8> {
+    match root.relative(path) {
+        Some(b".") => b".".to_vec(),
+        Some(b"./") => b"./".to_vec(),
+        Some(rest) => {
+            let mut out = b"./".to_vec();
+            out.extend_from_slice(rest);
+            out
+        }
+        None => path.to_vec(),
+    }
+}
+
+/// One line per entry, `relative name, kind[, hash]`, for the directory at `path` (and, for the
+/// recursive looks, every directory below it; symbolic links are not followed).
+fn list(
+    path: &[u8],
+    prefix: &[u8],
+    look: Look,
+    file: fn(&bun_core::ZStr) -> Vec<u8>,
+    lines: &mut Vec<Vec<u8>>,
+) -> bun_sys::Result<()> {
+    let fd = bun_sys::open_dir_for_iteration(bun_sys::Fd::cwd(), path)?;
+    let dir = bun_sys::File::from_fd(fd);
+    let mut entries = Vec::new();
+    let mut iterator = bun_sys::dir_iterator::iterate(dir.handle);
+    while let Some(entry) = iterator.next()? {
+        entries.push((entry.name.slice_u8().to_vec(), entry.kind));
+    }
+    drop(dir);
+    for (name, kind) in entries {
+        let mut relative = prefix.to_vec();
+        relative.extend_from_slice(&name);
+        let mut line = relative.clone();
+        let _ = write!(line, "\t{kind:?}");
+        let mut child = path.to_vec();
+        child.push(bun_paths::SEP);
+        child.extend_from_slice(&name);
+        let is_dir = matches!(kind, bun_sys::EntryKind::Directory);
+        if look == Look::Tree && matches!(kind, bun_sys::EntryKind::File) {
+            line.push(b'\t');
+            line.extend_from_slice(&file(&bun_core::ZBox::from_vec(child.clone())));
+        }
+        line.push(b'\n');
+        lines.push(line);
+        if is_dir && look != Look::List {
+            relative.push(b'/');
+            list(&child, &relative, look, file, lines)?;
+        }
+    }
+    Ok(())
+}
+
+/// The options of a `Bun.Glob` scan, as `extra` carries them after the pattern and a NUL.
+pub struct GlobOptions {
+    pub dot: bool,
+    pub absolute: bool,
+    pub only_files: bool,
+    pub follow_symlinks: bool,
+    pub error_on_broken_symlinks: bool,
+}
+
+pub fn glob_extra(pattern: &[u8], options: &GlobOptions) -> Vec<u8> {
+    let mut extra = pattern.to_vec();
+    extra.push(0);
+    for (on, letter) in [
+        (options.dot, b'd'),
+        (options.absolute, b'a'),
+        (options.only_files, b'f'),
+        (options.follow_symlinks, b'l'),
+        (options.error_on_broken_symlinks, b'e'),
+    ] {
+        if on {
+            extra.push(letter);
+        }
+    }
+    extra
+}
+
+fn glob(root: &Root, cwd: &[u8], extra: &[u8]) -> Option<Vec<Vec<u8>>> {
+    let split = extra.iter().position(|&c| c == 0)?;
+    let (pattern, flags) = (&extra[..split], &extra[split + 1..]);
+    let has = |letter: u8| flags.contains(&letter);
+    let mut walker = bun_glob::walk::GlobWalker::<bun_glob::walk::SyscallAccessor, false>::init_with_cwd(
+        pattern,
+        cwd,
+        has(b'd'),
+        has(b'a'),
+        has(b'l'),
+        has(b'e'),
+        has(b'f'),
+        None,
+    )
+    .ok()?
+    .ok()?;
+    walker.walk().ok()?.ok()?;
+    Some(
+        walker
+            .matched_paths
+            .keys()
+            .iter()
+            .map(|it| from_root(root, it))
+            .collect(),
+    )
+}
