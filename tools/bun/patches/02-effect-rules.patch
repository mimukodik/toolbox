index 0000000..1dcc399
--- /dev/null
+++ b/src/lint/driver/effect.rs
@@ -0,0 +1,80 @@
+use crate::configs::Flavor;
+use crate::lint::Context;
+use crate::typed::Typed;
+use bun_lint::context::Severity;
+use bun_lint::linter::{ConfiguredRule, ResolvedConfig};
+use bun_lint_plugins::effect::EffectSeverity;
+use bun_sema::json::Json;
+use bun_sema::resolve::ScriptKind;
+use bun_sema::util::FxHashMap;
+use bun_threading::Guarded;
+use std::sync::Arc;
+
+const RULES: &[(&[u8], &[u8])] = &[(b"floatingEffect", b"bun/floating-effect")];
+
+pub(crate) fn may_use_effect_plugin(flavor: Flavor, type_aware: Option<bool>, path: &[u8]) -> bool {
+    // With built-in lint, a native rule can request types independently of the Effect plugin.
+    // The caller still checks the effective lint config, including Oxlint's typeAware setting.
+    matches!((flavor, type_aware), (Flavor::BuiltIn, Some(true)) | (Flavor::Oxlint, _))
+        && matches!(ScriptKind::from_file_name(path), Some(ScriptKind::Ts | ScriptKind::Tsx))
+}
+
+fn effect_severities(plugins: &Json) -> Option<Vec<EffectSeverity>> {
+    let plugin = plugins.as_array()?.iter().find(|plugin| {
+        plugin.get(b"name").and_then(Json::as_str) == Some(b"@effect/language-service")
+    })?;
+    if matches!(plugin.get(b"diagnostics"), Some(Json::Bool(false))) {
+        return None;
+    }
+    let settings = plugin.get(b"diagnosticSeverity");
+    Some(
+        RULES.iter()
+            .map(|(name, _)| {
+                settings
+                    .and_then(|it| it.get(name))
+                    .and_then(Json::as_str)
+                    .map_or(EffectSeverity::Error, EffectSeverity::parse)
+            })
+            .collect(),
+    )
+}
+
+type ConfigKey = (usize, Vec<EffectSeverity>);
+
+#[derive(Default)]
+pub(crate) struct EffectConfigs(Guarded<FxHashMap<ConfigKey, Arc<ResolvedConfig>>>);
+
+impl EffectConfigs {
+    pub(crate) fn for_file(
+        &self,
+        target: &Typed<'_>,
+        plugins: Option<&Json>,
+        context: &Context<'_, '_>,
+    ) -> Option<Arc<ResolvedConfig>> {
+        if !target.effect_plugin {
+            return None;
+        }
+        let severities = effect_severities(plugins?)?;
+        let config = target.config;
+        let key = (Arc::as_ptr(config) as usize, severities);
+        let mut configs = self.0.lock();
+        if let Some(config) = configs.get(&key) {
+            return Some(Arc::clone(config));
+        }
+        let additions = RULES.iter().zip(&key.1).filter_map(|((_, name), severity)| {
+            let rule = config.find_rule(context.linter.registry(), name)?;
+            if config.rule(rule).is_some() {
+                return None;
+            }
+            // The rule must still be available for directives that enable it in this file.
+            let (severity, options): (Severity, Arc<[Json]>) = match severity.visible() {
+                Some(severity) => (severity, Arc::from([])),
+                None => (Severity::Warn, Arc::from([Json::Bool(true)])),
+            };
+            Some(ConfiguredRule::new(rule, severity, options))
+        });
+        let augmented = Arc::new(config.with_added_rules(additions));
+        configs.insert(key, Arc::clone(&augmented));
+        Some(augmented)
+    }
+}
diff --git a/src/lint/plugins/effect/mod.rs b/src/lint/plugins/effect/mod.rs
new file mode 100644
index 0000000..ddb22ec
--- /dev/null
+++ b/src/lint/plugins/effect/mod.rs
@@ -0,0 +1,170 @@
+use bstr::ByteSlice;
+use bun_lint::context::Severity;
+
+// Directive syntax and precedence adapted from Effect-TS/tsgo (MIT),
+// crates/ets_directives/src/parser.rs at 0e722d359c969bdf1b1316f08e8637022cde3cce.
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+pub enum EffectSeverity {
+    Error,
+    Warn,
+    Suggestion,
+    Message,
+    Off,
+    SkipFile,
+}
+
+impl EffectSeverity {
+    pub fn parse(text: &[u8]) -> Self {
+        match text.trim_ascii().to_ascii_lowercase().as_slice() {
+            b"warning" | b"warn" => Self::Warn,
+            b"suggestion" => Self::Suggestion,
+            b"message" => Self::Message,
+            b"off" => Self::Off,
+            b"skip-file" => Self::SkipFile,
+            _ => Self::Error,
+        }
+    }
+
+    pub fn visible(self) -> Option<Severity> {
+        // Effect's TSRS patch 180 forwards only errors and warnings to the lint command.
+        match self {
+            Self::Error => Some(Severity::Error),
+            Self::Warn => Some(Severity::Warn),
+            Self::Suggestion | Self::Message | Self::Off | Self::SkipFile => None,
+        }
+    }
+}
+
+/// The directives that can affect one rule, in source order.
+#[derive(Default)]
+pub struct Directives {
+    skip_file: bool,
+    next_line: Vec<(u32, EffectSeverity)>,
+    sections: Vec<(u32, EffectSeverity)>,
+}
+
+impl Directives {
+    pub(crate) fn parse(source: &[u8], rule: &[u8]) -> Self {
+        let mut directives = Self::default();
+        if source.find(MARKER).is_none() {
+            return directives;
+        }
+        for (line, text) in source.split(|&byte| byte == b'\n').enumerate() {
+            let Some((next_line, pairs)) = directive(text) else {
+                continue;
+            };
+            let mut matched = None;
+            let mut has_skip_file = false;
+            for (name, severity) in rule_severities(pairs) {
+                let applies = name == b"*" || name.eq_ignore_ascii_case(rule);
+                if severity == EffectSeverity::SkipFile {
+                    has_skip_file = true;
+                    if applies {
+                        directives.skip_file = true;
+                        return directives;
+                    }
+                }
+                if applies && matched.is_none() {
+                    matched = Some(severity);
+                }
+            }
+            let Some(severity) = matched else { continue };
+            let line = line as u32 + 1;
+            if next_line {
+                directives.next_line.push((line + 1, severity));
+            } else if !has_skip_file {
+                directives.sections.push((line, severity));
+            }
+        }
+        directives
+    }
+
+    pub(crate) fn skips_file(&self, hidden_by_default: bool) -> bool {
+        self.skip_file
+            || (hidden_by_default
+                && !self.sections.iter().chain(&self.next_line).any(|(_, severity)| {
+                    severity.visible().is_some()
+                }))
+    }
+
+    pub(crate) fn severity_at(&self, line: u32) -> Option<EffectSeverity> {
+        let next = self.next_line.partition_point(|&(at, _)| at < line);
+        let section = self.sections.partition_point(|&(at, _)| at <= line);
+        self.next_line
+            .get(next)
+            .filter(|&&(at, _)| at == line)
+            .or_else(|| section.checked_sub(1).and_then(|i| self.sections.get(i)))
+            .map(|&(_, severity)| severity)
+    }
+}
+
+fn word(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric() || byte == b'_'
+}
+
+fn space(byte: u8) -> bool {
+    matches!(byte, b' ' | b'\t' | b'\r' | 0x0C)
+}
+
+fn pair_char(byte: u8) -> bool {
+    word(byte) || matches!(byte, b':' | b'-' | b'*')
+}
+
+const MARKER: &[u8] = b"@effect-diagnostics";
+
+fn directive(line: &[u8]) -> Option<(bool, &[u8])> {
+    let mut rest = line;
+    while let Some(start) = rest.find(MARKER) {
+        rest = &rest[start + MARKER.len()..];
+        let next = rest.strip_prefix(b"-next-line");
+        let payload = next.unwrap_or(rest);
+        // -in-tsgo has no rule:severity meaning in Effect's directive parser.
+        if !payload.first().copied().is_some_and(space) {
+            continue;
+        }
+        let start = payload.iter().position(|&byte| !space(byte))?;
+        let payload = &payload[start..];
+        if !pair_char(payload[0]) {
+            continue;
+        }
+        let end = payload
+            .iter()
+            .position(|&byte| !pair_char(byte) && !space(byte))
+            .unwrap_or(payload.len());
+        return Some((next.is_some(), &payload[..end]));
+    }
+    None
+}
+
+fn rule_severities(mut pairs: &[u8]) -> impl Iterator<Item = (&[u8], EffectSeverity)> {
+    std::iter::from_fn(move || {
+        while let Some(colon) = pairs.iter().position(|&byte| byte == b':') {
+            let (prefix, value) = pairs.split_at(colon);
+            pairs = &value[1..];
+            let name = if prefix.ends_with(b"*") {
+                b"*"
+            } else {
+                prefix.rsplit(|&byte| !word(byte)).next().unwrap_or_default()
+            };
+            let (first, rest) = take_word(pairs);
+            if name.is_empty() || first.is_empty() {
+                continue;
+            }
+            let tail_len = rest
+                .strip_prefix(b"-")
+                .map(|tail| take_word(tail).0.len())
+                .filter(|&len| len != 0)
+                .map_or(0, |len| len + 1);
+            let (value, rest) = pairs.split_at(first.len() + tail_len);
+            pairs = rest;
+            return Some((name, EffectSeverity::parse(value)));
+        }
+        None
+    })
+}
+
+fn take_word(text: &[u8]) -> (&[u8], &[u8]) {
+    let end = text.iter().position(|&byte| !word(byte)).unwrap_or(text.len());
+    text.split_at(end)
+}
diff --git a/src/lint/plugins/rules/bun_floating_effect.rs b/src/lint/plugins/rules/bun_floating_effect.rs
new file mode 100644
index 0000000..10ee56e
--- /dev/null
+++ b/src/lint/plugins/rules/bun_floating_effect.rs
@@ -0,0 +1,106 @@
+use crate::effect::Directives;
+use bun_lint::prelude::*;
+use bun_lint::rule::Plugin;
+use bun_lint::types::Type;
+
+/// Detects Effect values that are neither yielded nor assigned.
+pub struct FloatingEffect {
+    hidden_by_default: bool,
+}
+
+const FLOATING_EFFECT: &Message = &Message::new(
+    "floatingEffect",
+    "This Effect value is neither yielded nor used in an assignment.",
+);
+
+const FLOATING_EFFECT_ABLE: &Message = &Message::new(
+    "floatingEffectAble",
+    "This Effect-able `{{type}}` value is neither yielded nor assigned to a variable.",
+);
+
+const EFFECT: &[u8] = b"~effect/Effect";
+const STREAM: &[u8] = b"~effect/Stream";
+
+fn has_variance_fields(variance: Type) -> bool {
+    [&b"_A"[..], b"_E", b"_R"].into_iter().all(|name| {
+        variance.get_type_of_property(name).is_some_and(|field| {
+            let signatures = field.get_call_signatures();
+            signatures.len() == 1
+                && signatures
+                    .first()
+                    .is_some_and(|signature| signature.type_parameters().is_empty())
+        })
+    })
+}
+
+impl Rule for FloatingEffect {
+    const META: Meta = Meta::plugin(Plugin::Bun, "floating-effect", Kind::Problem).requires_types();
+    const ON: On = On::new().stmts(&[StmtTag::Expr]);
+    type State<'a> = Directives;
+
+    fn new(options: &Options) -> Self {
+        Self {
+            hidden_by_default: options.bool(0) == Some(true),
+        }
+    }
+
+    fn start<'a>(&self, file: &'a File<'a>) -> Option<Self::State<'a>> {
+        let directives = Directives::parse(file.text(), b"floatingEffect");
+        (!directives.skips_file(self.hidden_by_default)).then_some(directives)
+    }
+
+    fn stmt<'a>(&self, stmt: Stmt<'a>, cx: &mut Cx<'a, Self>) {
+        let StmtKind::Expr(expr) = stmt.kind() else {
+            return;
+        };
+        if stmt.is_wrapper() || matches!(expr.tag(), ExprTag::Assign) {
+            return;
+        }
+
+        let ty = expr.ty();
+        if let Some(variance) = ty.get_type_of_property(EFFECT) {
+            // The v4 checker also uses the variance struct on some Effect subtypes.
+            if ty.get_property(b"_tag").is_some()
+                || ty.get_property(b"get").is_some()
+                || (ty.get_property(b"await").is_some() && ty.get_property(b"poll").is_some())
+                || !has_variance_fields(variance)
+            {
+                return;
+            }
+        } else if !ty
+            .get_type_of_property(STREAM)
+            .is_some_and(has_variance_fields)
+        {
+            return;
+        }
+
+        // Effect asks TypeScript for the diagnostic span of the expression. For
+        // a satisfies expression, TypeScript's scanner points at its keyword.
+        let span = expr
+            .as_satisfies()
+            .and_then(|(operand, annotation)| {
+                cx.file().tokens_between(operand.outer_span(), annotation)
+                    .find(|token| token.text() == b"satisfies")
+            })
+            .map_or(expr.outer_span(), |token| token.span());
+
+        let severity = match cx.state.severity_at(cx.line_of(span.start)) {
+            Some(severity) => match severity.visible() {
+                Some(severity) => Some(severity),
+                None => return,
+            },
+            None if self.hidden_by_default => return,
+            None => None,
+        };
+        let strict = ty.symbol().is_some_and(|symbol| symbol.name() == b"Effect");
+        let message = if strict { FLOATING_EFFECT } else { FLOATING_EFFECT_ABLE };
+        let report = cx.report(span, message);
+        let report = match severity {
+            Some(severity) => report.with_severity(severity),
+            None => report,
+        };
+        if !strict {
+            report.data("type", ty.to_text());
+        }
+    }
+}
