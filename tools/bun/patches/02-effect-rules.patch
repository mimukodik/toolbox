+++ b/src/lint/plugins/effect/rules/bun_global_error_in_effect_catch.rs
@@ -0,0 +1,35 @@
+use crate::effect::{effect_rule, report, type_parser};
+use bun_lint::prelude::*;
+
+const MESSAGE: &Message = &Message::new(
+    "globalErrorInEffectCatch",
+    "The `catch` callback in `{{callee}}` returns the global `Error` type. Untagged errors merge together in the Effect error channel and lose type-level distinction; a tagged error preserves that distinction and can wrap the original error in a `cause` property.",
+);
+
+effect_rule!(
+    GlobalErrorInEffectCatch,
+    b"globalErrorInEffectCatch",
+    "global-error-in-effect-catch",
+    On::new().exprs(&[ExprTag::Call]).optional_chains(),
+    fn expr<'a>(&self, expr: Expr<'a>, cx: &mut Cx<'a, Self>) {
+        let call = expr.ts_node();
+        let mut output = type_parser::catch_return_types(call);
+        let Some(first) = output.next() else { return };
+        let Some(global) = type_parser::global_error(cx.file().type_checker()) else {
+            return;
+        };
+        if std::iter::once(first)
+            .chain(output)
+            .any(|ty| type_parser::is_global_error(ty, global))
+            && let Some(callee) = call.expression()
+            && let Some(report) = report(cx, self.hidden_by_default, callee.span(), MESSAGE)
+        {
+            report.data("callee", callee.get_source_text());
+        }
+    },
+    fn optional_chain<'a>(&self, expr: Expr<'a>, cx: &mut Cx<'a, Self>) {
+        if expr.tag() == ExprTag::Call {
+            self.expr(expr, cx);
+        }
+    }
+);
