@@ -0,0 +1,32 @@
+use crate::effect::{effect_rule, report, type_parser};
+use bun_lint::prelude::*;
+
+const MESSAGE: &Message = &Message::new(
+    "globalErrorInEffectFailure",
+    "Global 'Error' loses type safety as untagged errors merge together in the Effect failure channel. Consider using a tagged error and optionally wrapping the original in a 'cause' property.",
+);
+
+effect_rule!(
+    GlobalErrorInEffectFailure,
+    b"globalErrorInEffectFailure",
+    "global-error-in-effect-failure",
+    On::new().exprs(&[ExprTag::New]),
+    fn expr<'a>(&self, expr: Expr<'a>, cx: &mut Cx<'a, Self>) {
+        let Some(global) = type_parser::global_error(cx.file().type_checker()) else {
+            return;
+        };
+        if !type_parser::is_global_error(expr.ty(), global) {
+            return;
+        }
+        // Stop at the nearest enclosing Effect, even if its error channel is different.
+        let Some(effect) = expr.ts_node().ancestors().find_map(type_parser::effect_at) else {
+            return;
+        };
+        if type_parser::union_members(effect.error)
+            .into_iter()
+            .any(|ty| type_parser::is_global_error(ty, global))
+        {
+            let _ = report(cx, self.hidden_by_default, expr.ts_node().span(), MESSAGE);
+        }
+    }
+);
