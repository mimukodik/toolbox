+use crate::effect::{effect_rule, report, type_parser};
+use bun_lint::prelude::*;
+use bun_lint::types::TypeFlags;
+
+const MESSAGE: &Message = &Message::new(
+    "unknownInEffectCatch",
+    "The `catch` callback in `{{callee}}` returns `unknown`, so the Effect error type stays untyped. A specific typed error preserves error-channel information, for example by narrowing the value or wrapping it in `Data.TaggedError`.",
+);
+
+effect_rule!(
+    UnknownInEffectCatch,
+    b"unknownInEffectCatch",
+    "unknown-in-effect-catch",
+    On::new().exprs(&[ExprTag::Call]).optional_chains(),
+    fn expr<'a>(&self, expr: Expr<'a>, cx: &mut Cx<'a, Self>) {
+        let call = expr.ts_node();
+        if type_parser::catch_return_types(call).any(|ty| ty.has_flags(TypeFlags::ANY | TypeFlags::UNKNOWN))
+            && let Some(callee) = call.expression()
+            && let Some(report) = report(cx, self.hidden_by_default, callee.span(), MESSAGE)
+        {
+            report.data("callee", callee.get_source_text());
+        }
+    },
+    fn optional_chain<'a>(&self, expr: Expr<'a>, cx: &mut Cx<'a, Self>) {
+        if expr.tag() == ExprTag::Call {
+            self.expr(expr, cx);
+        }
+    }
+);
diff --git a/src/lint/plugins/effect/rules/bun_unsafe_effect_type_assertion.rs b/src/lint/plugins/effect/rules/bun_unsafe_effect_type_assertion.rs
new file mode 100644
index 0000000..4ab7da6
--- /dev/null
+++ b/src/lint/plugins/effect/rules/bun_unsafe_effect_type_assertion.rs
@@ -0,0 +1,39 @@
+use crate::effect::{effect_rule, report, type_parser};
+use bun_lint::prelude::*;
+use bun_lint::types::{SyntaxKind as TsKind, TsNode, Type, TypeFlags};
+
+const MESSAGE: &Message = &Message::new(
+    "unsafeEffectTypeAssertion",
+    "This type assertion unsafely narrows the error or requirements channels.",
+);
+
+fn channels(node: TsNode<'_>) -> Option<type_parser::Channels<'_>> {
+    let ty = type_parser::type_at(node)?;
+    type_parser::effect(ty)
+        .or_else(|| type_parser::stream(ty))
+        .or_else(|| type_parser::layer(ty))
+}
+
+fn narrows<'a>(original: Type<'a>, asserted: Type<'a>) -> bool {
+    !original.has_flags(TypeFlags::ANY) && !original.is_assignable_to(asserted)
+}
+
+effect_rule!(
+    UnsafeEffectTypeAssertion,
+    b"unsafeEffectTypeAssertion",
+    "unsafe-effect-type-assertion",
+    On::new().exprs(&[ExprTag::As]),
+    fn expr<'a>(&self, expr: Expr<'a>, cx: &mut Cx<'a, Self>) {
+        let assertion = expr.ts_node();
+        if !matches!(assertion.kind(), TsKind::AsExpression | TsKind::TypeAssertionExpression) {
+            return;
+        }
+        let Some(original) = assertion.expression().and_then(channels) else {
+            return;
+        };
+        let Some(asserted) = channels(assertion) else { return };
+        if narrows(original.error, asserted.error) || narrows(original.requirements, asserted.requirements) {
+            let _ = report(cx, self.hidden_by_default, assertion.span(), MESSAGE);
+        }
+    }
+);
diff --git a/src/lint/plugins/effect/type_parser.rs b/src/lint/plugins/effect/type_parser.rs
new file mode 100644
index 0000000..2bc2f98
--- /dev/null
+++ b/src/lint/plugins/effect/type_parser.rs
@@ -0,0 +1,224 @@
+// Adapted from Effect's MIT-licensed ets_typeparser at 0e722d359c969bdf1b1316f08e8637022cde3cce.
+// Bun's typed handles delegate these queries to the checker for the current file.
+use bun_lint::types::{
+    NodeFlags, Signature, SymbolFlags, SyntaxKind as Kind, TsNode, TsSymbol, Type, TypeFlags, Types,
+};
+use std::collections::HashSet;
+
+pub(super) use bun_lint::types::tsutils::union_constituents as union_members;
+
+#[derive(Clone, Copy)]
+pub(super) struct Channels<'a> {
+    // Success for Effect and Stream, provided services for Layer.
+    pub(super) _output: Type<'a>,
+    pub(super) error: Type<'a>,
+    pub(super) requirements: Type<'a>,
+}
+
+const EFFECT: &[u8] = b"~effect/Effect";
+const STREAM: &[u8] = b"~effect/Stream";
+const LAYER: &[u8] = b"~effect/Layer";
+
+fn variance_field<'a>(variance: Type<'a>, name: &[u8]) -> Option<Signature<'a>> {
+    let signatures = variance.get_type_of_property(name)?.get_call_signatures();
+    let signature = signatures.first()?;
+    (signatures.len() == 1 && signature.type_parameters().is_empty()).then_some(signature)
+}
+
+fn effect_channels(variance: Type<'_>) -> Option<Channels<'_>> {
+    Some(Channels {
+        _output: variance_field(variance, b"_A")?.get_return_type(),
+        error: variance_field(variance, b"_E")?.get_return_type(),
+        requirements: variance_field(variance, b"_R")?.get_return_type(),
+    })
+}
+
+pub(super) fn has_effect_type_id(ty: Type<'_>) -> bool {
+    ty.get_type_of_property(EFFECT).is_some()
+}
+
+pub(super) fn effect(ty: Type<'_>) -> Option<Channels<'_>> {
+    effect_channels(ty.get_type_of_property(EFFECT)?)
+}
+
+fn is_strict_effect(ty: Type<'_>) -> bool {
+    ty.get_symbol().is_some_and(|symbol| symbol.name() == b"Effect")
+}
+
+pub(super) fn strict_effect(ty: Type<'_>) -> Option<Channels<'_>> {
+    if !is_strict_effect(ty) {
+        return None;
+    }
+    effect(ty)
+}
+
+pub(super) fn stream(ty: Type<'_>) -> Option<Channels<'_>> {
+    effect_channels(ty.get_type_of_property(STREAM)?)
+}
+
+pub(super) fn layer(ty: Type<'_>) -> Option<Channels<'_>> {
+    let variance = ty.get_type_of_property(LAYER)?;
+    Some(Channels {
+        _output: variance_field(variance, b"_ROut")?.get_parameters().first()?.get_type(),
+        error: variance_field(variance, b"_E")?.get_return_type(),
+        requirements: variance_field(variance, b"_RIn")?.get_return_type(),
+    })
+}
+
+pub(super) fn is_fiber(ty: Type<'_>) -> bool {
+    ty.get_property(b"await").is_some() && ty.get_property(b"poll").is_some()
+}
+
+pub(super) fn is_effect_subtype(ty: Type<'_>) -> bool {
+    ty.get_property(b"_tag").is_some() || ty.get_property(b"get").is_some()
+}
+
+pub(super) fn effect_at(node: TsNode<'_>) -> Option<Channels<'_>> {
+    effect(type_at(node)?)
+}
+
+pub(super) fn type_at(node: TsNode<'_>) -> Option<Type<'_>> {
+    match node.kind() {
+        Kind::ArrayLiteralExpression
+        | Kind::ArrowFunction
+        | Kind::FunctionExpression
+        | Kind::NumericLiteral
+        | Kind::BigIntLiteral
+        | Kind::TemplateExpression
+        | Kind::NoSubstitutionTemplateLiteral
+        | Kind::TrueKeyword
+        | Kind::FalseKeyword
+        | Kind::NullKeyword
+        | Kind::RegularExpressionLiteral
+        | Kind::PrefixUnaryExpression
+        | Kind::VoidExpression
+        | Kind::TypeOfExpression => return None,
+        Kind::StringLiteral if node.parent().is_none_or(|parent| parent.name() != Some(node)) => return None,
+        _ => {}
+    }
+    let ty = node.get_type_at_location();
+    (!ty.is_error() && !ty.is_unresolved()).then_some(ty)
+}
+
+/// This node's type is also checked when the rule visits its syntactic counterpart.
+pub(super) fn has_equivalent_node(node: TsNode<'_>) -> bool {
+    if matches!(node.kind(), Kind::ParenthesizedExpression | Kind::SatisfiesExpression) {
+        return true;
+    }
+    node.kind() == Kind::Identifier
+        && node.parent().is_some_and(|parent| {
+            parent.name() == Some(node)
+                && matches!(
+                    parent.kind(),
+                    Kind::PropertyAccessExpression
+                        | Kind::VariableDeclaration
+                        | Kind::Parameter
+                        | Kind::PropertyDeclaration
+                        | Kind::PropertyAssignment
+                        | Kind::ShorthandPropertyAssignment
+                )
+        })
+}
+
+pub(super) fn global_error(types: Types<'_>) -> Option<Type<'_>> {
+    // Scope the lookup to a standard-library declaration so a project's local Error
+    // binding does not take precedence over the global interface.
+    let library = types
+        .get_string_type()
+        .get_property(b"charAt")?
+        .declarations()
+        .find(|decl| decl.get_source_file().is_default_library())?
+        .get_source_file();
+    Some(
+        types
+            .get_symbol_in_scope(library.node(), SymbolFlags::TYPE, b"Error")?
+            .get_declared_type(),
+    )
+}
+
+pub(super) fn is_global_error<'a>(ty: Type<'a>, global: Type<'a>) -> bool {
+    !ty.has_flags(TypeFlags::ANY | TypeFlags::UNKNOWN) && ty.is_assignable_to(global) && global.is_assignable_to(ty)
+}
+
+fn reference_symbol(node: TsNode<'_>) -> Option<TsSymbol<'_>> {
+    let node = skip_parentheses(node);
+    match node.kind() {
+        Kind::Identifier | Kind::PropertyAccessExpression | Kind::ElementAccessExpression => {}
+        _ => return None,
+    }
+    let mut symbol = symbol_at(node)?;
+    if node.kind() != Kind::Identifier {
+        return Some(symbol);
+    }
+    let mut seen = HashSet::new();
+    while let Some(declaration) = symbol.value_declaration() {
+        if declaration.kind() != Kind::VariableDeclaration
+            || !declaration.parent().is_some_and(|list| {
+                list.kind() == Kind::VariableDeclarationList && list.flags().contains(NodeFlags::CONST)
+            })
+            || !seen.insert(symbol)
+        {
+            break;
+        }
+        let Some(initializer) = declaration.initializer() else {
+            break;
+        };
+        let Some(target) = symbol_at(skip_parentheses(initializer)) else {
+            break;
+        };
+        symbol = target;
+    }
+    Some(symbol)
+}
+
+fn skip_parentheses(mut node: TsNode<'_>) -> TsNode<'_> {
+    while node.kind() == Kind::ParenthesizedExpression {
+        let Some(inner) = node.expression() else { break };
+        node = inner;
+    }
+    node
+}
+
+fn symbol_at(node: TsNode<'_>) -> Option<TsSymbol<'_>> {
+    node.get_symbol_at_location()
+        .or_else(|| node.name()?.get_symbol_at_location())
+        .map(TsSymbol::get_aliased_symbol)
+        .map(TsSymbol::get_export_symbol)
+}
+
+/// Compare resolved export identity, including renamed imports and local const aliases.
+fn is_node_reference_to_effect_module_api(node: TsNode<'_>, names: &[&[u8]]) -> bool {
+    let Some(target) = reference_symbol(node) else {
+        return false;
+    };
+    target.declarations().any(|decl| {
+        let source = decl.get_source_file();
+        if !source
+            .package_name()
+            .is_some_and(|name| name.eq_ignore_ascii_case(b"effect"))
+        {
+            return false;
+        }
+        let Some(module) = source.symbol() else { return false };
+        let exports = module.get_exports_of_module();
+        exports.into_iter().any(|export| {
+            export.name() == b"Effect" && effect(export.get_aliased_symbol().get_declared_type()).is_some()
+        }) && exports
+            .into_iter()
+            .any(|export| names.contains(&export.name()) && export.get_aliased_symbol().get_export_symbol() == target)
+    })
+}
+
+pub(super) fn catch_return_types(call: TsNode<'_>) -> impl Iterator<Item = Type<'_>> {
+    const APIS: &[&[u8]] = &[b"tryPromise", b"try", b"tryMap", b"tryMapPromise"];
+    call.expression()
+        .filter(|&callee| is_node_reference_to_effect_module_api(callee, APIS))
+        .and_then(|_| call.get_resolved_signature()?.get_parameters().first())
+        .into_iter()
+        .flat_map(move |param| union_members(param.get_type_at_location(call)))
+        .filter_map(move |options| {
+            let catch = options.get_property(b"catch")?.get_type_at_location(call);
+            let output = catch.get_call_signatures().first()?.get_return_type();
+            (!output.is_error() && !output.is_unresolved()).then_some(output)
+        })
+}
diff --git a/test/cli/lint/effect.test.ts b/test/cli/lint/effect.test.ts
new file mode 100644
index 0000000..ce53d38
--- /dev/null
+++ b/test/cli/lint/effect.test.ts
@@ -0,0 +1,162 @@
+import { describe, expect, test } from "bun:test";
+import { bunEnv, bunExe, tempDir } from "harness";
+
+const env = { ...bunEnv, AGENT: "0", CLAUDECODE: undefined, GITHUB_ACTIONS: undefined, NO_COLOR: "1" };
+
+async function lint(files: Record<string, string>, args: string[]) {
+  using dir = tempDir("bun-lint-type-services", files);
+  await using proc = Bun.spawn({
+    cmd: [bunExe(), "lint", "-f", "unix", ...args],
+    env,
+    cwd: String(dir),
+    stdout: "pipe",
+    stderr: "pipe",
+  });
+  const [stdout, stderr, exitCode] = await Promise.all([proc.stdout.text(), proc.stderr.text(), proc.exited]);
+  const errors = [...stdout.matchAll(/^.*?:(\d+:\d+): (.*) \[Error\/.*\]$/gm)].map(it => `${it[1]} ${it[2]}`);
+  return { errors, stdout, stderr, exitCode };
+}
+
+const rule = (...names: string[]) => names.flatMap(name => ["--rule", `@typescript-eslint/${name}: error`]);
+const options = { types: [], lib: ["es2022"] };
+
+describe("Effect v4 floating statements", () => {
+  const floating = [
+    'interface Variance { _A: () => number; _E: () => never; _R: () => never; }',
+    'interface Effect { readonly "~effect/Effect": Variance; }',
+    'declare function make(): Effect;',
+    'make();',
+  ].join("\n");
+
+  function project(severity: string) {
+    return {
+      ".oxlintrc.json": JSON.stringify({ options: { typeAware: true }, categories: { correctness: "off" } }),
+      "tsconfig.json": '{ "extends": "./base.json", }',
+      "base.json": `{
+        // Keep the Effect configuration in an extended JSONC file.
+        "compilerOptions": {
+          "lib": ["es2022"],
+          "types": [],
+          "strict": true,
+          "plugins": [{ "name": "@effect/language-service", "diagnosticSeverity": { "floatingEffect": "${severity}" } }],
+        },
+      }`,
+      "src/a.ts": [
+        'interface Variance { _A: () => number; _E: () => never; _R: () => never; }',
+        'interface Effect { readonly "~effect/Effect": Variance; }',
+        'interface Stream { readonly "~effect/Stream": Variance; }',
+        'declare function make(): Effect;',
+        'declare function stream(): Stream;',
+        'declare function fiber(): Effect & { await: unknown; poll: unknown };',
+        'declare function exit(): Effect & { _tag: "Success" };',
+        'declare function pool(): Effect & { get: unknown };',
+        'declare function ordinary(): number;',
+        'declare function impostor(): { "~effect/Effect": { _A: number } };',
+        'make();',
+        'stream();',
+        'export let kept = make();',
+        'kept = make();',
+        'export function returned() { return make(); }',
+        'for (make(); false;) {}',
+        'fiber();',
+        'exit();',
+        'pool();',
+        'ordinary();',
+        'impostor();',
+      ].join("\n"),
+    };
+  }
+
+  test.concurrent("recognizes Effect and Stream for explicit files, directories and glob matches", async () => {
+    for (const target of ["src/a.ts", "src", "src/**/*.ts"]) {
+      const { errors, exitCode } = await lint(project("error"), [target]);
+      expect(errors).toEqual([
+        "11:1 This Effect value is neither yielded nor used in an assignment.",
+        "12:1 This Effect-able `Stream` value is neither yielded nor assigned to a variable.",
+      ]);
+      expect(exitCode).toBe(1);
+    }
+  });
+
+  test.concurrent("an explicitly enabled native typed rule does not activate the Effect plugin", async () => {
+    const files = {
+      "tsconfig.json": JSON.stringify({
+        compilerOptions: { ...options, strict: true, plugins: [{ name: "@effect/language-service" }] },
+      }),
+      "a.ts": floating + '\nexport const shown = (value: { a: string }) => `${value}`;',
+    };
+    const args = [...rule("restrict-template-expressions"), "a.ts"];
+    const implicit = await lint(files, args);
+    expect(implicit.stdout).toContain("Invalid type");
+    expect(implicit.stdout).not.toContain("bun/floating-effect");
+
+    const enabled = await lint(files, ["--type-aware", ...args]);
+    expect(enabled.stdout).toContain("[Error/bun/floating-effect]");
+  });
+
+  test.concurrent("uses project severity and respects off", async () => {
+    const warned = await lint(project("warning"), ["src"]);
+    expect(warned.stdout).toContain("[Warning/bun(floating-effect)]");
+    expect(warned.exitCode).toBe(0);
+    const disabled = await lint(project("off"), ["src"]);
+    expect(disabled.stdout).not.toContain("bun(floating-effect)");
+    expect(disabled.exitCode).toBe(0);
+  });
+
+  test.concurrent("applies Effect directives at the report location", async () => {
+    const declaration = floating.split("\n").slice(0, 3).join("\n") + " export {};";
+    const files = {
+      ...project("off"),
+      "src/a.ts": [
+        declaration,
+        'make();',
+        '// @effect-diagnostics-next-line FLOATINGEFFECT:warning',
+        'make();',
+        'make();',
+        '// @effect-diagnostics *:error',
+        'make() satisfies Effect;',
+        '// @effect-diagnostics-in-tsgo false',
+        'make();',
+        '// @effect-diagnostics-next-line floatingEffect:message',
+        'make();',
+        '// @effect-diagnostics floatingEffect:suggestion',
+        'make();',
+      ].join("\n"),
+      "src/skip.ts": [
+        declaration,
+        'make();',
+        '// @effect-diagnostics *:skip-file',
+        '// @effect-diagnostics-next-line floatingEffect:error',
+        'make();',
+      ].join("\n"),
+    };
+    const { errors, stdout, exitCode } = await lint(files, ["src"]);
+    const message = "This Effect value is neither yielded nor used in an assignment.";
+    expect(errors).toEqual([`9:8 ${message}`, `11:1 ${message}`]);
