index 0000000..4b7eb72
--- /dev/null
+++ b/src/lint/plugins/effect/rules/bun_any_unknown_in_error_context.rs
@@ -0,0 +1,125 @@
+use crate::effect::{effect_rule, report, type_parser};
+use bun_lint::prelude::*;
+use bun_lint::types::{SyntaxKind as TsKind, TsNode, Type, TypeFlags};
+
+const MESSAGE: &Message = &Message::new("anyUnknownInErrorContext", "{{details}}");
+
+#[derive(Clone, Copy)]
+struct FlaggedChannels {
+    error: TypeFlags,
+    requirements: TypeFlags,
+}
+
+impl FlaggedChannels {
+    fn covers(self, other: Self) -> bool {
+        (other.error.is_empty() || self.error == other.error)
+            && (other.requirements.is_empty() || self.requirements == other.requirements)
+    }
+
+    fn message(self) -> String {
+        fn label(flags: TypeFlags) -> &'static str {
+            if flags.contains(TypeFlags::ANY) {
+                "any"
+            } else {
+                "unknown"
+            }
+        }
+        let mut descriptions = Vec::new();
+        if !self.requirements.is_empty() {
+            descriptions.push(format!("{} in the requirements channel", label(self.requirements)));
+        }
+        if !self.error.is_empty() {
+            descriptions.push(format!("{} in the error channel", label(self.error)));
+        }
+        let mut message = format!("This has {} which is not recommended.", descriptions.join(" and "));
+        if !self.requirements.is_empty() {
+            message.push_str("\nOnly service identifiers should appear in the requirements channel.");
+        }
+        if !self.error.is_empty() {
+            message.push_str("\nHaving an unknown or any error type is not useful. Consider instead using specific error types baked by Data.TaggedError for example.");
+        }
+        message
+    }
+}
+
+fn channels(ty: Type<'_>) -> Option<type_parser::Channels<'_>> {
+    type_parser::strict_effect(ty).or_else(|| type_parser::layer(ty))
+}
+
+fn ignore_subtree(node: TsNode<'_>) -> bool {
+    match node.kind() {
+        TsKind::TypeAliasDeclaration | TsKind::InterfaceDeclaration => true,
+        TsKind::AsExpression => node.type_node().is_some_and(|ty| ty.kind() == TsKind::AnyKeyword),
+        TsKind::Parameter | TsKind::PropertyDeclaration | TsKind::VariableDeclaration => node
+            .type_node()
+            .is_some_and(|ty| channels(ty.get_type_from_type_node()).is_some()),
+        _ => false,
+    }
+}
+
+effect_rule!(
+    AnyUnknownInErrorContext,
+    b"anyUnknownInErrorContext",
+    "any-unknown-in-error-context",
+    On::new().finish(),
+    fn finish(&self, cx: &mut Cx<'_, Self>) {
+        let file = cx.file();
+        let root = file.type_checker().ts_node(file);
+        let mut pending: Vec<_> = root.children().collect();
+        let mut matches: Vec<(Span, FlaggedChannels)> = Vec::new();
+
+        while let Some(node) = pending.pop() {
+            let kind = node.kind();
+            if kind.is_type_node() {
+                // A class extends clause has a type-shaped wrapper around an expression.
+                if kind == TsKind::ExpressionWithTypeArguments
+                    && node.parent().is_some_and(|clause| {
+                        clause.kind() == TsKind::HeritageClause
+                            && clause.parent().is_some_and(|class| class.kind().is_class_like())
+                    })
+                {
+                    pending.extend(node.expression());
+                }
+                continue;
+            }
+            if ignore_subtree(node) {
+                continue;
+            }
+
+            pending.extend(node.children());
+            if type_parser::has_equivalent_node(node) {
+                continue;
+            }
+            let ty = if kind == TsKind::CallExpression {
+                node.get_resolved_signature().map(|sig| sig.get_return_type())
+            } else {
+                type_parser::type_at(node)
+            };
+            let Some(effect) = ty.and_then(channels) else { continue };
+            let mask = TypeFlags::ANY | TypeFlags::UNKNOWN;
+            let flagged = FlaggedChannels {
+                error: effect.error.flags() & mask,
+                requirements: effect.requirements.flags() & mask,
+            };
+            if flagged.error.is_empty() && flagged.requirements.is_empty() {
+                continue;
+            }
+            let span = node.span();
+            if span.start >= span.end {
+                continue;
+            }
+            // Drop a containing match only if this node reports all of its channels
+            // with the same flags. An outer match can contribute a distinct finding.
+            matches.retain(|&(outer, previous)| {
+                !(outer.start <= span.start && span.end <= outer.end && flagged.covers(previous))
+            });
+            matches.push((span, flagged));
+        }
+
+        for (span, flags) in matches {
+            if let Some(report) = report(cx, self.hidden_by_default, span, MESSAGE) {
+                report.data("details", flags.message());
+            }
+        }
+    }
+);
