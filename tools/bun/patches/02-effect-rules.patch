@@ -0,0 +1,55 @@
+use crate::effect::{effect_rule, report, type_parser};
+use bun_lint::prelude::*;
+use std::collections::HashSet;
+
+const MESSAGE: &Message = &Message::new(
+    "effectInFailure",
+    "The error channel contains an Effect ({{type}}). Putting Effect computations in the failure channel is not intended; keep only failure types there.",
+);
+
+effect_rule!(
+    EffectInFailure,
+    b"effectInFailure",
+    "effect-in-failure",
+    On::new().finish(),
+    fn finish(&self, cx: &mut Cx<'_, Self>) {
+        let file = cx.file();
+        let root = file.type_checker().ts_node(file);
+        let mut pending: Vec<_> = root.children().map(|child| (child, false)).collect();
+        let mut matched_children = HashSet::new();
+
+        while let Some((node, visited)) = pending.pop() {
+            // Post-order keeps the report on the innermost Effect and propagates
+            // that match through all ancestors, even non-Effect nodes.
+            if !visited {
+                pending.push((node, true));
+                pending.extend(node.children().map(|child| (child, false)));
+                continue;
+            }
+            if matched_children.remove(&node) {
+                matched_children.extend(node.parent());
+                continue;
+            }
+            if type_parser::has_equivalent_node(node) {
+                continue;
+            }
+            let Some(effect) = type_parser::type_at(node).and_then(type_parser::strict_effect) else {
+                continue;
+            };
+            let Some(nested) = type_parser::union_members(effect.error)
+                .into_iter()
+                .find(|&ty| type_parser::strict_effect(ty).is_some())
+            else {
+                continue;
+            };
+            let span = node.span();
+            if span.start >= span.end {
+                continue;
+            }
+            if let Some(report) = report(cx, self.hidden_by_default, span, MESSAGE) {
+                report.data("type", nested.to_text());
+            }
+            matched_children.extend(node.parent());
+        }
+    }
+);
