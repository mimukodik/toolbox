@@ -0,0 +1,34 @@
+use crate::effect::{generator_context, report, type_parser};
+use bun_lint::prelude::*;
+
+const MESSAGE: &Message = &Message::new(
+    "missingStarInYieldEffectGen",
+    "This uses `yield` for an `Effect` value. `yield*` is the Effect-aware form in this context.",
+);
+
+effect_rule!(
+    MissingStarInYieldEffectGen,
+    b"missingStarInYieldEffectGen",
+    "missing-star-in-yield-effect-gen",
+    // ets_rules/src/missing_star_in_yield_effect_gen.rs:22–28,57–79.
+    On::new().exprs(&[ExprTag::Yield]),
+    fn expr<'a>(&self, expr: Expr<'a>, cx: &mut Cx<'a, Self>) {
+        let Some((Some(_), false)) = expr.as_yield() else {
+            return;
+        };
+        let node = expr.ts_node();
+        if let Some(generator) = generator_context::enclosing_generator(node, cx.file().modules())
+            && let Some(report) = report(
+                cx,
+                self.hidden_by_default,
+                type_parser::diagnostic_span(cx.file(), node),
+                MESSAGE,
+            )
+        {
+            report.label(
+                type_parser::diagnostic_span(cx.file(), generator),
+                "Inside this Effect generator.",
+            );
+        }
+    }
+);
