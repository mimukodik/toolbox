--- /dev/null
+++ b/src/lint/plugins/effect/generator_context.rs
@@ -0,0 +1,77 @@
+// Adapted from Effect's MIT-licensed ets_typeparser at 0e722d359c969bdf1b1316f08e8637022cde3cce.
+use super::type_parser::{Channels, effect, is_node_reference_to_effect_module_api, type_at};
+use bun_lint::ast::{Call, Expr, Node};
+use bun_lint::modules::Modules;
+use bun_lint::types::{SyntaxKind as Kind, TsNode};
+
+/// The generator whose body contains this node, if the nearest function is an Effect generator.
+pub(super) fn enclosing_generator<'a>(
+    node: TsNode<'a>,
+    modules: Option<&dyn Modules>,
+) -> Option<TsNode<'a>> {
+    let modules = modules?;
+
+    // Effect registers yield context on the body, then resets it at children of any nested function.
+    let mut child = node;
+    let generator = loop {
+        let parent = child.parent()?;
+        if parent.kind().is_function_like() {
+            if parent.kind() != Kind::FunctionExpression || child.kind() != Kind::Block {
+                return None;
+            }
+            break parent;
+        }
+        child = parent;
+    };
+
+    let Node::Expr(function) = generator.to_ast()? else {
+        return None;
+    };
+    if !function.as_fn()?.is_generator() {
+        return None;
+    }
+
+    let call = generator.parent()?;
+    let first_function = call_syntax(call)?
+        .args()
+        .iter()
+        .map(Expr::ts_node_with_parentheses)
+        .find(|arg| matches!(arg.kind(), Kind::ArrowFunction | Kind::FunctionExpression));
+    if first_function != Some(generator) {
+        return None;
+    }
+
+    let callee = call.expression()?;
+    let (callee, apis): (_, &[&[u8]]) = if callee.kind() == Kind::CallExpression {
+        let apis: &[&[u8]] = if call_syntax(callee)?.args().is_empty() {
+            &[b"fn", b"fnUntraced", b"fnUntracedEager"]
+        } else {
+            &[b"fn"]
+        };
+        (callee.expression()?, apis)
+    } else {
+        (callee, &[b"gen", b"fn", b"fnUntraced", b"fnUntracedEager"])
+    };
+    is_node_reference_to_effect_module_api(callee, apis, modules).then_some(generator)
+}
+
+fn call_syntax(node: TsNode<'_>) -> Option<Call<'_>> {
+    if node.kind() != Kind::CallExpression {
+        return None;
+    }
+    let Node::Expr(expr) = node.to_ast()? else {
+        return None;
+    };
+    expr.as_call()
+}
+
+/// Effect v4 also accepts wrappers exposing an `asEffect()` method.
+pub(super) fn yieldable_effect_at(node: TsNode<'_>) -> Option<Channels<'_>> {
+    let ty = type_at(node)?;
+    effect(ty).or_else(|| {
+        ty.get_type_of_property(b"asEffect")?
+            .get_call_signatures()
+            .into_iter()
+            .find_map(|signature| effect(signature.get_return_type()))
+    })
+}
