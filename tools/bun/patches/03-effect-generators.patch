+use crate::effect::{generator_context, report, type_parser};
+use bun_lint::prelude::*;
+use bun_lint::types::SyntaxKind;
+
+const MESSAGE: &Message = &Message::new(
+    "returnEffectInGen",
+    "This generator returns an Effect-able value directly, which produces a nested `Effect<Effect<...>>`. If the intended result is the inner Effect value, `return yield*` represents that form.",
+);
+
+effect_rule!(
+    ReturnEffectInGen,
+    b"returnEffectInGen",
+    "return-effect-in-gen",
+    // ets_rules/src/return_effect_in_gen.rs:59–73,86–102.
+    On::new().stmts(&[StmtTag::Return]),
+    fn stmt<'a>(&self, stmt: Stmt<'a>, cx: &mut Cx<'a, Self>) {
+        let node = stmt.ts_node();
+        let Some(value) = node.expression() else {
+            return;
+        };
+        if value.kind() != SyntaxKind::YieldExpression
+            && generator_context::enclosing_generator(node, cx.file().modules()).is_some()
+            && type_parser::type_at(value)
+                .and_then(type_parser::strict_effect)
+                .is_some()
+        {
+            let _ = report(
+                cx,
+                self.hidden_by_default,
+                type_parser::diagnostic_span(cx.file(), node),
+                MESSAGE,
+            );
+        }
+    }
+);
