diff --git a/src/lint/plugins/effect/rules/bun_missing_return_yield_star.rs b/src/lint/plugins/effect/rules/bun_missing_return_yield_star.rs
new file mode 100644
index 0000000..100ddf1
--- /dev/null
+++ b/src/lint/plugins/effect/rules/bun_missing_return_yield_star.rs
@@ -0,0 +1,63 @@
+use crate::effect::{generator_context, report, type_parser};
+use bun_lint::ast::Node;
+use bun_lint::prelude::*;
+use bun_lint::types::{SyntaxKind, TsNode, TypeFlags};
+
+const MESSAGE: &Message = &Message::new(
+    "missingReturnYieldStar",
+    "This Effect never succeeds; using `return yield*` preserves a definitive generator exit point for type narrowing and tooling support.",
+);
+
+// tsrs_ast/src/utilities_1.rs:1002–1049 (OuterExpressionKinds::All).
+fn skip_outer_expressions(mut node: TsNode<'_>) -> Option<TsNode<'_>> {
+    while matches!(
+        node.kind(),
+        SyntaxKind::ParenthesizedExpression
+            | SyntaxKind::TypeAssertionExpression
+            | SyntaxKind::AsExpression
+            | SyntaxKind::SatisfiesExpression
+            | SyntaxKind::NonNullExpression
+            | SyntaxKind::ExpressionWithTypeArguments
+            | SyntaxKind::PartiallyEmittedExpression
+    ) {
+        node = node.expression()?;
+    }
+    Some(node)
+}
+
+effect_rule!(
+    MissingReturnYieldStar,
+    b"missingReturnYieldStar",
+    "missing-return-yield-star",
+    // ets_rules/src/missing_return_yield_star.rs:59–89,101–118.
+    On::new().stmts(&[StmtTag::Expr]),
+    fn stmt<'a>(&self, stmt: Stmt<'a>, cx: &mut Cx<'a, Self>) {
+        let node = stmt.ts_node();
+        if stmt.is_wrapper() || node.kind() != SyntaxKind::ExpressionStatement {
+            return;
+        }
+        let Some(yield_node) = node.expression().and_then(skip_outer_expressions) else {
+            return;
+        };
+        let Some(Node::Expr(expr)) = yield_node.to_ast() else {
+            return;
+        };
+        let Some((Some(_), true)) = expr.as_yield() else {
+            return;
+        };
+        let Some(value) = yield_node.expression() else {
+            return;
+        };
+        if generator_context::enclosing_generator(node, cx.file().modules()).is_some()
+            && generator_context::yieldable_effect_at(value)
+                .is_some_and(|effect| effect.output.has_flags(TypeFlags::NEVER))
+        {
+            let _ = report(
+                cx,
+                self.hidden_by_default,
+                type_parser::diagnostic_span(cx.file(), yield_node),
+                MESSAGE,
+            );
+        }
+    }
+);
