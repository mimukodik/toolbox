+            ),
+            (
+                &ws,
+                &[basedir(&ws), basedir(&ws.join("target"))],
+                vec![
+                    remap(&ws, here),
+                    remap(&ws.join("target"), Path::new("target")),
+                ],
+            ),
+            (&registry, &[basedir(&registry.join("x"))], vec![]),
+            (&ws.join("..").join("ws"), &nested, vec![]),
+        ];
+        let arguments = |cwd: &Path, out: &Path, basedirs: &[Vec<u8>]| -> Vec<_> {
+            basedirs_remap_arguments(cwd, out, basedirs)
+                .iter()
+                .flat_map(|arg| arg.iter_os_strings())
+                .collect()
+        };
+        for (cwd, basedirs, expected) in cases {
+            assert_eq!(arguments(cwd, &out, basedirs), expected.concat(), "{cwd:?}");
+        }
+        // A `..` in the output directory leaves only the basedirs of the cwd mapped.
+        let dotdot_out = ws.join("target").join("..").join("target");
